---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions'; // Pastikan ClientRouter di-import resmi
import BottomNav from '../components/BottomNav.astro';

interface Props {
  pageTitle?: string;
}

const { pageTitle = 'Dashboard' } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth" transition:animate="slide">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <title>{pageTitle} | Qolbu by PakLubis</title>
    <meta
      name="description"
      content="Aplikasi Ibadah Harian Terlengkap: Jadwal Sholat, Al-Qur'an, Doa Harian, Panduan Sholat, Dzikir, Asmaul Husna & Tasbih Digital."
    />
    <meta name="theme-color" content="#10b981" />
    <link rel="manifest" href="/manifest.json" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PlusJakartaSans-Variable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/AmiriArabic-Regular.woff2"
      crossorigin
    />

    <ClientRouter />

    <script is:inline>
      // Fungsi penentu tema dasar (dijalankan secepat mungkin untuk menghindari flashing)
      (() => {
        const applyTheme = () => {
          const theme =
            localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }
        };
        applyTheme();
        // Pastikan tema diaplikasikan ulang setiap kali terjadi transisi halaman Astro
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>

  <body
    class="flex min-h-screen flex-col overflow-x-hidden bg-slate-50 font-sans text-slate-800 transition-colors duration-300 selection:bg-emerald-500 selection:text-white dark:bg-slate-950 dark:text-slate-100"
  >
    <header
      class="sticky top-0 z-50 border-b border-slate-200/60 bg-white transition-colors duration-300 md:bg-white/80 md:backdrop-blur-xl dark:border-slate-800/60 dark:bg-slate-900 md:dark:bg-slate-900/80"
      transition:name="site-header"
    >
      <div class="mx-auto flex h-16 max-w-md items-center justify-between px-4">
        <a href="/" class="group flex items-center gap-2.5">
          <div
            class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-xl border border-slate-100 bg-white p-0.5 shadow-lg shadow-emerald-500/20 transition-transform duration-300 group-hover:scale-105 dark:border-slate-700 dark:bg-slate-800"
          >
            <img src="/logo.png" alt="Logo Qolbu" class="h-full w-full object-contain" />
          </div>
          <span class="text-xl font-extrabold tracking-tight text-slate-800 dark:text-white"
            >Qolbu</span
          >
        </a>

        <button
          id="theme-toggle"
          class="flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 active:scale-95 dark:text-slate-400 dark:hover:bg-slate-800"
          aria-label="Ganti Tema"
          transition:persist
        >
          <svg
            class="h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"
            ></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"
            ></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path
              d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg
          >
          <svg
            class="hidden h-5 w-5 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
          >
        </button>
      </div>
    </header>

    <a
      href="#main-content"
      class="sr-only z-[100] rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
      >Lompat ke konten</a
    >
    <main
      id="main-content"
      class="relative mx-auto flex min-h-[50vh] w-full max-w-md flex-1 flex-col"
    >
      <slot />
    </main>
    <BottomNav />

    <footer
      class="mt-auto border-t border-slate-200 bg-slate-50 py-8 text-center transition-colors duration-300 dark:border-slate-800 dark:bg-slate-950"
    >
      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
        Dibuat oleh <a
          href="https://paklubis.my.id"
          target="_blank"
          class="font-bold text-emerald-600 hover:text-emerald-700 hover:underline dark:text-emerald-400 dark:hover:text-emerald-300"
          >PakLubis</a
        >
        <br />
        <span class="font-normal opacity-60">&copy; {new Date().getFullYear()} Qolbu App</span>
      </p>
    </footer>

    <script is:inline>
      // Registrasi Service Worker PWA standar
      (() => {
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      })();
    </script>

    <script is:inline>
      // Handler Interaksi klik Theme Toggle
      (() => {
        const bindThemeClick = () => {
          const toggleBtn = document.getElementById('theme-toggle');
          if (!toggleBtn) return;

          toggleBtn.onclick = () => {
            const doc = document.documentElement;
            doc.classList.toggle('dark');
            const isDark = doc.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            doc.style.colorScheme = isDark ? 'dark' : 'light';
          };
        };

        // Inisialisasi awal & re-bind setiap kali navigasi SPA Astro selesai
        bindThemeClick();
        document.addEventListener('astro:page-load', bindThemeClick);
      })();
    </script>
  </body>
</html>
