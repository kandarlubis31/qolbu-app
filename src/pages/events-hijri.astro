---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderSticky from '../components/HeaderSticky.astro';
import eventsHijri from '../data/events-hijri.json';
---

<BaseLayout pageTitle="Kalender Hijri">
  <HeaderSticky title="Kalender Hijri" href="/" backLabel="Kembali" />

  <div class="mx-auto w-full max-w-md px-4 pb-24">
    <div
      class="relative mb-6 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-5 text-white shadow-lg shadow-emerald-500/20"
    >
      <div class="absolute top-0 right-0 translate-x-4 -translate-y-4 transform opacity-10">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="currentColor"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
      </div>
      <div class="relative z-10">
        <p class="mb-1 text-xs font-medium tracking-widest text-emerald-100 uppercase">
          Islamic Calendar
        </p>
        <h2 class="text-xl font-bold">Events Islami Tahunan</h2>
        <p class="mt-1 text-xs text-emerald-200">Tanggal penting dalam kalender Hijriyah</p>
      </div>
    </div>

    <div class="space-y-4">
      {
        eventsHijri.map((bulan) => (
          <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/50">
              <h3 class="text-sm font-bold text-slate-800 dark:text-white">{bulan.bulan}</h3>
              {bulan.events.length > 0 ? (
                <span class="rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                  {bulan.events.length} Event
                </span>
              ) : (
                <span class="rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold text-slate-400 dark:bg-slate-700">
                  -
                </span>
              )}
            </div>

            <div class="divide-y divide-slate-50 dark:divide-slate-800/50">
              {bulan.events.length > 0 ? (
                bulan.events.map((event) => (
                  <div class="flex gap-3 p-4 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/30">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl border border-amber-100 bg-amber-50 text-sm font-bold text-amber-600 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-400">
                      {event.tanggal}
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="mb-0.5 text-sm font-bold text-slate-800 dark:text-white">
                        {event.judul}
                      </h4>
                      <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                        {event.desc}
                      </p>
                    </div>
                  </div>
                ))
              ) : (
                <div class="p-4 text-center text-xs text-slate-400 italic dark:text-slate-500">
                  Tidak ada event besar di bulan ini
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="mt-8 rounded-xl border border-amber-100 bg-amber-50 p-4 text-center dark:border-amber-800 dark:bg-amber-900/20"
    >
      <p class="text-xs text-amber-800 dark:text-amber-200">
        💡 <strong>Catatan:</strong> Tanggal di atas berdasarkan kalender Hijriyah. Tanggal Masehi dapat
        berubah sesuai hisab dan rukyat masing-masing.
      </p>
    </div>
  </div>
</BaseLayout>
