---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderSticky from '../components/HeaderSticky.astro';
import eventsHijri from '../data/events-hijri.json';
import eventsMasehi from '../data/events-masehi.json';
---

<BaseLayout pageTitle="Events Kalender">
  <HeaderSticky title="Events Kalender" href="/" backLabel="Kembali" />

  <div class="mx-auto w-full max-w-md px-4 pb-24">
    <div
      class="relative mb-4 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-5 text-white shadow-lg shadow-emerald-500/20"
    >
      <div class="absolute top-0 right-0 translate-x-4 -translate-y-4 transform opacity-10">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="currentColor"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
      </div>
      <div class="relative z-10">
        <p class="mb-1 text-xs font-medium tracking-widest text-emerald-100 uppercase">
          Kalender Indonesia
        </p>
        <h2 class="text-xl font-bold">Events Hijriah & Masehi</h2>
        <p class="mt-1 text-xs text-emerald-200">Tanggal penting keagamaan & hari besar nasional</p>
      </div>
    </div>

    <!-- Tabs: Hijriah | Masehi -->
    <div
      class="mb-4 flex gap-1 rounded-xl bg-slate-100 p-1 dark:bg-slate-800"
      role="tablist"
      aria-label="Pilih kalender"
    >
      <button
        id="tab-hijri"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="panel-hijri"
        class="flex-1 rounded-lg py-2 text-sm font-bold text-slate-500 transition-colors aria-selected:bg-white aria-selected:text-emerald-600 aria-selected:shadow-sm dark:text-slate-400 dark:aria-selected:bg-slate-900 dark:aria-selected:text-emerald-400"
      >
        🌙 Hijriah
      </button>
      <button
        id="tab-masehi"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="panel-masehi"
        class="flex-1 rounded-lg py-2 text-sm font-bold text-slate-500 transition-colors aria-selected:bg-white aria-selected:text-emerald-600 aria-selected:shadow-sm dark:text-slate-400 dark:aria-selected:bg-slate-900 dark:aria-selected:text-emerald-400"
      >
        🇮🇩 Masehi
      </button>
    </div>

    <!-- Panel Hijriah -->
    <div id="panel-hijri" role="tabpanel" aria-labelledby="tab-hijri" class="space-y-4">
      {
        eventsHijri.map((bulan) => (
          <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/50">
              <h3 class="text-sm font-bold text-slate-800 dark:text-white">{bulan.bulan}</h3>
              {bulan.events.length > 0 ? (
                <span class="rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                  {bulan.events.length} Event
                </span>
              ) : (
                <span class="rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold text-slate-400 dark:bg-slate-700">
                  -
                </span>
              )}
            </div>

            <div class="divide-y divide-slate-50 dark:divide-slate-800/50">
              {bulan.events.length > 0 ? (
                bulan.events.map((event) => (
                  <div class="flex gap-3 p-4">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl border border-amber-100 bg-amber-50 text-sm font-bold text-amber-600 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-400">
                      {event.tanggal}
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="mb-0.5 text-sm font-bold text-slate-800 dark:text-white">
                        {event.judul}
                      </h4>
                      <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                        {event.desc}
                      </p>
                    </div>
                  </div>
                ))
              ) : (
                <div class="p-4 text-center text-xs text-slate-400 italic dark:text-slate-500">
                  Tidak ada event besar di bulan ini
                </div>
              )}
            </div>
          </div>
        ))
      }

      <div
        class="rounded-xl border border-amber-100 bg-amber-50 p-4 text-center dark:border-amber-800 dark:bg-amber-900/20"
      >
        <p class="text-xs text-amber-800 dark:text-amber-200">
          💡 <strong>Catatan:</strong> Tanggal di atas berdasarkan kalender Hijriyah. Tanggal Masehi dapat
          berubah sesuai hisab dan rukyat masing-masing.
        </p>
      </div>
    </div>

    <!-- Panel Masehi -->
    <div id="panel-masehi" role="tabpanel" aria-labelledby="tab-masehi" class="hidden space-y-4">
      {
        eventsMasehi.map((bulan) => (
          <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/50">
              <h3 class="text-sm font-bold text-slate-800 dark:text-white">{bulan.bulan}</h3>
              {bulan.events.length > 0 ? (
                <span class="rounded-full bg-sky-100 px-2 py-1 text-[10px] font-bold text-sky-600 dark:bg-sky-900/30 dark:text-sky-400">
                  {bulan.events.length} Event
                </span>
              ) : (
                <span class="rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold text-slate-400 dark:bg-slate-700">
                  -
                </span>
              )}
            </div>

            <div class="divide-y divide-slate-50 dark:divide-slate-800/50">
              {bulan.events.length > 0 ? (
                bulan.events.map((event) => (
                  <div class="flex gap-3 p-4">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl border border-sky-100 bg-sky-50 text-sm font-bold text-sky-600 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-400">
                      {event.tanggal}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-1.5">
                        <h4 class="text-sm font-bold text-slate-800 dark:text-white">
                          {event.judul}
                        </h4>
                        {event.libur ? (
                          <span class="rounded-full bg-emerald-100 px-1.5 py-0.5 text-[9px] font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                            Libur Nasional
                          </span>
                        ) : (
                          <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[9px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                            Peringatan
                          </span>
                        )}
                      </div>
                      <p class="mt-0.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                        {event.desc}
                      </p>
                    </div>
                  </div>
                ))
              ) : (
                <div class="p-4 text-center text-xs text-slate-400 italic dark:text-slate-500">
                  Tidak ada event besar di bulan ini
                </div>
              )}
            </div>
          </div>
        ))
      }

      <div
        class="rounded-xl border border-sky-100 bg-sky-50 p-4 text-center dark:border-sky-800 dark:bg-sky-900/20"
      >
        <p class="text-xs text-sky-800 dark:text-sky-200">
          💡 <strong>Catatan:</strong> Hanya tanggal tetap yang dicantumkan. Hari besar berdasarkan peredaran
          masehi (Imlek, Nyepi, Wafat & Kenaikan Isa Almasih, Waisak) mengikuti Surat Keputusan Bersama
          Menteri tiap tahun.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const initTabs = () => {
      if (window._eventsTabsInit) return;
      const tabs = [document.getElementById('tab-hijri'), document.getElementById('tab-masehi')];
      const panels = [
        document.getElementById('panel-hijri'),
        document.getElementById('panel-masehi'),
      ];
      if (tabs.some((t) => !t) || panels.some((p) => !p)) return;
      window._eventsTabsInit = true;

      const select = (idx) => {
        tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
        panels.forEach((p, i) => p.classList.toggle('hidden', i !== idx));
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
      });
    };

    document.addEventListener('astro:page-load', initTabs);
    document.addEventListener('astro:before-swap', () => {
      window._eventsTabsInit = false;
    });
  })();
</script>
