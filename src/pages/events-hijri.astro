---
// src/pages/events-hijri.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const eventsHijri = [
  {"bulan":"Muharram","events":[
    {"tanggal":1,"judul":"Tahun Baru Islam","desc":"Awal tahun Hijriyah. Disunnahkan berpuasa."},
    {"tanggal":10,"judul":"Hari Asyura","desc":"Disunnahkan puasa Asyura. Hari diselamatkannya Nabi Musa AS dan kaumnya dari Fir'aun."}
  ]},
  {"bulan":"Shafar","events":[]},
  {"bulan":"Rabi'ul Awal","events":[
    {"tanggal":12,"judul":"Maulid Nabi Muhammad SAW","desc":"Peringatan kelahiran Nabi Muhammad SAW, rahmat bagi seluruh alam."}
  ]},
  {"bulan":"Rabi'ul Akhir","events":[]},
  {"bulan":"Jumadil Awal","events":[]},
  {"bulan":"Jumadil Akhir","events":[]},
  {"bulan":"Rajab","events":[
    {"tanggal":1,"judul":"Awal Bulan Rajab","desc":"Salah satu dari empat bulan haram (suci). Saatnya memperbanyak ibadah."},
    {"tanggal":27,"judul":"Isra Mi'raj Nabi Muhammad SAW","desc":"Peringatan perjalanan agung Nabi SAW dari Masjidil Haram ke Masjidil Aqsha lalu Sidratul Muntaha."}
  ]},
  {"bulan":"Sya'ban","events":[
    {"tanggal":15,"judul":"Nisfu Sya'ban","desc":"Malam pengampunan dosa. Disunnahkan memperbanyak ibadah dan doa."}
  ]},
  {"bulan":"Ramadhan","events":[
    {"tanggal":1,"judul":"Awal Ramadhan","desc":"Bulan suci penuh berkah, ampunan, dan pembebasan dari api neraka. Wajib berpuasa sebulan penuh."},
    {"tanggal":17,"judul":"Nuzulul Qur'an","desc":"Peringatan turunnya Al-Qur'an pertama kali kepada Nabi Muhammad SAW."},
    {"tanggal":21,"judul":"Lailatul Qadar (Malam Ganjil)","desc":"Cari malam Lailatul Qadar di 10 malam terakhir Ramadhan, lebih baik dari 1000 bulan."}
  ]},
  {"bulan":"Syawwal","events":[
    {"tanggal":1,"judul":"Idul Fitri 1 Syawwal","desc":"Hari Raya setelah sebulan berpuasa. Disunnahkan puasa 6 hari di bulan Syawwal."}
  ]},
  {"bulan":"Dzulqa'dah","events":[
    {"tanggal":1,"judul":"Awal Dzulqa'dah","desc":"Salah satu bulan haram (suci). Bulan istirahat setelah Ramadhan."}
  ]},
  {"bulan":"Dzulhijjah","events":[
    {"tanggal":1,"judul":"Awal Dzulhijjah","desc":"10 hari pertama Dzulhijjah sangat utama untuk beramal shalih."},
    {"tanggal":9,"judul":"Hari Arafah","desc":"Disunnahkan puasa Arafah bagi yang tidak berhaji — menghapus dosa setahun lalu dan setahun depan."},
    {"tanggal":10,"judul":"Idul Adha","desc":"Hari Raya Qurban. Sholat Idul Adha dan penyembelihan hewan qurban."},
    {"tanggal":11,"judul":"Hari Tasyriq ke-1","desc":"Hari pertama tasyriq, dilarang berpuasa."},
    {"tanggal":12,"judul":"Hari Tasyriq ke-2","desc":"Hari kedua tasyriq, dilarang berpuasa."},
    {"tanggal":13,"judul":"Hari Tasyriq ke-3","desc":"Hari ketiga tasyriq, dilarang berpuasa."}
  ]}
];
---

<BaseLayout pageTitle="Kalender Hijri">
  
  <div class="sticky top-16 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 -mx-4 px-4 py-3 mb-4 flex items-center justify-between shadow-sm">
    <a href="/" class="flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 transition-colors p-2 -ml-2 rounded-lg active:bg-slate-100 dark:active:bg-slate-800">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span class="font-medium text-sm">Kembali</span>
    </a>
    <h1 class="font-bold text-slate-800 dark:text-white text-sm">Kalender Hijri</h1>
    <div class="w-8"></div>
  </div>

  <div class="pb-24 px-4 w-full max-w-md mx-auto">
    
    <div class="bg-gradient-to-br from-emerald-500 to-teal-700 rounded-3xl p-5 text-white shadow-lg shadow-emerald-500/20 mb-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 opacity-10 transform translate-x-4 -translate-y-4">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="relative z-10">
        <p class="text-emerald-100 text-xs font-medium uppercase tracking-widest mb-1">Islamic Calendar</p>
        <h2 class="text-xl font-bold">Events Islami Tahunan</h2>
        <p class="text-xs text-emerald-200 mt-1">Tanggal penting dalam kalender Hijriyah</p>
      </div>
    </div>

    <div class="space-y-4">
      {eventsHijri.map((bulan) => (
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
          <div class="p-4 bg-slate-50 dark:bg-slate-800/50 flex items-center justify-between border-b border-slate-100 dark:border-slate-700">
            <h3 class="font-bold text-slate-800 dark:text-white text-sm">{bulan.bulan}</h3>
            {bulan.events.length > 0 ? (
              <span class="text-[10px] px-2 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 font-bold">{bulan.events.length} Event</span>
            ) : (
              <span class="text-[10px] px-2 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-400 font-bold">-</span>
            )}
          </div>
          
          <div class="divide-y divide-slate-50 dark:divide-slate-800/50">
            {bulan.events.length > 0 ? (
              bulan.events.map((event) => (
                <div class="p-4 flex gap-3 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                  <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center text-sm font-bold text-amber-600 dark:text-amber-400 border border-amber-100 dark:border-amber-800 flex-shrink-0">
                    {event.tanggal}
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-bold text-slate-800 dark:text-white text-sm mb-0.5">{event.judul}</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{event.desc}</p>
                  </div>
                </div>
              ))
            ) : (
              <div class="p-4 text-center text-xs text-slate-400 dark:text-slate-500 italic">
                Tidak ada event besar di bulan ini
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 p-4 bg-amber-50 dark:bg-amber-900/20 rounded-xl border border-amber-100 dark:border-amber-800 text-center">
      <p class="text-xs text-amber-800 dark:text-amber-200">
        💡 <strong>Catatan:</strong> Tanggal di atas berdasarkan kalender Hijriyah. Tanggal Masehi dapat berubah sesuai hisab dan rukyat masing-masing.
      </p>
    </div>

  </div>

</BaseLayout>
