---

<BaseLayout pageTitle="Panduan Sholat Lengkap">
  <HeaderSticky title="Panduan Sholat" rightSlot>
    <button
      id="view-bookmarks"
      slot="right"
      class="relative -mr-2 flex items-center gap-1 rounded-lg p-2 text-slate-600 transition-colors hover:text-emerald-600 active:bg-slate-100 dark:text-slate-400 dark:active:bg-slate-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
      >
      <span
        id="bookmark-badge"
        class="absolute top-1 right-1 hidden h-2 w-2 rounded-full bg-rose-500"></span>
    </button>
  </HeaderSticky>

  <div class="mx-auto w-full max-w-md px-4 pb-24">
    <SearchBar id="search-input" placeholder="Cari bacaan (misal: Qunut, Tasyahud)..." />

    <div
      class="sticky top-32 z-30 mb-6 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm transition-all dark:border-slate-700 dark:bg-slate-800"
    >
      <div
        class="mb-2 flex justify-between text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400"
      >
        <span>Progress Belajar</span>
        <span
          ><span id="current-step-text" class="text-emerald-600 dark:text-emerald-400">0</span> / {
            enrichedGuides.length
          }</span
        >
      </div>
      <div class="mb-4 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
        <div
          id="progress-bar"
          class="h-full bg-emerald-500 transition-all duration-500 ease-out"
          style="width: 0%"
        >
        </div>
      </div>
      <div class="flex gap-2">
        <button
          id="practice-btn"
          class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-600 py-2.5 text-sm font-bold text-white shadow-md shadow-emerald-500/20 transition-all hover:bg-emerald-700 active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="play-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
          >
          <span class="btn-text">Mulai Praktik</span>
        </button>
        <button
          id="reset-progress"
          class="rounded-xl bg-slate-100 px-3.5 py-2.5 text-sm font-bold text-slate-500 transition-all hover:bg-slate-200 active:scale-95 dark:bg-slate-700 dark:text-slate-400 dark:hover:bg-slate-600"
          title="Reset Progress"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"
            ></path></svg
          >
        </button>
      </div>
      <p id="practice-hint" class="mt-2 text-center text-[10px] text-slate-400 italic">
        Mode Praktik memutar bacaan berurutan tiap 15 detik.
      </p>
    </div>

    <div class="space-y-4" id="guide-container">
      {
        enrichedGuides.map((item, index) => (
          <details
            class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all duration-300 open:border-emerald-500/50 open:shadow-lg dark:border-slate-800 dark:bg-slate-900"
            data-index={index}
            data-id={item.id}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between bg-slate-50/50 p-4 transition-colors select-none group-open:bg-emerald-50 dark:bg-slate-800/50 dark:group-open:bg-emerald-900/10">
              <div class="flex items-center gap-3">
                <span class="step-badge flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-bold text-slate-600 transition-colors group-open:bg-emerald-500 group-open:text-white dark:bg-slate-700 dark:text-slate-300">
                  {index + 1}
                </span>
                <div>
                  <span class="mb-0.5 block text-[10px] font-bold tracking-widest text-slate-400 uppercase">
                    {item.category}
                  </span>
                  <h3 class="line-clamp-1 text-sm font-bold text-slate-700 transition-colors group-open:text-emerald-700 dark:text-slate-200 dark:group-open:text-emerald-400">
                    {item.displayTitle}
                  </h3>
                </div>
              </div>
              <div class="flex items-center gap-1">
                <button
                  class="bookmark-btn z-20 rounded-full p-2 text-slate-300 transition-colors hover:bg-slate-100 hover:text-rose-500 dark:hover:bg-slate-800"
                  data-id={item.id}
                  title="Simpan Bookmark"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                </button>
                <span class="transform p-1 text-slate-400 transition-transform group-open:rotate-180">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </div>
            </summary>

            <div class="animate-fade-in border-t border-slate-100 px-5 pt-3 pb-6 dark:border-slate-800">
              <div class="mb-5 flex items-start gap-4">
                <div
                  class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-slate-100 text-slate-400 dark:border-slate-700 dark:bg-slate-800"
                  set:html={item.icon}
                />
                <p class="flex-1 pt-1 text-xs leading-relaxed text-slate-600 italic dark:text-slate-300">
                  {item.desc}
                </p>
              </div>

              {item.arab && (
                <div class="relative mb-4 rounded-xl border border-slate-100 bg-slate-50 p-4 text-right dark:border-slate-700/50 dark:bg-slate-800/50">
                  <p
                    class="font-amiri text-3xl leading-[2.2] text-slate-800 dark:text-slate-100"
                    dir="rtl"
                  >
                    {item.arab}
                  </p>
                </div>
              )}

              {item.latin && (
                <div class="mb-5 space-y-1.5 px-1">
                  <p class="text-sm leading-relaxed font-bold text-emerald-600 dark:text-emerald-400">
                    {item.latin}
                  </p>
                  <p class="text-xs text-slate-500 dark:text-slate-400">"{item.arti}"</p>
                </div>
              )}

              <div class="flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
                <button
                  class="audio-btn flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-xs font-bold text-emerald-600 transition-colors hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-emerald-900/20 dark:text-emerald-400"
                  data-audio={item.audio}
                  disabled={!item.audio}
                >
                  {item.audio ? (
                    <>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        stroke="none"
                        class="ic-play"
                      >
                        <polygon points="5 3 19 12 5 21 5 3" />
                      </svg>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        stroke="none"
                        class="ic-pause hidden"
                      >
                        <rect x="6" y="4" width="4" height="16" />
                        <rect x="14" y="4" width="4" height="16" />
                      </svg>
                      <span class="btn-text">Dengarkan</span>
                    </>
                  ) : (
                    <>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="1" y1="1" x2="23" y2="23" />
                        <path d="M9 9v6a3 3 0 0 0 5.12 2.12M15 9.34V4h3m-6 9.77a3 3 0 0 1-3-2.12" />
                      </svg>
                      <span>Audio N/A</span>
                    </>
                  )}
                </button>

                <button
                  class="mark-complete-btn flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-bold text-slate-500 transition-colors hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700"
                  data-id={item.id}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="ic-check hidden"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="btn-text">Tandai Selesai</span>
                </button>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <div id="empty-state" class="hidden py-12 text-center">
      <div class="mb-3 inline-block rounded-full bg-slate-100 p-4 text-slate-400 dark:bg-slate-800">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="m9 9 4 4"
          ></path><path d="m9 13 4-4"></path></svg
        >
      </div>
      <p class="text-sm text-slate-500 dark:text-slate-400">Langkah tidak ditemukan.</p>
    </div>

    <div
      id="bookmarks-modal"
      class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
    >
      <div
        class="animate-slide-up relative w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900"
      >
        <button
          id="close-bookmarks"
          class="absolute top-5 right-5 rounded-full bg-slate-100 p-1.5 text-slate-400 transition-colors hover:text-slate-600 dark:bg-slate-800 dark:hover:text-slate-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
            ></line></svg
          >
        </button>
        <h2 class="mb-5 flex items-center gap-2 text-lg font-bold text-slate-800 dark:text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-rose-500"
            ><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
          >
          Langkah Disimpan
        </h2>
        <div id="bookmarks-list" class="max-h-[60vh] space-y-2 overflow-y-auto pr-1"></div>
      </div>
    </div>

    <Toast />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const initGuide = () => {
      if (window._guideInitialized) return;
      const allDetails = document.querySelectorAll('details');
      const progressBar = document.getElementById('progress-bar');
      const stepText = document.getElementById('current-step-text');
      const practiceBtn = document.getElementById('practice-btn');
      const resetBtn = document.getElementById('reset-progress');
      if (!allDetails.length || !stepText) return;
      window._guideInitialized = true;
      const practiceHint = document.getElementById('practice-hint');
      const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
      const audioBtns = document.querySelectorAll('.audio-btn');
      const markCompleteBtns = document.querySelectorAll('.mark-complete-btn');
      const searchInput = document.getElementById('search-input');
      const bookmarksModal = document.getElementById('bookmarks-modal');
      const viewBookmarksBtn = document.getElementById('view-bookmarks');
      const closeBookmarksBtn = document.getElementById('close-bookmarks');
      const bookmarksList = document.getElementById('bookmarks-list');
      const bookmarkBadge = document.getElementById('bookmark-badge');
      const emptyState = document.getElementById('empty-state');

      let practiceMode = false;
      let practiceTimer = null;
      let currentStep = 0;
      let currentAudio = null;
      window._guideAudio = null;
      let currentAudioBtn = null;
      window._guideTimer = null;
      window._guideAudio = null;
      let completedSteps = JSON.parse(localStorage.getItem('sholat-completed') || '[]');

      const updateProgress = () => {
        const val = completedSteps.length;
        const pct = (val / allDetails.length) * 100;
        progressBar.style.width = `${pct}%`;
        stepText.innerText = val;

        allDetails.forEach((el) => {
          const id = el.getAttribute('data-id');
          const badge = el.querySelector('.step-badge');
          const markBtn = el.querySelector('.mark-complete-btn');

          if (completedSteps.includes(id)) {
            badge.innerHTML =
              '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
            badge.classList.add('bg-emerald-500', 'text-white');
            badge.classList.remove(
              'bg-slate-200',
              'dark:bg-slate-700',
              'text-slate-600',
              'dark:text-slate-300'
            );
            if (markBtn) {
              markBtn.querySelector('.btn-text').textContent = 'Selesai';
              markBtn.querySelector('.ic-check').classList.remove('hidden');
              markBtn.classList.add(
                'bg-emerald-100',
                'dark:bg-emerald-900/30',
                'text-emerald-600',
                'dark:text-emerald-400',
                'border-emerald-200',
                'dark:border-emerald-800'
              );
              markBtn.classList.remove(
                'bg-slate-100',
                'dark:bg-slate-800',
                'text-slate-500',
                'dark:text-slate-400',
                'border-slate-200',
                'dark:border-slate-700'
              );
            }
          } else {
            const idx = parseInt(el.getAttribute('data-index')) + 1;
            badge.innerHTML = idx;
            badge.classList.remove('bg-emerald-500', 'text-white');
            badge.classList.add(
              'bg-slate-200',
              'dark:bg-slate-700',
              'text-slate-600',
              'dark:text-slate-300'
            );
            if (markBtn) {
              markBtn.querySelector('.btn-text').textContent = 'Tandai Selesai';
              markBtn.querySelector('.ic-check').classList.add('hidden');
              markBtn.classList.remove(
                'bg-emerald-100',
                'dark:bg-emerald-900/30',
                'text-emerald-600',
                'dark:text-emerald-400',
                'border-emerald-200',
                'dark:border-emerald-800'
              );
              markBtn.classList.add(
                'bg-slate-100',
                'dark:bg-slate-800',
                'text-slate-500',
                'dark:text-slate-400',
                'border-slate-200',
                'dark:border-slate-700'
              );
            }
          }
        });
      };

      allDetails.forEach((el) => {
        el.addEventListener('toggle', () => {
          if (el.open && !practiceMode) {
            allDetails.forEach((other) => {
              if (other !== el && other.open) other.open = false;
            });
          }
        });
      });

      const stopPractice = () => {
        practiceMode = false;
        clearInterval(practiceTimer);
        practiceTimer = null;
        window._guideTimer = null;
        if (currentAudio) currentAudio.pause();
        practiceBtn.querySelector('.play-icon').innerHTML =
          '<polygon points="5 3 19 12 5 21 5 3"/>';
        practiceBtn.querySelector('.btn-text').textContent = 'Mulai Praktik';
        practiceBtn.classList.remove('bg-rose-600', 'hover:bg-rose-700', 'shadow-rose-500/20');
        practiceBtn.classList.add(
          'bg-emerald-600',
          'hover:bg-emerald-700',
          'shadow-emerald-500/20'
        );
        practiceHint.textContent = 'Mode Praktik memutar bacaan berurutan tiap 15 detik.';
      };

      const startPractice = () => {
        practiceMode = true;
        currentStep = 0;
        practiceBtn.querySelector('.play-icon').innerHTML =
          '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        practiceBtn.querySelector('.btn-text').textContent = 'Hentikan Praktik';
        practiceBtn.classList.remove(
          'bg-emerald-600',
          'hover:bg-emerald-700',
          'shadow-emerald-500/20'
        );
        practiceBtn.classList.add('bg-rose-600', 'hover:bg-rose-700', 'shadow-rose-500/20');
        practiceHint.textContent = 'Sedang berjalan... Klik tombol di atas untuk berhenti.';
        allDetails.forEach((el) => (el.open = false));

        const runStep = () => {
          if (currentStep >= allDetails.length) {
            stopPractice();
            window.showToast('Alhamdulillah, praktik selesai!');
            return;
          }
          if (currentStep > 0) allDetails[currentStep - 1].open = false;
          const target = allDetails[currentStep];
          target.open = true;
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const audioBtn = target.querySelector('.audio-btn');
          if (audioBtn && !audioBtn.disabled) audioBtn.click();
          currentStep++;
        };

        runStep();
        practiceTimer = setInterval(runStep, 15000);
        window._guideTimer = practiceTimer;
      };

      practiceBtn.addEventListener('click', () => {
        if (practiceMode) stopPractice();
        else startPractice();
      });

      resetBtn.addEventListener('click', () => {
        if (confirm('Reset semua progress belajar Anda?')) {
          completedSteps = [];
          localStorage.setItem('sholat-completed', '[]');
          updateProgress();
          window.showToast('Progress direset');
        }
      });

      const loadBookmarks = () => {
        const saved = JSON.parse(localStorage.getItem('sholat-bookmarks') || '[]');
        if (saved.length > 0) bookmarkBadge.classList.remove('hidden');
        else bookmarkBadge.classList.add('hidden');
        bookmarkBtns.forEach((btn) => {
          const id = btn.getAttribute('data-id');
          const svg = btn.querySelector('svg');
          if (saved.includes(id)) {
            svg.setAttribute('fill', 'currentColor');
            btn.classList.add('text-rose-500');
            btn.classList.remove('text-slate-300');
          } else {
            svg.setAttribute('fill', 'none');
            btn.classList.remove('text-rose-500');
            btn.classList.add('text-slate-300');
          }
        });
        return saved;
      };

      const renderBookmarksList = () => {
        const saved = loadBookmarks();
        bookmarksList.innerHTML = '';
        if (saved.length === 0) {
          bookmarksList.innerHTML =
            '<p class="text-center text-sm text-slate-400 py-6">Belum ada langkah yang disimpan.</p>';
          return;
        }
        saved.forEach((id) => {
          const el = document.querySelector(`details[data-id="${id}"]`);
          if (el) {
            const title = el.querySelector('h3').innerText;
            const cat = el.querySelector('span.uppercase').innerText;
            const item = document.createElement('div');
            item.className =
              'p-3 bg-slate-50 dark:bg-slate-800 rounded-xl flex justify-between items-center hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer border border-slate-100 dark:border-slate-700';
            item.innerHTML = `<div><p class="text-[10px] text-slate-400 font-bold uppercase mb-0.5">${cat}</p><h4 class="text-sm font-bold text-slate-700 dark:text-slate-200 line-clamp-1">${title}</h4></div><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="text-emerald-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
            item.onclick = () => {
              bookmarksModal.classList.add('hidden');
              el.open = true;
              setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
            };
            bookmarksList.appendChild(item);
          }
        });
      };

      bookmarkBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          let saved = JSON.parse(localStorage.getItem('sholat-bookmarks') || '[]');
          if (saved.includes(id)) {
            saved = saved.filter((s) => s !== id);
            window.showToast('Dihapus dari tersimpan');
          } else {
            saved.push(id);
            window.showToast('Langkah disimpan');
          }
          localStorage.setItem('sholat-bookmarks', JSON.stringify(saved));
          loadBookmarks();
        });
      });

      viewBookmarksBtn.addEventListener('click', () => {
        renderBookmarksList();
        bookmarksModal.classList.remove('hidden');
      });
      closeBookmarksBtn.addEventListener('click', () => bookmarksModal.classList.add('hidden'));
      bookmarksModal.addEventListener('click', (e) => {
        if (e.target === bookmarksModal) bookmarksModal.classList.add('hidden');
      });

      const resetAllAudioBtns = () => {
        document.querySelectorAll('.audio-btn').forEach((b) => {
          b.classList.remove(
            'animate-pulse',
            'bg-rose-100',
            'dark:bg-rose-900/40',
            'text-rose-600',
            'dark:text-rose-400'
          );
          b.classList.add(
            'bg-emerald-50',
            'dark:bg-emerald-900/20',
            'text-emerald-600',
            'dark:text-emerald-400'
          );
          const icPlay = b.querySelector('.ic-play');
          const icPause = b.querySelector('.ic-pause');
          const t = b.querySelector('.btn-text');
          if (icPlay) icPlay.classList.remove('hidden');
          if (icPause) icPause.classList.add('hidden');
          if (t) t.innerText = 'Dengarkan';
        });
      };

      audioBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const src = btn.getAttribute('data-audio');
          if (!src) return;
          const icPlay = btn.querySelector('.ic-play');
          const icPause = btn.querySelector('.ic-pause');
          const txt = btn.querySelector('.btn-text');
          if (currentAudioBtn === btn && currentAudio) {
            if (!currentAudio.paused) {
              currentAudio.pause();
              btn.classList.remove(
                'animate-pulse',
                'bg-rose-100',
                'dark:bg-rose-900/40',
                'text-rose-600',
                'dark:text-rose-400'
              );
              btn.classList.add(
                'bg-emerald-50',
                'dark:bg-emerald-900/20',
                'text-emerald-600',
                'dark:text-emerald-400'
              );
              icPlay.classList.remove('hidden');
              icPause.classList.add('hidden');
              if (txt) txt.innerText = 'Dengarkan';
            } else {
              currentAudio.play();
              btn.classList.add(
                'animate-pulse',
                'bg-rose-100',
                'dark:bg-rose-900/40',
                'text-rose-600',
                'dark:text-rose-400'
              );
              btn.classList.remove(
                'bg-emerald-50',
                'dark:bg-emerald-900/20',
                'text-emerald-600',
                'dark:text-emerald-400'
              );
              icPlay.classList.add('hidden');
              icPause.classList.remove('hidden');
              if (txt) txt.innerText = 'Jeda';
            }
            return;
          }
          if (currentAudio) {
            currentAudio.pause();
            resetAllAudioBtns();
          }
          currentAudio = new Audio(src);
          window._guideAudio = currentAudio;
          currentAudioBtn = btn;
          btn.classList.remove(
            'bg-emerald-50',
            'dark:bg-emerald-900/20',
            'text-emerald-600',
            'dark:text-emerald-400'
          );
          btn.classList.add(
            'animate-pulse',
            'bg-rose-100',
            'dark:bg-rose-900/40',
            'text-rose-600',
            'dark:text-rose-400'
          );
          icPlay.classList.add('hidden');
          icPause.classList.remove('hidden');
          if (txt) txt.innerText = 'Memuat...';
          currentAudio
            .play()
            .then(() => {
              if (txt) txt.innerText = 'Jeda';
            })
            .catch(() => {
              window.showToast('Gagal memutar audio. Cek koneksi.');
              resetAllAudioBtns();
              currentAudio = null;
              window._guideAudio = null;
              currentAudioBtn = null;
            });
          currentAudio.onended = () => {
            resetAllAudioBtns();
            currentAudio = null;
            window._guideAudio = null;
            currentAudioBtn = null;
          };
        });
      });

      markCompleteBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          if (completedSteps.includes(id)) {
            completedSteps = completedSteps.filter((s) => s !== id);
            window.showToast('Dibatalkan');
          } else {
            completedSteps.push(id);
            window.showToast('Ditandai Selesai ✓');
          }
          localStorage.setItem('sholat-completed', JSON.stringify(completedSteps));
          updateProgress();
        });
      });

      searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        let hasVisible = false;
        allDetails.forEach((el) => {
          const text = el.innerText.toLowerCase();
          if (text.includes(term)) {
            el.classList.remove('hidden');
            hasVisible = true;
          } else {
            el.classList.add('hidden');
          }
        });
        if (hasVisible) emptyState.classList.add('hidden');
        else emptyState.classList.remove('hidden');
      });

      updateProgress();
      loadBookmarks();
    };

    document.addEventListener('astro:page-load', initGuide);
    document.addEventListener('astro:before-swap', () => {
      window._guideInitialized = false;
      if (window._guideTimer) {
        clearInterval(window._guideTimer);
        window._guideTimer = null;
      }
      if (window._guideAudio) {
        window._guideAudio.pause();
        window._guideAudio = null;
      }
    });
  })();
</script>
