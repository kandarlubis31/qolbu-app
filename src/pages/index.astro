  let quoteInterval = null;

  const initQuote = () => {
    if (window._quoteInitialized) return;
    const textEl = document.getElementById("quote-text");
    const sourceEl = document.getElementById("quote-source");
    const container = document.getElementById("quote-source-container");

    if (!textEl || !sourceEl) return;
    window._quoteInitialized = true;

    // Clear any existing interval from previous init
    if (quoteInterval) clearInterval(quoteInterval);

    const pickAndShow = (fadeIn = true) => {
      const randomIndex = Math.floor(Math.random() * quotesData.length);
      const selectedQuote = quotesData[randomIndex];

      textEl.innerText = `"${selectedQuote.text}"`;
      sourceEl.innerText = selectedQuote.source;

      if (fadeIn) {
        textEl.style.opacity = 1;
        if (container) container.style.opacity = '0.8';
      }
    };

    const updateQuote = () => {
      // 1. Fade Out
      textEl.style.opacity = 0;
      if (container) container.style.opacity = 0;

      // 2. Wait, change text, then Fade In
      setTimeout(() => {
        pickAndShow(true);
      }, 550);
    };

    // First show — skip the fade-out delay, show immediately
    pickAndShow(true);

    // Then auto-rotate every 10s with smooth fade
    quoteInterval = setInterval(updateQuote, 10000);
    window._quoteInterval = quoteInterval;
  };

  window._quoteInterval = null;

  // ===== OFFLINE QURAN CACHE BADGE =====
  const DB_NAME = 'qolbu-quran-cache';
  const DB_VERSION = 1;
  const STORE_NAME = 'surah-cache';

  function openDBCache() {
    return new Promise((resolve, reject) => {
      if (!window.indexedDB) { reject('no indexeddb'); return; }
      const req = indexedDB.open(DB_NAME, DB_VERSION);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'nomor' });
        }
      };
      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror = (e) => reject(e.target.error);
    });
  }

  async function getCachedCountFromDB() {
    try {
      const db = await openDBCache();
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).count();
        req.onsuccess = () => { db.close(); resolve(req.result); };
        req.onerror = () => { db.close(); resolve(0); };
      });
    } catch { return 0; }
  }

  const initCacheBadge = async () => {
    if (window._cacheBadgeInitialized) return;
    const badge = document.getElementById('cache-badge');
    const text = document.getElementById('cache-badge-text');
    if (!badge || !text) return;
    window._cacheBadgeInitialized = true;
    const count = await getCachedCountFromDB();
    if (count === 0) { badge.classList.add('hidden'); return; }
    badge.classList.remove('hidden');
    text.textContent = count + ' surah offline';
  };

  // ===== PRAYER CARD =====
  const PRAYER_ORDER = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
  const PRAYER_NAMES = { Fajr:'Subuh', Dhuhr:'Dzuhur', Asr:'Ashar', Maghrib:'Maghrib', Isha:'Isya' };
  let prayerInterval = null;

  function getPDate(timeStr) {
    const [h, m] = timeStr.split(':').map(Number);
    const d = new Date();
    d.setHours(h, m, 0, 0);
    return d;
  }

  function findNextPrayer(timings) {
    const now = new Date();
    for (let k of PRAYER_ORDER) {
      const t = getPDate(timings[k]);
      if (t > now) return { key: k, time: t, isTomorrow: false };
    }
    const t = getPDate(timings['Fajr']);
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(t.getHours(), t.getMinutes(), 0, 0);
    return { key: 'Fajr', time: tomorrow, isTomorrow: true };
  }

  const initPrayerCard = () => {
    if (window._prayerCardInitialized) return;
    const card = document.getElementById('prayer-card');
    if (!card) return;
    window._prayerCardInitialized = true;

    // Read settings to build cache key
    let settings = {};
    try { settings = JSON.parse(localStorage.getItem('sholat-settings') || '{}'); } catch {}
    const lat = settings.lat || -6.2088;
    const lng = settings.lng || 106.8456;
    const method = settings.method || 20;
    const correction = settings.correction || 2;

    // Build cache key same as sholat.astro
    const d = new Date();
    const dateStr = d.getDate() + '-' + (d.getMonth()+1) + '-' + d.getFullYear();
    const cacheKey = 'sholat-cache-' + dateStr + '-' + lat.toFixed(4) + '-' + lng.toFixed(4) + '-' + method + '-' + correction;

    function loadCachedData() {
      try {
        const raw = localStorage.getItem(cacheKey);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed.date === new Date().toDateString()) return parsed;
      } catch {}
      return null;
    }

    const cached = loadCachedData();
    if (!cached || !cached.data || !cached.data.timings) {
      // No cached prayer data yet, silently hide
      return;
    }

    const timings = cached.data.timings;

    // Show card
    card.classList.remove('hidden');

    // Fill 5 times
    PRAYER_ORDER.forEach(k => {
      const el = document.getElementById('pt-' + k);
      if (el && timings[k]) el.innerText = timings[k];
    });

    // Qibla
    const qibla = document.getElementById('prayer-qibla');
    if (qibla) {
      const kaabaLat = 21.4225, kaabaLng = 39.8262;
      const φ1 = lat * Math.PI / 180, φ2 = kaabaLat * Math.PI / 180;
      const Δλ = (kaabaLng - lng) * Math.PI / 180;
      const x = Math.sin(Δλ) * Math.cos(φ2);
      const y = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ);
      let q = Math.atan2(x, y) * 180 / Math.PI;
      qibla.innerText = '🕋 ' + ((q + 360) % 360).toFixed(1) + '°';
    }

    // Countdown
    function tick() {
      const next = findNextPrayer(timings);
      const now = new Date();
      const diff = next.time - now;
      if (diff <= 0) {
        document.getElementById('prayer-countdown').innerText = '00:00:00';
        return;
      }
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      document.getElementById('prayer-countdown').innerText =
        h.toString().padStart(2,'0') + ':' + m.toString().padStart(2,'0') + ':' + s.toString().padStart(2,'0');
      document.getElementById('prayer-next-name').innerText = PRAYER_NAMES[next.key];
    }

    if (prayerInterval) clearInterval(prayerInterval);
    tick();
    prayerInterval = setInterval(tick, 1000);
    window._prayerInterval = prayerInterval;
  };

  // ===== HIJRI EVENTS =====
  const HIJRI_EVENTS = [
    {month:'Muharram',day:1,name:'Tahun Baru Islam 1448 H',icon:'🌙'},
    {month:'Muharram',day:10,name:'Hari Asyura (Puasa Sunnah)',icon:'🤲'},
    {month:"Rabi' al-Awwal",day:12,name:'Maulid Nabi Muhammad ﷺ',icon:'🕌'},
    {month:'Rajab',day:27,name:"Isra' Mi'raj Nabi ﷺ",icon:'🕋'},
    {month:'Sha'ban',day:15,name:'Nisfu Sya\'ban',icon:'🌙'},
    {month:'Ramadan',day:1,name:'Awal Puasa Ramadhan',icon:'🌙'},
    {month:'Ramadan',day:17,name:"Nuzulul Qur'an",icon:'📖'},
    {month:'Ramadan',day:27,name:'Lailatul Qadr (malam ganjil)',icon:'✨'},
    {month:'Shawwal',day:1,name:'Idul Fitri 1448 H',icon:'🎉'},
    {month:'Shawwal',day:2,name:'Idul Fitri — Hari Kedua',icon:'🎉'},
    {month:'Dhu al-Hijjah',day:9,name:'Hari Arafah (Puasa Sunnah)',icon:'🤲'},
    {month:'Dhu al-Hijjah',day:10,name:'Idul Adha 1448 H',icon:'🐑'}
  ];

  const HIJRI_MONTHS = ['Muharram','Safar',"Rabi' al-Awwal","Rabi' al-Thani",'Jumada al-Awwal','Jumada al-Thani','Rajab','Sha'ban','Ramadan','Shawwal','Dhu al-Qi'dah','Dhu al-Hijjah'];

  // Normalize Aladhan API month name variations to our standard format
  const MONTH_ALIASES = {
    'Jumada I': 'Jumada al-Awwal',
    'Jumada al-Ula': 'Jumada al-Awwal',
    'Jumada II': 'Jumada al-Thani',
    'Jumada al-Akhirah': 'Jumada al-Thani',
    "Rabi\u02bb I": "Rabi' al-Awwal",
    "Rabi\u02bb II": "Rabi' al-Thani",
    "Dhu\u02bbl-Qi\u02bbdah": "Dhu al-Qi'dah",
    "Dhu\u02bbl-Hijjah": "Dhu al-Hijjah",
  };

  // Convert Hijri month name to index (0-based), handling aliases
  function hijriMonthIndex(name) {
    const normalized = MONTH_ALIASES[name] || name;
    return HIJRI_MONTHS.indexOf(normalized);
  }

  // Check if event (m1,d1) is after or same as current (m2,d2)
  function isAfterOrSame(m1, d1, m2, d2) {
    return m1 > m2 || (m1 === m2 && d1 >= d2);
  }

  const initHijriEvent = () => {
    if (window._hijriEventInitialized) return;
    const bar = document.getElementById('hijri-event');
    const icon = document.getElementById('hijri-event-icon');
    const text = document.getElementById('hijri-event-text');
    const daysEl = document.getElementById('hijri-event-days');
    if (!bar || !icon || !text || !daysEl) return;
    window._hijriEventInitialized = true;

    // Try to read today's Hijri date from sholat cache
    let settings = {};
    try { settings = JSON.parse(localStorage.getItem('sholat-settings') || '{}'); } catch {}
    const lat = settings.lat || -6.2088;
    const lng = settings.lng || 106.8456;
    const method = settings.method || 20;
    const correction = settings.correction || 2;
    const d = new Date();
    const dateStr = d.getDate() + '-' + (d.getMonth()+1) + '-' + d.getFullYear();
    const cacheKey = 'sholat-cache-' + dateStr + '-' + lat.toFixed(4) + '-' + lng.toFixed(4) + '-' + method + '-' + correction;

    let hijriMonth, hijriDay;
    try {
      const raw = localStorage.getItem(cacheKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed.data && parsed.data.date && parsed.data.date.hijri) {
          hijriMonth = parsed.data.date.hijri.month.en;
          hijriDay = parseInt(parsed.data.date.hijri.day);
        }
      }
    } catch {}

    if (!hijriMonth || !hijriDay) {
      bar.classList.add('hidden');
      return;
    }

    const curIdx = hijriMonthIndex(hijriMonth);
    if (curIdx === -1) { bar.classList.add('hidden'); return; }

    // Find next event (wrap around year)
    let nextEvent = null;
    for (const ev of HIJRI_EVENTS) {
      const evIdx = hijriMonthIndex(ev.month);
      if (evIdx === -1) continue;
      if (isAfterOrSame(evIdx, ev.day, curIdx, hijriDay)) {
        nextEvent = ev;
        break;
      }
    }
    // If no event found this year, pick first event of the year (wrap)
    if (!nextEvent) nextEvent = HIJRI_EVENTS[0];

    // Calculate days until event (approximate: 29-30 days per month)
    const evIdx = hijriMonthIndex(nextEvent.month);
    let daysUntil = 0;
    if (evIdx > curIdx || (evIdx === curIdx && nextEvent.day >= hijriDay)) {
      // Same year, same month
      if (evIdx === curIdx) {
        daysUntil = nextEvent.day - hijriDay;
      } else {
        // Different month: remaining days in current month + days in-between + event day
        daysUntil = (30 - hijriDay) + (evIdx - curIdx - 1) * 30 + nextEvent.day;
      }
    } else {
      // Wrap to next year
      daysUntil = (30 - hijriDay) + (11 - curIdx) * 30 + evIdx * 30 + nextEvent.day;
    }

    // If it's today or tomorrow, show nice label
    let daysLabel = '';
    if (daysUntil === 0) {
      daysLabel = 'Hari ini!';
    } else if (daysUntil === 1) {
      daysLabel = 'Besok!';
    } else {
      daysLabel = daysUntil + ' hari lagi';
    }

    icon.textContent = nextEvent.icon;
    text.textContent = nextEvent.name;
    daysEl.textContent = daysLabel;
    bar.classList.remove('hidden');
  };

  document.addEventListener("astro:page-load", initQuote);
  document.addEventListener("astro:page-load", initCacheBadge);
  document.addEventListener("astro:page-load", initPrayerCard);
  document.addEventListener("astro:page-load", initHijriEvent);

  // Clean up intervals on page unload (prevents memory leaks)
  document.addEventListener('astro:before-swap', () => {
    window._quoteInitialized = false;
    window._cacheBadgeInitialized = false;
    window._prayerCardInitialized = false;
    window._hijriEventInitialized = false;
    if (window._quoteInterval) { clearInterval(window._quoteInterval); window._quoteInterval = null; }
    if (window._prayerInterval) { clearInterval(window._prayerInterval); window._prayerInterval = null; }
  });
})();
</script>

