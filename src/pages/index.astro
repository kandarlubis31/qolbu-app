      text: "Jangan engkau merasa lemah dan jangan bersedih.",
      source: "QS. Ali Imran: 139",
    },
    {
      text: "Allah menyukai hamba yang bertawakal.",
      source: "QS. Ali Imran: 159",
    },
    {
      text: "Harta dan anak-anak adalah perhiasan dunia.",
      source: "QS. Al-Kahfi: 46",
    },
    {
      text: "Sesungguhnya pertolongan Allah itu dekat.",
      source: "QS. Al-Baqarah: 214",
    },
    {
      text: "Jadikan sabar dan shalat sebagai penolongmu.",
      source: "QS. Al-Baqarah: 45",
    },
    {
      text: "Sesungguhnya Allah Maha Mengetahui apa yang ada di langit dan di bumi.",
      source: "QS. Al-Hajj: 70",
    },
    {
      text: "Dan bertawakallah kepada Allah, cukuplah Allah sebagai pelindung.",
      source: "QS. Al-Ahzab: 3",
    },
    {
      text: "Sesungguhnya kehidupan akhirat itulah kehidupan yang sebenarnya.",
      source: "QS. Al-Ankabut: 64",
    },
    {
      text: "Allah bersama orang-orang yang bertakwa dan berbuat kebaikan.",
      source: "QS. An-Nahl: 128",
    },
    {
      text: "Dan barangsiapa yang bertawakal kepada Allah, niscaya Allah akan mencukupinya.",
      source: "QS. At-Thalaq: 3",
    },
    {
      text: "Sesungguhnya Allah tidak mengubah keadaan suatu kaum sehingga mereka mengubah keadaan diri mereka sendiri.",
      source: "QS. Ar-Ra'd: 11",
    },
    {
