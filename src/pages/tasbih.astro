---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Tasbih Digital">
  <div
    class="sticky top-16 z-40 -mx-4 flex items-center justify-between border-b border-slate-200 bg-white px-4 py-3 shadow-sm md:bg-white/95 md:backdrop-blur-md dark:border-slate-800 dark:bg-slate-900 md:dark:bg-slate-900/95"
  >
    <a
      href="/"
      class="-ml-2 flex items-center gap-2 rounded-lg p-2 text-slate-600 transition-colors hover:text-emerald-600 active:bg-slate-100 dark:text-slate-400 dark:active:bg-slate-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
      >
      <span class="text-sm font-medium">Dashboard</span>
    </a>
    <h1 class="text-sm font-bold text-slate-800 dark:text-white">Tasbih Digital</h1>
    <div class="flex gap-2">
      <select
        id="target-select"
        aria-label="Pilih target hitungan"
        class="cursor-pointer rounded-lg border-none bg-slate-100 px-2 py-1 text-xs text-slate-600 outline-none dark:bg-slate-800 dark:text-slate-300"
      >
        <option value="33">Target: 33</option>
        <option value="99">Target: 99</option>
        <option value="100">Target: 100</option>
        <option value="0">Tanpa Batas</option>
      </select>
      <button
        id="reset-btn"
        aria-label="Reset hitungan tasbih"
        class="rounded-lg bg-rose-100 p-2 text-rose-600 transition-colors hover:bg-rose-200 dark:bg-rose-900/30"
        title="Reset Hitungan"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"
          ></path></svg
        >
      </button>
    </div>
  </div>

  <div class="flex min-h-[80vh] flex-col items-center justify-center px-4 py-6">
    <!-- Dhikr Selection -->
    <div class="mb-6 w-full max-w-md">
      <div class="mb-4 flex flex-wrap justify-center gap-2">
        <button
          class="dhikr-btn rounded-full bg-emerald-100 px-4 py-2 text-sm font-medium text-emerald-700 transition-colors dark:bg-emerald-900/30 dark:text-emerald-300"
          data-dhikr="Subhanallah">Subhanallah</button
        >
        <button
          class="dhikr-btn rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-600 transition-colors dark:bg-slate-800 dark:text-slate-300"
          data-dhikr="Alhamdulillah">Alhamdulillah</button
        >
        <button
          class="dhikr-btn rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-600 transition-colors dark:bg-slate-800 dark:text-slate-300"
          data-dhikr="Allahu Akbar">Allahu Akbar</button
        >
        <button
          class="dhikr-btn rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-600 transition-colors dark:bg-slate-800 dark:text-slate-300"
          data-dhikr="Laa ilaaha illallah">Laa ilaaha illallah</button
        >
      </div>
      <div class="text-center">
        <p id="current-dhikr" class="text-lg font-medium text-slate-700 dark:text-slate-300">
          Subhanallah
        </p>
        <p
          id="sequence-indicator"
          class="mt-1 hidden text-[10px] font-bold tracking-wider text-emerald-500 uppercase"
        >
          <span id="seq-current">1</span> / <span id="seq-total">4</span>
        </p>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="mb-6 w-full max-w-md">
      <div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
        <div
          id="progress-bar"
          class="h-full bg-emerald-500 transition-all duration-300"
          style="width: 0%"
        >
        </div>
      </div>
      <div class="mt-1 flex justify-between">
        <span id="progress-text" class="text-xs text-slate-500 dark:text-slate-400">0 / 33</span>
        <span id="percentage-text" class="text-xs text-slate-500 dark:text-slate-400">0%</span>
      </div>
    </div>

    <button
      id="counter-btn"
      class="group relative flex h-72 w-72 touch-manipulation items-center justify-center rounded-full transition-all duration-100 select-none active:scale-95"
    >
      <div
        class="absolute inset-0 animate-pulse rounded-full bg-emerald-500 opacity-10 group-hover:opacity-20"
      >
      </div>
      <div
        class="absolute inset-4 flex flex-col items-center justify-center rounded-full border-8 border-emerald-50 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-800"
      >
        <span class="mb-2 text-xs font-bold tracking-widest text-slate-400 uppercase">Hitungan</span
        >

        <h1
          id="count-display"
          class="text-8xl font-black tracking-tighter text-slate-800 tabular-nums dark:text-white"
        >
          0
        </h1>

        <p
          id="target-display"
          class="mt-2 text-xs font-medium text-emerald-500 opacity-0 transition-opacity"
        >
          Target Tercapai! 🎉
        </p>
      </div>

      <span class="pointer-events-none absolute inset-0 overflow-hidden rounded-full"></span>
    </button>

    <div class="mt-12 space-y-2 text-center">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Klik lingkaran atau tekan <kbd
          class="rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-xs dark:border-slate-700 dark:bg-slate-800"
          >Spasi</kbd
        >
      </p>

      <div class="mt-4 flex justify-center gap-4">
        <button
          id="toggle-vibrate"
          class="flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-xs font-medium text-slate-600 opacity-100 transition-colors dark:bg-slate-800 dark:text-slate-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
          >
          Getar: ON
        </button>
        <button
          id="toggle-sound"
          class="flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-xs font-medium text-slate-600 opacity-100 transition-colors dark:bg-slate-800 dark:text-slate-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path
              d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg
          >
          Suara: ON
        </button>
        <button
          id="toggle-autocycle"
          class="flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-medium text-emerald-600 transition-colors dark:border-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="23 4 23 10 17 10"></polyline><path
              d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg
          >
          Auto-Cycle
        </button>
      </div>

      <!-- Statistics -->
      <div class="mt-6 w-full max-w-md rounded-lg bg-slate-100 p-4 dark:bg-slate-800">
        <h3 class="mb-2 text-sm font-medium text-slate-700 dark:text-slate-300">
          Statistik Hari Ini
        </h3>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div>
            <p id="today-total" class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">
              0
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Total</p>
          </div>
          <div>
            <p id="today-sessions" class="text-2xl font-bold text-blue-600 dark:text-blue-400">0</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Sesi</p>
          </div>
          <div>
            <p id="today-streak" class="text-2xl font-bold text-purple-600 dark:text-purple-400">
              0
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Streak</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Success Modal -->
  <div
    id="success-modal"
    class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/50"
  >
    <div
      class="mx-4 max-w-sm scale-95 transform rounded-2xl bg-white p-6 opacity-0 transition-all dark:bg-slate-800"
    >
      <div class="text-center">
        <div
          class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/30"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-emerald-600 dark:text-emerald-400"
            ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
              points="22 4 12 14.01 9 11.01"></polyline></svg
          >
        </div>
        <h3 class="mb-2 text-xl font-bold text-slate-800 dark:text-white">Target Tercapai!</h3>
        <p class="mb-4 text-slate-600 dark:text-slate-300">
          Anda telah menyelesaikan <span id="completed-dhikr">Subhanallah</span> sebanyak <span
            id="completed-count">33</span
          > kali.
        </p>
        <p id="completion-badge" class="mb-3 hidden text-[10px] font-bold text-emerald-500">
          ✨ Semua selesai! Kembali ke awal.
        </p>
        <div class="flex justify-center gap-2">
          <button
            id="continue-btn"
            class="rounded-lg bg-emerald-600 px-4 py-2 text-white transition-colors hover:bg-emerald-700"
            >Lanjut</button
          >
          <button
            id="reset-modal-btn"
            class="rounded-lg bg-slate-200 px-4 py-2 text-slate-700 transition-colors hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600"
            >Reset</button
          >
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const initTasbih = () => {
      if (window._tasbihInitialized) return;
      // DOM Elements
      const countDisplay = document.getElementById('count-display');
      const counterBtn = document.getElementById('counter-btn');
      if (!countDisplay || !counterBtn) return;
      window._tasbihInitialized = true;
      const resetBtn = document.getElementById('reset-btn');
      const targetSelect = document.getElementById('target-select');
      const targetDisplay = document.getElementById('target-display');
      const toggleVibrate = document.getElementById('toggle-vibrate');
      const toggleSound = document.getElementById('toggle-sound');
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-text');
      const percentageText = document.getElementById('percentage-text');
      const successModal = document.getElementById('success-modal');
      const modalContent = successModal ? successModal.querySelector('div') : null;
      const continueBtn = document.getElementById('continue-btn');
      const resetModalBtn = document.getElementById('reset-modal-btn');
      const completedDhikr = document.getElementById('completed-dhikr');
      const completedCount = document.getElementById('completed-count');
      const currentDhikrDisplay = document.getElementById('current-dhikr');
      const dhikrBtns = document.querySelectorAll('.dhikr-btn');

      // Sequence Elements
      const sequenceIndicator = document.getElementById('sequence-indicator');
      const seqCurrent = document.getElementById('seq-current');
      const seqTotal = document.getElementById('seq-total');
      const toggleAutoCycle = document.getElementById('toggle-autocycle');
      const completionBadge = document.getElementById('completion-badge');

      // Statistics Elements
      const todayTotal = document.getElementById('today-total');
      const todaySessions = document.getElementById('today-sessions');
      const todayStreak = document.getElementById('today-streak');

      // Multi-dhikr sequence
      const DHIKR_SEQUENCE = [
        'Subhanallah',
        'Alhamdulillah',
        'Allahu Akbar',
        'Laa ilaaha illallah',
      ];

      // State
      let count = parseInt(localStorage.getItem('tasbih-count') || '0');
      let target = parseInt(localStorage.getItem('tasbih-target') || '33');
      let vibrateEnabled = localStorage.getItem('tasbih-vibrate') !== 'false'; // Default ON
      let soundEnabled = localStorage.getItem('tasbih-sound') !== 'false'; // Default ON
      let autoCycle = localStorage.getItem('tasbih-autocycle') === 'true'; // Default OFF
      let currentDhikr = localStorage.getItem('tasbih-dhikr') || 'Subhanallah';
      let dhikrIndex = DHIKR_SEQUENCE.indexOf(currentDhikr);
      if (dhikrIndex === -1) dhikrIndex = 0;

      // Statistics State
      let todayDate = new Date().toDateString();
      let stats = JSON.parse(localStorage.getItem('tasbih-stats') || '{}');

      // Initialize today's stats if not exists
      if (!stats[todayDate]) {
        stats[todayDate] = {
          total: 0,
          sessions: 0,
          completed: false,
        };
      }

      // Audio context for sound effects
      let audioContext;

      // Init UI
      countDisplay.innerText = count;
      targetSelect.value = target;
      currentDhikrDisplay.innerText = currentDhikr;
      updateVibrateUI();
      updateSoundUI();
      updateAutoCycleUI();
      updateProgressBar();
      updateStatistics();
      updateDhikrButtons();
      updateSequenceUI();

      // --- Logic Functions ---

      function updateDhikrButtons() {
        dhikrBtns.forEach((btn) => {
          if (btn.dataset.dhikr === currentDhikr) {
            btn.classList.remove(
              'bg-slate-100',
              'dark:bg-slate-800',
              'text-slate-600',
              'dark:text-slate-300'
            );
            btn.classList.add(
              'bg-emerald-100',
              'dark:bg-emerald-900/30',
              'text-emerald-700',
              'dark:text-emerald-300'
            );
          } else {
            btn.classList.remove(
              'bg-emerald-100',
              'dark:bg-emerald-900/30',
              'text-emerald-700',
              'dark:text-emerald-300'
            );
            btn.classList.add(
              'bg-slate-100',
              'dark:bg-slate-800',
              'text-slate-600',
              'dark:text-slate-300'
            );
          }
        });
      }

      function updateVibrateUI() {
        if (vibrateEnabled) {
          toggleVibrate.classList.remove('opacity-50');
          toggleVibrate.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg> Getar: ON`;
        } else {
          toggleVibrate.classList.add('opacity-50');
          toggleVibrate.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg> Getar: OFF`;
        }
      }

      function updateSoundUI() {
        if (soundEnabled) {
          toggleSound.classList.remove('opacity-50');
          toggleSound.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg> Suara: ON`;
        } else {
          toggleSound.classList.add('opacity-50');
          toggleSound.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg> Suara: OFF`;
        }
      }

      function updateProgressBar() {
        if (target > 0) {
          const percentage = Math.min((count / target) * 100, 100);
          progressBar.style.width = `${percentage}%`;
          progressText.textContent = `${count} / ${target}`;
          percentageText.textContent = `${Math.round(percentage)}%`;
        } else {
          progressBar.style.width = '0%';
          progressText.textContent = `${count} / ∞`;
          percentageText.textContent = '0%';
        }
      }

      function updateSequenceUI() {
        if (autoCycle && target > 0) {
          sequenceIndicator.classList.remove('hidden');
          seqCurrent.textContent = dhikrIndex + 1;
          seqTotal.textContent = DHIKR_SEQUENCE.length;
        } else {
          sequenceIndicator.classList.add('hidden');
        }
      }

      function updateAutoCycleUI() {
        if (autoCycle) {
          toggleAutoCycle.classList.add(
            'bg-emerald-50',
            'dark:bg-emerald-900/30',
            'text-emerald-600',
            'dark:text-emerald-400',
            'border-emerald-200',
            'dark:border-emerald-800'
          );
          toggleAutoCycle.classList.remove(
            'bg-slate-100',
            'dark:bg-slate-800',
            'text-slate-600',
            'dark:text-slate-300'
          );
          toggleAutoCycle.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Auto-Cycle: ON`;
          updateSequenceUI();
        } else {
          toggleAutoCycle.classList.remove(
            'bg-emerald-50',
            'dark:bg-emerald-900/30',
            'text-emerald-600',
            'dark:text-emerald-400',
            'border-emerald-200',
            'dark:border-emerald-800'
          );
          toggleAutoCycle.classList.add(
            'bg-slate-100',
            'dark:bg-slate-800',
            'text-slate-600',
            'dark:text-slate-300'
          );
          toggleAutoCycle.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Auto-Cycle`;
          updateSequenceUI();
        }
      }

      function updateStatistics() {
        // Update today's stats
        todayTotal.textContent = stats[todayDate].total;
        todaySessions.textContent = stats[todayDate].sessions;

        // Calculate streak: hanya hitung jika hari ini completed
        let streak = 0;

        if (stats[todayDate] && stats[todayDate].completed) {
          streak = 1; // Today counts
          let currentDate = new Date();
          currentDate.setDate(currentDate.getDate() - 1);

          while (true) {
            const dateStr = currentDate.toDateString();
            if (stats[dateStr] && stats[dateStr].completed) {
              streak++;
              currentDate.setDate(currentDate.getDate() - 1);
            } else {
              break;
            }
          }
        }

        todayStreak.textContent = streak;
      }

      function playSound(frequency = 800, duration = 100) {
        if (!soundEnabled) return;

        // Initialize audio context on first user interaction
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);

        oscillator.frequency.value = frequency;
        oscillator.type = 'sine';

        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(
          0.01,
          audioContext.currentTime + duration / 1000
        );

        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + duration / 1000);
      }

      function triggerFeedback() {
        // Efek Getar (Haptic) - Cuma jalan di HP Android
        if (vibrateEnabled && navigator.vibrate) {
          navigator.vibrate(15); // Getar pendek 15ms
        }

        // Play sound
        playSound(800, 100);

        // Animasi Scale
        countDisplay.classList.add('scale-110', 'text-emerald-600', 'dark:text-emerald-400');
        setTimeout(() => {
          countDisplay.classList.remove('scale-110', 'text-emerald-600', 'dark:text-emerald-400');
        }, 100);

        // Update progress bar
        updateProgressBar();
      }

      function switchToNextDhikr() {
        // Move to next dhikr in sequence
        dhikrIndex = (dhikrIndex + 1) % DHIKR_SEQUENCE.length;
        currentDhikr = DHIKR_SEQUENCE[dhikrIndex];
        currentDhikrDisplay.innerText = currentDhikr;
        localStorage.setItem('tasbih-dhikr', currentDhikr);
        updateDhikrButtons();
        updateSequenceUI();

        // Reset count untuk mulai menghitung dhikr baru dari 0
        count = 0;
        countDisplay.innerText = count;
        localStorage.setItem('tasbih-count', count);
        updateProgressBar();
        targetDisplay.classList.add('opacity-0');

        // Check if we wrapped around to the start (all done)
        if (dhikrIndex === 0) {
          completionBadge.classList.remove('hidden');
          setTimeout(() => completionBadge.classList.add('hidden'), 3000);
        }
      }

      function checkTarget() {
        if (target > 0 && count > 0 && count % target === 0) {
          // Prevent double-trigger: only fire once per target milestone
          if (window._tasbihLastTriggered === count) return;
          window._tasbihLastTriggered = count;
          // Getar panjang dikit kalau target tercapai
          if (vibrateEnabled && navigator.vibrate) navigator.vibrate([50, 50, 50]);

          // Play success sound
          playSound(1200, 200);

          // Update statistics
          stats[todayDate].total += target;
          stats[todayDate].sessions += 1;
          stats[todayDate].completed = true;
          localStorage.setItem('tasbih-stats', JSON.stringify(stats));
          updateStatistics();

          // Show success modal
          completedDhikr.textContent = currentDhikr;
          completedCount.textContent = target;
          successModal.classList.remove('hidden');
          setTimeout(() => {
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
          }, 10);

          // Also show the old notification for backward compatibility
          targetDisplay.classList.remove('opacity-0');
          targetDisplay.classList.add('animate-bounce');
          setTimeout(() => {
            targetDisplay.classList.add('opacity-0');
            targetDisplay.classList.remove('animate-bounce');
          }, 2000);
        }
      }

      function increment() {
        count++;
        countDisplay.innerText = count;
        localStorage.setItem('tasbih-count', count);
        triggerFeedback();
        checkTarget();
      }

      function reset(silent = false) {
        if (!silent && !confirm('Reset hitungan ke 0?')) return;
        count = 0;
        countDisplay.innerText = count;
        localStorage.setItem('tasbih-count', count);
        updateProgressBar();
        if (vibrateEnabled && navigator.vibrate) navigator.vibrate(50);
      }

      function closeModal() {
        if (!modalContent) return;
        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          successModal.classList.add('hidden');
        }, 300);
      }

      // --- Event Listeners ---

      counterBtn.addEventListener('mousedown', (e) => {
        // Mencegah double tap zoom di beberapa browser
        if (e.detail > 1) e.preventDefault();
      });

      counterBtn.addEventListener('click', increment);

      // Support Keyboard (Spasi / Enter) — pakai flag biar gak numpuk
      if (!window._tasbihKeydownRegistered) {
        document.addEventListener('keydown', (e) => {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault(); // Biar gak scroll halaman
            const btn = document.getElementById('counter-btn');
            if (btn) btn.click(); // dispatch click pake listener terbaru
          }
        });
        window._tasbihKeydownRegistered = true;
      }

      resetBtn.addEventListener('click', reset);

      targetSelect.addEventListener('change', (e) => {
        target = parseInt(e.target.value);
        localStorage.setItem('tasbih-target', target);
        updateProgressBar();
      });

      toggleVibrate.addEventListener('click', () => {
        vibrateEnabled = !vibrateEnabled;
        localStorage.setItem('tasbih-vibrate', vibrateEnabled);
        updateVibrateUI();
        if (vibrateEnabled && navigator.vibrate) navigator.vibrate(30);
      });

      toggleSound.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        localStorage.setItem('tasbih-sound', soundEnabled);
        updateSoundUI();
        if (soundEnabled) playSound(1000, 100);
      });

      toggleAutoCycle.addEventListener('click', () => {
        autoCycle = !autoCycle;
        localStorage.setItem('tasbih-autocycle', autoCycle);
        updateAutoCycleUI();
        if (vibrateEnabled && navigator.vibrate) navigator.vibrate(20);
      });

      // Dhikr selection
      dhikrBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentDhikr = btn.dataset.dhikr;
          dhikrIndex = DHIKR_SEQUENCE.indexOf(currentDhikr);
          if (dhikrIndex === -1) dhikrIndex = 0;
          currentDhikrDisplay.innerText = currentDhikr;
          localStorage.setItem('tasbih-dhikr', currentDhikr);
          updateDhikrButtons();
          updateSequenceUI();
          if (vibrateEnabled && navigator.vibrate) navigator.vibrate(20);
        });
      });

      // Modal buttons
      continueBtn.addEventListener('click', () => {
        closeModal();
        if (autoCycle) {
          switchToNextDhikr();
        }
      });

      resetModalBtn.addEventListener('click', () => {
        closeModal();
        if (autoCycle) {
          switchToNextDhikr();
        } else {
          reset(true); // silent reset
        }
      });

      // Check if date changed and update stats — clear previous interval dulu
      if (window._tasbihStatsInterval) clearInterval(window._tasbihStatsInterval);
      window._tasbihStatsInterval = setInterval(() => {
        const newDate = new Date().toDateString();
        if (newDate !== todayDate) {
          todayDate = newDate;
          if (!stats[todayDate]) {
            stats[todayDate] = {
              total: 0,
              sessions: 0,
              completed: false,
            };
          }
          updateStatistics();
        }
      }, 60000); // Check every minute
    };

    document.addEventListener('astro:page-load', initTasbih);
    document.addEventListener('astro:before-swap', () => {
      window._tasbihInitialized = false;
      if (window._tasbihStatsInterval) {
        clearInterval(window._tasbihStatsInterval);
        delete window._tasbihStatsInterval;
      }
      if (window._tasbihKeydownRegistered) {
        delete window._tasbihKeydownRegistered;
      }
      if (window._tasbihLastTriggered) {
        delete window._tasbihLastTriggered;
      }
    });
  })();
</script>
