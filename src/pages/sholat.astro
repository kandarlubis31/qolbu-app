---
import BaseLayout from '../layouts/BaseLayout.astro';
import SettingsModal from '../components/SettingsModal.astro';
import Toast from '../components/Toast.astro';
---

<BaseLayout pageTitle="Jadwal Sholat & Kiblat">
  
  <div class="sticky top-16 z-30 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md px-4 py-3 flex items-center justify-between border-b border-slate-100 dark:border-slate-800 shadow-sm transition-all">
    <a href="/" class="flex items-center gap-2 text-slate-500 hover:text-emerald-600 transition-colors p-2 -ml-2 rounded-lg active:bg-slate-50 dark:active:bg-slate-800">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span class="font-medium text-sm">Dashboard</span>
    </a>
    
    <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-full">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span id="location-text" class="text-xs font-bold text-slate-600 dark:text-slate-300 truncate max-w-[120px]">Mencari...</span>
    </div>
    
    <button id="settings-btn" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors active:scale-95">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </button>
  </div>

  <div class="pb-24 pt-6 px-4 w-full max-w-md mx-auto">
    
    <div class="relative overflow-hidden bg-gradient-to-br from-emerald-500 to-teal-700 rounded-3xl p-6 text-white shadow-xl shadow-emerald-500/20 mb-6">
      <div class="absolute top-0 right-0 opacity-10 transform translate-x-4 -translate-y-4">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
      </div>

      <div class="relative z-10 text-center">
        <div class="flex items-center justify-center gap-2 mb-1">
          <span id="countdown-status" class="text-emerald-100 text-xs font-medium uppercase tracking-widest">Menuju Waktu</span>
          <span id="besok-badge" class="hidden text-[10px] font-bold bg-amber-400 text-amber-900 px-2 py-0.5 rounded-full">Besok</span>
        </div>
        <h2 id="next-prayer-name" class="text-2xl font-bold mb-2">Memuat...</h2>
        
        <div class="bg-white/20 backdrop-blur-md rounded-xl p-3 inline-block min-w-[140px] border border-white/10 shadow-inner relative">
          <h1 id="countdown" class="text-4xl font-black tabular-nums tracking-tight">--:--:--</h1>
          <div id="countdown-label" class="text-[10px] text-emerald-200 mt-0.5">Tersisa</div>
        </div>

        <!-- Progress bar -->
        <div id="progress-container" class="hidden mt-3 mx-auto max-w-[200px]">
          <div class="flex justify-between text-[9px] text-emerald-200 mb-1">
            <span id="progress-label">Waktu berjalan</span>
            <span id="progress-pct">0%</span>
          </div>
          <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-white/60 rounded-full transition-all duration-1000 ease-linear" style="width: 0%"></div>
          </div>
        </div>
        
        <div class="mt-4 flex flex-col gap-0.5">
          <p id="gregorian-date" class="text-xs font-bold text-white">...</p>
          <p id="hijri-date" class="text-[10px] text-emerald-200">...</p>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 mb-6 shadow-sm border border-slate-100 dark:border-slate-700">
      <div class="flex items-center justify-between mb-4">
        <div>
           <h3 class="font-bold text-sm text-slate-800 dark:text-slate-200">Arah Kiblat</h3>
           <p class="text-[10px] text-slate-500">Akurasi bergantung sensor HP</p>
        </div>
        <button id="qibla-compass-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold hover:bg-emerald-100 transition-colors active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.4 2.4"/><path d="m14.1 11.9-2.1 2.1"/><path d="m11 15-3 3"/></svg>
          Buka Kompas
        </button>
      </div>
      
      <div class="flex items-center gap-4">
        <div class="relative w-12 h-12 flex-shrink-0">
          <div class="absolute inset-0 rounded-full border-2 border-slate-200 dark:border-slate-600"></div>
          <div id="qibla-preview-needle" class="absolute inset-0 flex items-center justify-center transition-transform duration-[800ms] ease-out">
             <div class="w-1 h-8 bg-emerald-500 rounded-full relative">
                <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-emerald-500 rotate-45"></div>
             </div>
          </div>
        </div>
        <div>
           <p class="text-xs text-slate-500 dark:text-slate-400">Sudut dari Utara:</p>
           <p id="qibla-direction-text" class="text-xl font-bold text-slate-800 dark:text-white">...</p>
        </div>
      </div>
    </div>

    <div id="imsak-container" class="hidden mb-3">
      <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/50 border-dashed">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span class="font-bold text-sm text-slate-600 dark:text-slate-300">Imsak</span>
        </div>
        <span id="imsak-time" class="font-mono font-bold text-sm text-slate-600 dark:text-slate-300">--:--</span>
      </div>
    </div>

    <div id="sunrise-container" class="hidden mb-2">
      <div class="flex items-center justify-between p-3 rounded-xl bg-amber-50/60 dark:bg-amber-900/10 border border-amber-100/50 dark:border-amber-800/30">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <span class="text-xs font-bold text-amber-600 dark:text-amber-400">Syuruq (Terbit)</span>
        </div>
        <span id="sunrise-time" class="font-mono font-bold text-sm text-amber-600 dark:text-amber-400">--:--</span>
      </div>
    </div>

    <div id="dhuha-container" class="hidden mb-3">
      <div class="flex items-center justify-between p-3 rounded-xl bg-yellow-50/60 dark:bg-yellow-900/10 border border-yellow-100/50 dark:border-yellow-800/30">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <span class="text-xs font-bold text-yellow-600 dark:text-yellow-400">Dhuha</span>
        </div>
        <span id="dhuha-time" class="font-mono font-bold text-sm text-yellow-600 dark:text-yellow-400">--:--</span>
      </div>
    </div>

    <div id="prayer-list" class="space-y-2">
      {[1,2,3,4,5].map(() => (
        <div class="animate-pulse flex items-center justify-between p-4 rounded-2xl bg-slate-100 dark:bg-slate-800">
          <div class="h-4 w-24 bg-slate-200 dark:bg-slate-700 rounded"></div>
          <div class="h-6 w-16 bg-slate-200 dark:bg-slate-700 rounded"></div>
        </div>
      ))}
    </div>

    <div class="mt-6 text-center">
        <p class="text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-800 py-2 px-4 rounded-full inline-block">
            <span class="font-bold text-emerald-500">Info:</span> Waktu sudah ditambah <span id="correction-display">2</span> menit (Ihtiyat).
        </p>
    </div>

    <div class="mt-4 text-center">
      <button id="refresh-loc-btn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 text-xs font-bold shadow-md hover:shadow-lg transition-all active:scale-95 border border-slate-100 dark:border-slate-700">
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>Update Lokasi GPS</span>
      </button>
    </div>
  </div>

  <SettingsModal overlayId="settings-overlay" closeId="close-settings-btn" title="Pengaturan Sholat">
    <div class="space-y-6">
      
      <div class="bg-amber-50 dark:bg-amber-900/20 p-4 rounded-xl border border-amber-100 dark:border-amber-800">
          <h4 class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-2">Koreksi Waktu (Ihtiyat)</h4>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 mb-3">
              Tambahkan menit agar sesuai jadwal resmi masjid. Default aman: <strong>+2 Menit</strong>.
          </p>
          <div class="flex items-center gap-3">
              <button id="btn-minus-cor" class="w-10 h-10 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-lg font-bold hover:bg-slate-50 active:scale-95 transition-all">-</button>
              <div class="flex-1 text-center bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 h-10 rounded-lg flex items-center justify-center font-mono font-bold" id="input-correction">2</div>
              <button id="btn-plus-cor" class="w-10 h-10 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-lg font-bold hover:bg-slate-50 active:scale-95 transition-all">+</button>
          </div>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Lokasi</h4>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Gunakan GPS Otomatis</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="use-current-location" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
          </div>
          
          <div id="manual-location" class="hidden space-y-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-700">
            <p class="text-xs text-slate-500">Masukkan koordinat manual:</p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                  <label class="text-[10px] text-slate-400">Latitude</label>
                  <input type="number" id="lat-input" placeholder="-6.2000" step="any" class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg text-sm outline-none focus:border-emerald-500">
              </div>
              <div>
                  <label class="text-[10px] text-slate-400">Longitude</label>
                  <input type="number" id="lng-input" placeholder="106.8000" step="any" class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg text-sm outline-none focus:border-emerald-500">
              </div>
            </div>
            <div>
               <label class="text-[10px] text-slate-400">Nama Kota (Opsional)</label>
               <input type="text" id="city-input" placeholder="Contoh: Jakarta" class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg text-sm outline-none focus:border-emerald-500">
            </div>
          </div>
        </div>
      </div>
      
      <hr class="border-slate-100 dark:border-slate-800"/>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Metode Perhitungan</h4>
        <select id="calc-method" class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 outline-none focus:ring-2 focus:ring-emerald-500/20">
          <option value="20">Kemenag RI (Indonesia)</option>
          <option value="11">MUIS (Singapura)</option>
          <option value="3">Muslim World League</option>
          <option value="2">ISNA (North America)</option>
          <option value="4">Umm Al-Qura (Makkah)</option>
          <option value="5">Egyptian General Authority</option>
        </select>
      </div>

      <hr class="border-slate-100 dark:border-slate-800"/>
      
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Notifikasi & Suara</h4>
        
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Suara Adzan</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="adhan-notification" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
          </div>

          <!-- Volume slider -->
          <div id="volume-container" class="flex items-center gap-3 px-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 flex-shrink-0"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/></svg>
            <input type="range" id="adhan-volume" min="0" max="100" value="70" class="flex-1 h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full appearance-none cursor-pointer accent-emerald-500">
            <span id="adhan-volume-value" class="text-xs font-mono font-bold text-slate-500 w-8 text-right">70%</span>
          </div>

          <button id="test-adhan-btn" class="w-full py-2.5 rounded-xl font-bold text-xs transition-all bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 active:scale-95">
            <span class="flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Test Suara Adzan
            </span>
          </button>

          <hr class="border-slate-100 dark:border-slate-800"/>

          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Pengingat (10 Menit Sebelum)</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="reminder-notification" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
          </div>
        </div>
        <p class="text-[10px] text-amber-500 mt-2 italic">*Izin notifikasi browser & interaksi pengguna diperlukan untuk suara adzan.</p>
      </div>
      
      <button id="save-settings-btn" class="w-full py-3 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 transition-colors shadow-lg shadow-emerald-500/30 active:scale-95">
        Simpan Perubahan
      </button>
    </div>
  </SettingsModal>

  <div id="qibla-modal" class="fixed inset-0 z-[100] bg-slate-900 hidden text-white">
    <div class="absolute top-4 right-4 z-20">
       <button id="close-qibla-btn" class="p-2 bg-slate-800 rounded-full text-slate-300 hover:bg-slate-700 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
       </button>
    </div>

    <div class="flex flex-col items-center justify-center h-full px-6 relative">
       <div class="relative w-72 h-72 mb-10">
          <div class="absolute inset-0 rounded-full border-4 border-slate-700 flex items-center justify-center">
             <span class="absolute -top-8 font-bold text-emerald-500">Utara</span>
          </div>

          <div id="qibla-compass-disc" class="absolute inset-0 will-change-transform">
             <div class="w-full h-full rounded-full border border-slate-700/50 bg-slate-800/50 relative">
                 <div class="absolute top-2 left-1/2 -translate-x-1/2 w-1 h-3 bg-red-500"></div> 
                 <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-1 h-3 bg-slate-600"></div>
                 <div class="absolute left-2 top-1/2 -translate-y-1/2 w-3 h-1 bg-slate-600"></div>
                 <div class="absolute right-2 top-1/2 -translate-y-1/2 w-3 h-1 bg-slate-600"></div>
             </div>
          </div>
          
          <div id="qibla-arrow-container" class="absolute inset-0 flex items-center justify-center z-10">
             <div class="relative w-16 h-16 animate-pulse-slow">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl drop-shadow-[0_0_15px_rgba(16,185,129,0.5)]">🕋</div>
             </div>
             <div class="absolute w-1 h-32 bg-transparent -top-10">
                <div class="w-full h-1/2 bg-gradient-to-t from-emerald-500 to-transparent mx-auto rounded-full"></div>
             </div>
          </div>
       </div>

       <div class="text-center space-y-2 z-10">
          <h2 class="text-2xl font-bold">Cari Arah Kiblat</h2>
          <p class="text-slate-400 text-sm max-w-xs mx-auto">
             Putar HP Anda mendatar sampai ikon Ka'bah lurus dengan panah hijau.
          </p>
          <div class="mt-4 p-3 bg-slate-800 rounded-xl border border-slate-700 inline-block">
             <p class="text-xs text-slate-400">Derajat Kiblat</p>
             <p id="qibla-degree-modal" class="text-xl font-bold text-emerald-400">...°</p>
          </div>
       </div>
       
       <button id="ios-permission-btn" class="hidden mt-6 px-6 py-3 bg-emerald-600 rounded-full font-bold shadow-lg transition-colors hover:bg-emerald-700 active:scale-95">
          Izinkan Akses Kompas
       </button>
    </div>
  </div>

  <Toast />

</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', initSholat);
  document.addEventListener('astro:after-swap', initSholat);

  function initSholat() {
    const els = {
      locText: document.getElementById('location-text'),
      list: document.getElementById('prayer-list'),
      imsakCont: document.getElementById('imsak-container'),
      imsakTime: document.getElementById('imsak-time'),
      nextName: document.getElementById('next-prayer-name'),
      count: document.getElementById('countdown'),
      countLabel: document.getElementById('countdown-label'),
      countStatus: document.getElementById('countdown-status'),
      besokBadge: document.getElementById('besok-badge'),
      hijri: document.getElementById('hijri-date'),
      gregorian: document.getElementById('gregorian-date'),
      refresh: document.getElementById('refresh-loc-btn'),
      refreshIcon: document.getElementById('refresh-icon'),
      corDisplay: document.getElementById('correction-display'),
      progressCont: document.getElementById('progress-container'),
      progressBar: document.getElementById('progress-bar'),
      progressPct: document.getElementById('progress-pct'),
      progressLabel: document.getElementById('progress-label'),
      sunriseCont: document.getElementById('sunrise-container'),
      sunriseTime: document.getElementById('sunrise-time'),
      dhuhaCont: document.getElementById('dhuha-container'),
      dhuhaTime: document.getElementById('dhuha-time'),

      settingsBtn: document.getElementById('settings-btn'),
      settingsModal: document.getElementById('settings-modal'),
      closeSet: document.getElementById('close-settings-btn'),
      saveSet: document.getElementById('save-settings-btn'),
      settingsOverlay: document.getElementById('settings-overlay'),

      useGPS: document.getElementById('use-current-location'),
      manualBox: document.getElementById('manual-location'),
      latIn: document.getElementById('lat-input'),
      lngIn: document.getElementById('lng-input'),
      cityIn: document.getElementById('city-input'),
      method: document.getElementById('calc-method'),
      adhan: document.getElementById('adhan-notification'),
      remind: document.getElementById('reminder-notification'),
      volumeSlider: document.getElementById('adhan-volume'),
      volumeValue: document.getElementById('adhan-volume-value'),
      testAdhanBtn: document.getElementById('test-adhan-btn'),

      btnMinus: document.getElementById('btn-minus-cor'),
      btnPlus: document.getElementById('btn-plus-cor'),
      inputCor: document.getElementById('input-correction'),

      qiblaBtn: document.getElementById('qibla-compass-btn'),
      qiblaModal: document.getElementById('qibla-modal'),
      closeQibla: document.getElementById('close-qibla-btn'),
      disc: document.getElementById('qibla-compass-disc'),
      arrowCont: document.getElementById('qibla-arrow-container'),
      qiblaText: document.getElementById('qibla-direction-text'),
      qiblaDegModal: document.getElementById('qibla-degree-modal'),
      previewNeedle: document.getElementById('qibla-preview-needle'),
      iosBtn: document.getElementById('ios-permission-btn'),

      toast: document.getElementById('toast')
    };

    const PRAYER_ORDER = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
    const PRAYER_NAMES = { Fajr:'Subuh', Dhuhr:'Dzuhur', Asr:'Ashar', Maghrib:'Maghrib', Isha:'Isya' };
    const BULAN_INDO = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const HARI_INDO = ['Ahad','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];

    let state = {
      lat: -6.2088,
      lng: 106.8456,
      city: 'Jakarta',
      method: 20,
      useGPS: true,
      adhan: false,
      remind: false,
      adhanVolume: 70,
      qiblaAngle: 0,
      correction: 2
    };

    let countdownInterval = null;
    let adzanAudioCtx = null;
    let isAdzanPlaying = false;

    // ------ WEB AUDIO API ADZAN PLAYER ------
    const getAudioCtx = () => {
      if (!adzanAudioCtx) {
        adzanAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (adzanAudioCtx.state === 'suspended') {
        adzanAudioCtx.resume();
      }
      return adzanAudioCtx;
    };

    /**
     * Memainkan suara adzan menggunakan Web Audio API.
     * Menghasilkan melodi "Allahu Akbar" 4 nada naik, diulang 2x.
     */
    const playAdzan = (volume = 0.7) => {
      if (isAdzanPlaying) return;
      isAdzanPlaying = true;

      try {
        const ctx = getAudioCtx();
        const now = ctx.currentTime;
        const vol = Math.min(Math.max(volume, 0), 1);
        const totalDuration = 2 * (4 * (0.35 + 0.05) + 0.4); // ~3.6s

        // "Allahu Akbar" melodic pattern (2 repetitions)
        // 4 ascending notes: C4 -> E4 -> G4 -> C5
        const notes = [261.63, 329.63, 392.00, 523.25];
        const noteDuration = 0.35;
        const gap = 0.05;
        const phraseGap = 0.4;
        const repetitions = 2;

        for (let rep = 0; rep < repetitions; rep++) {
          const phraseStart = now + rep * (notes.length * (noteDuration + gap) + phraseGap);

          notes.forEach((freq, i) => {
            const start = phraseStart + i * (noteDuration + gap);
            const end = start + noteDuration;

            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, start);

            gain.gain.setValueAtTime(0, start);
            gain.gain.linearRampToValueAtTime(vol * 0.3, start + 0.02);
            gain.gain.setValueAtTime(vol * 0.3, end - 0.05);
            gain.gain.exponentialRampToValueAtTime(0.001, end);

            osc.connect(gain).connect(ctx.destination);
            osc.start(start);
            osc.stop(end);
          });
        }

        // Reset guard after playback finishes
        setTimeout(() => { isAdzanPlaying = false; }, (totalDuration + 0.5) * 1000);
      } catch (e) {
        isAdzanPlaying = false;
        console.warn('Adzan audio failed:', e);
      }
    };

    const showToast = (msg) => {
      els.toast.innerText = msg;
      els.toast.classList.remove('opacity-0', 'translate-y-10');
      setTimeout(() => els.toast.classList.add('opacity-0', 'translate-y-10'), 2500);
    };

    const addMinutes = (timeStr, minutesToAdd) => {
      const [h, m] = timeStr.split(':').map(Number);
      const date = new Date();
      date.setHours(h, m + minutesToAdd, 0);
      return `${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;
    };

    const addMinutesToStr = (timeStr, mins) => {
      const [h, m] = timeStr.split(':').map(Number);
      let total = h * 60 + m + mins;
      const nh = ((total % 1440) + 1440) % 1440;
      return `${Math.floor(nh / 60).toString().padStart(2, '0')}:${(nh % 60).toString().padStart(2, '0')}`;
    };

    const getPDate = (timeStr) => {
      const [h, m] = timeStr.split(':').map(Number);
      const d = new Date();
      d.setHours(h, m, 0, 0);
      return d;
    };

    const getCacheKey = (lat, lng) => {
      const d = new Date();
      const dateStr = `${d.getDate()}-${d.getMonth() + 1}-${d.getFullYear()}`;
      return `sholat-cache-${dateStr}-${lat.toFixed(4)}-${lng.toFixed(4)}-${state.method}-${state.correction}`;
    };

    const loadCachedData = (cacheKey) => {
      try {
        const cached = localStorage.getItem(cacheKey);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (parsed.date === new Date().toDateString()) {
            return parsed;
          }
        }
      } catch (e) { /* ignore corrupt cache */ }
      return null;
    };

    const saveToCache = (cacheKey, data) => {
      try {
        localStorage.setItem(cacheKey, JSON.stringify({
          date: new Date().toDateString(),
          timestamp: Date.now(),
          data: data
        }));
      } catch (e) { /* quota exceeded */ }
    };

    // ------ FIND NEXT & CURRENT PRAYER ------
    const findNextPrayer = (timings) => {
      const now = new Date();
      for (let k of PRAYER_ORDER) {
        const t = getPDate(timings[k]);
        if (t > now) return { key: k, time: t, isTomorrow: false };
      }
      // All passed → next is Fajr tomorrow
      const t = getPDate(timings['Fajr']);
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      tomorrow.setHours(t.getHours(), t.getMinutes(), 0, 0);
      return { key: 'Fajr', time: tomorrow, isTomorrow: true };
    };

    const findCurrentPrayer = (timings) => {
      const now = new Date();
      for (let i = PRAYER_ORDER.length - 1; i >= 0; i--) {
        const k = PRAYER_ORDER[i];
        const t = getPDate(timings[k]);
        if (now >= t) return k;
      }
      return PRAYER_ORDER[PRAYER_ORDER.length - 1]; // Isya (last night's)
    };

    const getNextPrayerTime = (timings, key) => {
      const idx = PRAYER_ORDER.indexOf(key);
      if (idx < PRAYER_ORDER.length - 1) {
        return getPDate(timings[PRAYER_ORDER[idx + 1]]);
      }
      // After Isya → next is Fajr tomorrow
      const t = getPDate(timings['Fajr']);
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      tomorrow.setHours(t.getHours(), t.getMinutes(), 0, 0);
      return tomorrow;
    };

    // ------ FETCH PRAYER DATA ------
    const fetchPrayer = async (lat, lng) => {
      try { calcQibla(lat, lng); } catch (e) { /* silent */ }

      const cacheKey = getCacheKey(lat, lng);
      const cached = loadCachedData(cacheKey);
      if (cached) {
        renderWithTimings(cached.data.timings, cached.data);
      }

      try {
        const d = new Date();
        const dateStr = `${d.getDate()}-${d.getMonth() + 1}-${d.getFullYear()}`;
        const url = `https://api.aladhan.com/v1/timings/${dateStr}?latitude=${lat}&longitude=${lng}&method=${state.method}`;

        // Timeout guard: abort if API takes >8s
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 8000);

        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(timeoutId);
        const json = await res.json();

        if (json.code === 200) {
          const rawTimings = json.data.timings;
          const correctedTimings = {};

          Object.keys(rawTimings).forEach(key => {
            if (['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha', 'Imsak', 'Sunrise'].includes(key)) {
              correctedTimings[key] = addMinutes(rawTimings[key], state.correction);
            } else {
              correctedTimings[key] = rawTimings[key];
            }
          });

          const sunrise = correctedTimings.Sunrise;
          correctedTimings.Dhuha = addMinutesToStr(sunrise, 20);

          json.data.timings = correctedTimings;
          saveToCache(cacheKey, { ...json.data, timings: correctedTimings });

          renderWithTimings(correctedTimings, json.data);
          els.corDisplay.innerText = state.correction > 0 ? `+${state.correction}` : state.correction;
          els.locText.innerText = state.city || "Online";
        } else {
          if (!cached) {
            els.locText.innerText = "Error API";
            showToast("Gagal mengambil data sholat.");
          }
        }
      } catch (e) {
        console.error(e);
        if (!cached) {
          els.locText.innerText = "Offline";
          showToast("Anda sedang offline. Menampilkan data terakhir.");
        }
      }
    };

    // ------ RENDER ------
    const renderWithTimings = (timings, data) => {
      if (!timings) return;

      // Date info
      if (data && data.date) {
        const hijri = data.date.hijri;
        els.hijri.innerText = `${hijri.day} ${hijri.month.en} ${hijri.year} H`;

        const greg = data.date.gregorian;
        const d = new Date();
        const dayName = HARI_INDO[d.getDay()];
        const monthName = BULAN_INDO[d.getMonth()];
        els.gregorian.innerText = `${dayName}, ${d.getDate()} ${monthName} ${d.getFullYear()}`;
      }

      // Imsak
      if (timings.Imsak) {
        els.imsakCont.classList.remove('hidden');
        els.imsakTime.innerText = timings.Imsak;
      }

      // Sunrise & Dhuha
      if (timings.Sunrise) {
        els.sunriseCont.classList.remove('hidden');
        els.sunriseTime.innerText = timings.Sunrise;
      }
      if (timings.Dhuha) {
        els.dhuhaCont.classList.remove('hidden');
        els.dhuhaTime.innerText = timings.Dhuha;
      }

      const next = findNextPrayer(timings);
      const currentKey = findCurrentPrayer(timings);

      els.nextName.innerText = PRAYER_NAMES[next.key];

      // Besok badge
      if (next.isTomorrow) {
        els.besokBadge.classList.remove('hidden');
      } else {
        els.besokBadge.classList.add('hidden');
      }

      // Render list
      let html = '';
      PRAYER_ORDER.forEach(k => {
        const isActive = k === next.key && !next.isTomorrow;
        html += `
          <div class="flex items-center justify-between p-4 rounded-2xl transition-all duration-300 border ${
            isActive
              ? 'bg-emerald-500 text-white shadow-lg border-emerald-500 scale-[1.02]'
              : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-slate-100 dark:border-slate-700 hover:border-emerald-200 dark:hover:border-emerald-700 hover:shadow-sm'
          }">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full ${isActive ? 'bg-white animate-pulse' : 'bg-emerald-500'}"></div>
              <span class="font-bold text-sm">${PRAYER_NAMES[k]}</span>
            </div>
            <span class="font-mono font-bold text-lg">${timings[k]}</span>
          </div>
        `;
      });
      els.list.innerHTML = html;

      startTimer(timings);
    };

    // ------ COUNTDOWN TIMER + PROGRESS ------
    const startTimer = (timings) => {
      if (countdownInterval) clearInterval(countdownInterval);

      const update = () => {
        const now = new Date();
        const next = findNextPrayer(timings);
        const diff = next.time - now;

        if (diff <= 0) {
          els.count.innerText = '00:00:00';
          els.countLabel.innerText = 'Sekarang!';
          return;
        }

        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        els.count.innerText = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        els.countLabel.innerText = 'Tersisa';

        // Progress bar: elapsed time in current prayer window
        // Only show when next prayer is today (not in nighttime gap)
        if (!next.isTomorrow) {
          const currentKey = findCurrentPrayer(timings);
          const prayerStart = getPDate(timings[currentKey]);
          const prayerEnd = getNextPrayerTime(timings, currentKey);
          const totalDur = prayerEnd - prayerStart;
          const elapsed = now - prayerStart;

          if (totalDur > 0 && elapsed > 0 && elapsed < totalDur) {
            const pct = Math.min((elapsed / totalDur) * 100, 100);
            els.progressCont.classList.remove('hidden');
            els.progressBar.style.width = `${pct}%`;
            els.progressPct.innerText = `${Math.round(pct)}%`;
            els.progressLabel.innerText = `Waktu ${PRAYER_NAMES[currentKey]}`;
          } else {
            els.progressCont.classList.add('hidden');
          }
        } else {
          els.progressCont.classList.add('hidden');
        }

        // Notifications (persisted via localStorage to survive refresh)
        const today = new Date().toDateString();
        const notifiedKey = `${today}-${next.key}`;

        if (diff < 1000 && state.adhan) {
          try {
            const done = JSON.parse(localStorage.getItem('sholat-notified-adhan') || '{}');
            if (!done[notifiedKey]) {
              notify(`Waktu sholat ${PRAYER_NAMES[next.key]} telah tiba!`, 'Adzan');
              playAdzan(state.adhanVolume / 100);
              done[notifiedKey] = true;
              localStorage.setItem('sholat-notified-adhan', JSON.stringify(done));
            }
          } catch (e) {}
        }

        if (diff <= 600000 && diff > 595000 && state.remind) {
          try {
            const done = JSON.parse(localStorage.getItem('sholat-notified-remind') || '{}');
            if (!done[notifiedKey]) {
              notify(`10 Menit menuju waktu sholat ${PRAYER_NAMES[next.key]}`, 'Pengingat');
              done[notifiedKey] = true;
              localStorage.setItem('sholat-notified-remind', JSON.stringify(done));
            }
          } catch (e) {}
        }
      };

      update();
      countdownInterval = setInterval(update, 1000);
    };

    // ------ GPS ------
    const getGPS = (retries = 1) => {
      els.locText.innerText = "Melacak...";
      els.refreshIcon.classList.add('animate-spin');

      // Fire prayer API with default coords IMMEDIATELY, update when GPS arrives
      fetchPrayer(state.lat, state.lng);

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          state.lat = pos.coords.latitude;
          state.lng = pos.coords.longitude;
          els.latIn.value = state.lat.toFixed(5);
          els.lngIn.value = state.lng.toFixed(5);

          // Update prayer times with GPS coords
          fetchPrayer(state.lat, state.lng);

          // Fire & forget: Nominatim reverse geocode (don't block anything)
          fetch(`https://nominatim.openstreetmap.org/reverse?lat=${state.lat}&lon=${state.lng}&format=json`)
            .then(r => r.json())
            .then(data => {
              const city = data.address.city || data.address.town || data.address.county || "GPS Akurat";
              state.city = city;
              els.locText.innerText = city;
            })
            .catch(() => {
              els.locText.innerText = "Sesuai GPS";
            });

          els.refreshIcon.classList.remove('animate-spin');
        },
        (err) => {
          if (retries > 0) {
            setTimeout(() => getGPS(retries - 1), 2000);
          } else {
            showToast("Gagal ambil GPS. Memakai lokasi default.");
            els.locText.innerText = state.city;
            els.refreshIcon.classList.remove('animate-spin');
            // fetchPrayer already fired above with default coords
          }
        },
        { timeout: 5000, enableHighAccuracy: false }
      );
    };

    // ------ QIBLA ------
    const calcQibla = (lat, lng) => {
      const kaabaLat = 21.4225;
      const kaabaLng = 39.8262;

      const φ1 = lat * Math.PI / 180;
      const φ2 = kaabaLat * Math.PI / 180;
      const Δλ = (kaabaLng - lng) * Math.PI / 180;

      const x = Math.sin(Δλ) * Math.cos(φ2);
      const y = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ);

      let q = Math.atan2(x, y) * 180 / Math.PI;
      state.qiblaAngle = (q + 360) % 360;

      els.qiblaText.innerText = `${state.qiblaAngle.toFixed(1)}°`;
      els.qiblaDegModal.innerText = `${state.qiblaAngle.toFixed(1)}°`;
      els.previewNeedle.style.transform = `rotate(${state.qiblaAngle}deg)`;
    };

    const handleCompass = (e) => {
      let compass;
      if (e.webkitCompassHeading !== undefined && e.webkitCompassHeading !== null) {
        compass = e.webkitCompassHeading;
      } else if (e.alpha !== null) {
        compass = 360 - e.alpha;
      } else {
        return;
      }
      els.disc.style.transform = `rotate(${-compass}deg)`;
      els.arrowCont.style.transform = `rotate(${-compass + state.qiblaAngle}deg)`;
    };

    const startCompass = () => {
      if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
        els.iosBtn.classList.remove('hidden');
        els.iosBtn.onclick = () => {
          DeviceOrientationEvent.requestPermission()
            .then(resp => {
              if (resp === 'granted') {
                els.iosBtn.classList.add('hidden');
                window.addEventListener('deviceorientation', handleCompass, true);
              } else {
                showToast("Izin kompas ditolak.");
              }
            })
            .catch(console.error);
        };
      } else {
        if ('ondeviceorientationabsolute' in window) {
          window.addEventListener('deviceorientationabsolute', handleCompass, true);
        } else {
          window.addEventListener('deviceorientation', handleCompass, true);
        }
      }
    };

    const stopCompass = () => {
      window.removeEventListener('deviceorientation', handleCompass, true);
      window.removeEventListener('deviceorientationabsolute', handleCompass, true);
    };

    // ------ NOTIFICATIONS ------
    const notify = (msg, tag) => {
      if (Notification.permission === 'granted') {
        new Notification("Qolbu App", { body: msg, tag: tag, icon: '/logo.png' });
      }
    };

    const reqNotify = () => {
      if ('Notification' in window && Notification.permission !== 'granted') {
        Notification.requestPermission();
      }
    };

    // ------ SETTINGS ------
    const loadSettings = () => {
      const s = JSON.parse(localStorage.getItem('sholat-settings') || '{}');
      if (s.lat) {
        state = { ...state, ...s };
        els.useGPS.checked = state.useGPS;
        els.latIn.value = state.lat;
        els.lngIn.value = state.lng;
        els.cityIn.value = state.city;
        els.method.value = state.method;
        els.adhan.checked = state.adhan;
        els.remind.checked = state.remind;
        els.volumeSlider.value = state.adhanVolume;
        els.volumeValue.innerText = `${state.adhanVolume}%`;
        els.inputCor.innerText = state.correction;

        if (!state.useGPS) els.manualBox.classList.remove('hidden');
      }
    };

    const clearPrayerCache = () => {
      const keys = Object.keys(localStorage);
      keys.forEach(k => {
        if (k.startsWith('sholat-cache-')) localStorage.removeItem(k);
      });
    };

    const saveSettings = () => {
      state.useGPS = els.useGPS.checked;
      state.method = els.method.value;
      state.adhan = els.adhan.checked;
      state.remind = els.remind.checked;
      state.adhanVolume = parseInt(els.volumeSlider.value);
      state.correction = parseInt(els.inputCor.innerText);

      if (!state.useGPS) {
        state.lat = parseFloat(els.latIn.value) || -6.2;
        state.lng = parseFloat(els.lngIn.value) || 106.8;
        state.city = els.cityIn.value || 'Manual';
      }

      localStorage.setItem('sholat-settings', JSON.stringify(state));
      clearPrayerCache();

      if (state.adhan || state.remind) reqNotify();
      showToast("Pengaturan disimpan.");
      init();
    };

    const tryLoadCacheImmediately = () => {
      // Show cached data RIGHT NOW, before any GPS/API calls
      const cacheKey = getCacheKey(state.lat, state.lng);
      const cached = loadCachedData(cacheKey);
      if (cached) {
        renderWithTimings(cached.data.timings, cached.data);
        return true;
      }
      return false;
    };

    const init = () => {
      loadSettings();
      // Show cached data instantly if available
      tryLoadCacheImmediately();

      if (state.useGPS) {
        getGPS();
      } else {
        els.locText.innerText = state.city || "Manual";
        fetchPrayer(state.lat, state.lng);
      }
    };

    // ------ EVENT LISTENERS ------
    els.refresh.addEventListener('click', () => {
      localStorage.removeItem('sholat-data');
      getGPS();
    });

    els.settingsBtn.addEventListener('click', () => els.settingsModal.classList.remove('hidden'));
    els.closeSet.addEventListener('click', () => els.settingsModal.classList.add('hidden'));
    els.settingsOverlay.addEventListener('click', () => els.settingsModal.classList.add('hidden'));

    els.useGPS.addEventListener('change', (e) => {
      if (e.target.checked) els.manualBox.classList.add('hidden');
      else els.manualBox.classList.remove('hidden');
    });

    els.saveSet.addEventListener('click', () => {
      saveSettings();
      els.settingsModal.classList.add('hidden');
    });

    // Test Adzan button
    els.testAdhanBtn.addEventListener('click', () => {
      const vol = parseInt(els.volumeSlider.value) / 100;
      playAdzan(vol);
    });

    // Volume slider
    els.volumeSlider.addEventListener('input', () => {
      els.volumeValue.innerText = `${els.volumeSlider.value}%`;
    });

    els.btnMinus.addEventListener('click', () => {
      let val = parseInt(els.inputCor.innerText);
      if (val > 0) els.inputCor.innerText = val - 1;
    });
    els.btnPlus.addEventListener('click', () => {
      let val = parseInt(els.inputCor.innerText);
      els.inputCor.innerText = val + 1;
    });

    els.qiblaBtn.addEventListener('click', () => {
      els.qiblaModal.classList.remove('hidden');
      startCompass();
    });
    els.closeQibla.addEventListener('click', () => {
      els.qiblaModal.classList.add('hidden');
      stopCompass();
    });

    init();
  }
</script>

<style>
  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .animate-pulse-slow { animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
</style>