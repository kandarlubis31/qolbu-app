      Jadwal ditambah <strong id="correction-display">0</strong> menit (Ihtiyat)
    </div>
    <button class="btn-refresh" id="btn-refresh-loc">
      <svg class="refresh-ic" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
