---
import BaseLayout from '../layouts/BaseLayout.astro';
import Toast from '../components/Toast.astro';
import Skeleton from '../components/Skeleton.astro';
---

<BaseLayout pageTitle="Jadwal Sholat & Kiblat">
  <div
    class="sticky top-16 z-30 flex items-center justify-between border-b border-slate-100 bg-white px-4 py-3 shadow-sm transition-colors md:bg-white/90 md:backdrop-blur-md dark:border-slate-800 dark:bg-slate-900 md:dark:bg-slate-900/90"
  >
    <a
      href="/"
      class="-ml-2 flex items-center gap-2 rounded-lg p-2 text-slate-500 transition-colors hover:text-emerald-600 active:bg-slate-50 dark:active:bg-slate-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
      >
      <span class="text-sm font-medium">Dashboard</span>
    </a>

    <div class="flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 dark:bg-slate-800">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-emerald-500"
        ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle
          cx="12"
          cy="10"
          r="3"></circle></svg
      >
      <span
        id="location-text"
        class="max-w-[120px] truncate text-xs font-bold text-slate-600 dark:text-slate-300"
        >Mencari...</span
      >
    </div>

    <button
      id="settings-btn"
      class="rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 active:scale-95 dark:hover:bg-slate-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="3"></circle><path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
        ></path></svg
      >
    </button>
  </div>

  <div class="mx-auto w-full max-w-md px-4 pt-6 pb-24">
    <div
      class="relative mb-6 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-6 text-white shadow-xl shadow-emerald-500/20"
    >
      <div class="absolute top-0 right-0 translate-x-4 -translate-y-4 transform opacity-10">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
          ></path></svg
        >
      </div>

      <div class="relative z-10 text-center">
        <p class="mb-1 text-xs font-medium tracking-widest text-emerald-100 uppercase">
          Menuju Waktu
        </p>
        <h2 id="next-prayer-name" class="mb-2 text-2xl font-bold">Memuat...</h2>

        <div
          class="inline-block min-w-[140px] rounded-xl border border-white/10 bg-white/20 p-3 shadow-inner md:backdrop-blur-md"
        >
          <h1 id="countdown" class="text-4xl font-black tracking-tight tabular-nums">--:--:--</h1>
        </div>

        <div class="mt-4 flex flex-col gap-0.5">
          <p id="gregorian-date" class="text-xs font-bold text-white">...</p>
          <p id="hijri-date" class="text-[10px] text-emerald-200">...</p>
        </div>
      </div>
    </div>

    <div
      class="mb-6 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"
    >
      <div class="mb-4 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Arah Kiblat</h3>
          <p class="text-[10px] text-slate-500">Akurasi bergantung sensor HP</p>
        </div>
        <button
          id="qibla-compass-btn"
          class="flex items-center gap-1.5 rounded-lg bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-600 transition-colors hover:bg-emerald-100 active:scale-95 dark:bg-emerald-900/20 dark:text-emerald-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><path d="m16.2 7.8-2.4 2.4"></path><path
              d="m14.1 11.9-2.1 2.1"></path><path d="m11 15-3 3"></path></svg
          >
          Buka Kompas
        </button>
      </div>

      <div class="flex items-center gap-4">
        <div class="relative h-12 w-12 flex-shrink-0">
          <div
            class="absolute inset-0 rounded-full border-2 border-slate-200 dark:border-slate-600"
          >
          </div>
          <div
            id="qibla-preview-needle"
            class="absolute inset-0 flex items-center justify-center transition-transform duration-[800ms] ease-out"
          >
            <div class="relative h-8 w-1 rounded-full bg-emerald-500">
              <div
                class="absolute -top-1 left-1/2 h-2 w-2 -translate-x-1/2 rotate-45 bg-emerald-500"
              >
              </div>
            </div>
          </div>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Sudut dari Utara:</p>
          <p id="qibla-direction-text" class="text-xl font-bold text-slate-800 dark:text-white">
            ...
          </p>
        </div>
      </div>
    </div>

    <div id="imsak-container" class="mb-3 hidden">
      <div
        class="flex items-center justify-between rounded-xl border border-dashed border-slate-100 bg-slate-50 p-3.5 dark:border-slate-700/50 dark:bg-slate-800/50"
      >
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-amber-500"
            ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
            ></polyline></svg
          >
          <span class="text-sm font-bold text-slate-600 dark:text-slate-300">Imsak</span>
        </div>
        <span id="imsak-time" class="font-mono text-sm font-bold text-slate-600 dark:text-slate-300"
          >--:--</span
        >
      </div>
    </div>

    <div id="prayer-list" class="space-y-3">
      <Skeleton variant="prayer" count={5} />
    </div>

    <div class="mt-6 text-center">
      <p
        class="inline-block rounded-full bg-slate-100 px-4 py-2 text-[10px] text-slate-400 dark:bg-slate-800"
      >
        <span class="font-bold text-emerald-500">Info:</span> Waktu sudah ditambah <span
          id="correction-display">2</span
        > menit (Ihtiyat).
      </p>
    </div>

    <div class="mt-4 text-center">
      <button
        id="refresh-loc-btn"
        class="inline-flex items-center gap-2 rounded-full border border-slate-100 bg-white px-5 py-2.5 text-xs font-bold text-emerald-600 shadow-md transition-all hover:shadow-lg active:scale-95 dark:border-slate-700 dark:bg-slate-800 dark:text-emerald-400"
      >
        <svg
          id="refresh-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle
            cx="12"
            cy="10"
            r="3"></circle></svg
        >
        <span>Update Lokasi GPS</span>
      </button>
    </div>
  </div>

  <div id="settings-modal" class="fixed inset-0 z-[100] hidden" aria-hidden="true">
    <div
      class="absolute inset-0 bg-black/60 transition-opacity md:backdrop-blur-sm"
      id="settings-overlay"
    >
    </div>
    <div
      class="animate-slide-up absolute bottom-0 left-0 max-h-[85vh] w-full overflow-y-auto rounded-t-3xl bg-white p-6 shadow-2xl dark:bg-slate-900"
    >
      <div class="mb-6 flex items-center justify-between">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Pengaturan Sholat</h3>
        <button
          id="close-settings-btn"
          class="rounded-full bg-slate-100 p-2 text-slate-500 transition-colors hover:text-slate-800 dark:bg-slate-800 dark:hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
            ></line></svg
          >
        </button>
      </div>

      <div class="space-y-6">
        <div
          class="rounded-xl border border-amber-100 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-900/20"
        >
          <h4
            class="mb-2 text-xs font-bold tracking-wider text-amber-600 uppercase dark:text-amber-400"
          >
            Koreksi Waktu (Ihtiyat)
          </h4>
          <p class="mb-3 text-[10px] text-slate-500 dark:text-slate-400">
            Tambahkan menit agar sesuai jadwal resmi masjid. Default aman: <strong>+2 Menit</strong
            >.
          </p>
          <div class="flex items-center gap-3">
            <button
              id="btn-minus-cor"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-lg font-bold transition-all hover:bg-slate-50 active:scale-95 dark:border-slate-700 dark:bg-slate-800"
              >-</button
            >
            <div
              class="flex h-10 flex-1 items-center justify-center rounded-lg border border-slate-200 bg-white text-center font-mono font-bold dark:border-slate-700 dark:bg-slate-800"
              id="input-correction"
            >
              2
            </div>
            <button
              id="btn-plus-cor"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-lg font-bold transition-all hover:bg-slate-50 active:scale-95 dark:border-slate-700 dark:bg-slate-800"
              >+</button
            >
          </div>
        </div>

        <div>
          <h4 class="mb-3 text-xs font-bold tracking-wider text-slate-500 uppercase">Lokasi</h4>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-slate-700 dark:text-slate-300"
                >Gunakan GPS Otomatis</span
              >
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" id="use-current-location" class="peer sr-only" checked />
                <div
                  class="peer h-6 w-11 rounded-full bg-slate-200 peer-checked:bg-emerald-500 peer-focus:outline-none after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-700"
                >
                </div>
              </label>
            </div>

            <div
              id="manual-location"
              class="hidden space-y-3 rounded-xl border border-slate-100 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/50"
            >
              <p class="text-xs text-slate-500">Masukkan koordinat manual:</p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="text-[10px] text-slate-400">Latitude</label>
                  <input
                    type="number"
                    id="lat-input"
                    placeholder="-6.2000"
                    step="any"
                    class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-500 dark:border-slate-600 dark:bg-slate-800"
                  />
                </div>
                <div>
                  <label class="text-[10px] text-slate-400">Longitude</label>
                  <input
                    type="number"
                    id="lng-input"
                    placeholder="106.8000"
                    step="any"
                    class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-500 dark:border-slate-600 dark:bg-slate-800"
                  />
                </div>
              </div>
              <div>
                <label class="text-[10px] text-slate-400">Nama Kota (Opsional)</label>
                <input
                  type="text"
                  id="city-input"
                  placeholder="Contoh: Jakarta"
                  class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-500 dark:border-slate-600 dark:bg-slate-800"
                />
              </div>
            </div>
          </div>
        </div>

        <hr class="border-slate-100 dark:border-slate-800" />

        <div>
          <h4 class="mb-3 text-xs font-bold tracking-wider text-slate-500 uppercase">
            Metode Perhitungan
          </h4>
          <select
            id="calc-method"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
          >
            <option value="20">Kemenag RI (Indonesia)</option>
            <option value="11">MUIS (Singapura)</option>
            <option value="3">Muslim World League</option>
            <option value="2">ISNA (North America)</option>
            <option value="4">Umm Al-Qura (Makkah)</option>
            <option value="5">Egyptian General Authority</option>
          </select>
        </div>

        <hr class="border-slate-100 dark:border-slate-800" />

        <div>
          <h4 class="mb-3 text-xs font-bold tracking-wider text-slate-500 uppercase">Notifikasi</h4>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Suara Adzan</span
              >
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" id="adhan-notification" class="peer sr-only" />
                <div
                  class="peer h-6 w-11 rounded-full bg-slate-200 peer-checked:bg-emerald-500 peer-focus:outline-none after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-700"
                >
                </div>
              </label>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-slate-700 dark:text-slate-300"
                >Pengingat (10 Menit Sebelum)</span
              >
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" id="reminder-notification" class="peer sr-only" />
                <div
                  class="peer h-6 w-11 rounded-full bg-slate-200 peer-checked:bg-emerald-500 peer-focus:outline-none after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-700"
                >
                </div>
              </label>
            </div>
          </div>
          <p class="mt-2 text-[10px] text-amber-500 italic">
            *Izin notifikasi akan diminta saat disimpan.
          </p>
        </div>

        <button
          id="save-settings-btn"
          class="w-full rounded-xl bg-emerald-600 py-3 font-bold text-white shadow-lg shadow-emerald-500/30 transition-colors hover:bg-emerald-700 active:scale-95"
        >
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <div id="qibla-modal" class="fixed inset-0 z-[100] hidden bg-slate-900 text-white">
    <div class="absolute top-4 right-4 z-20">
      <button
        id="close-qibla-btn"
        class="rounded-full bg-slate-800 p-2 text-slate-300 transition-colors hover:bg-slate-700"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
          ></line></svg
        >
      </button>
    </div>

    <div class="relative flex h-full flex-col items-center justify-center px-6">
      <div class="relative mb-10 h-72 w-72">
        <div
          class="absolute inset-0 flex items-center justify-center rounded-full border-4 border-slate-700"
        >
          <span class="absolute -top-8 font-bold text-emerald-500">Utara</span>
        </div>

        <div id="qibla-compass-disc" class="absolute inset-0 will-change-transform">
          <div
            class="relative h-full w-full rounded-full border border-slate-700/50 bg-slate-800/50"
          >
            <div class="absolute top-2 left-1/2 h-3 w-1 -translate-x-1/2 bg-red-500"></div>
            <div class="absolute bottom-2 left-1/2 h-3 w-1 -translate-x-1/2 bg-slate-600"></div>
            <div class="absolute top-1/2 left-2 h-1 w-3 -translate-y-1/2 bg-slate-600"></div>
            <div class="absolute top-1/2 right-2 h-1 w-3 -translate-y-1/2 bg-slate-600"></div>
          </div>
        </div>

        <div
          id="qibla-arrow-container"
          class="absolute inset-0 z-10 flex items-center justify-center"
        >
          <div class="animate-pulse-slow relative h-16 w-16">
            <div
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl drop-shadow-[0_0_15px_rgba(16,185,129,0.5)]"
            >
              🕋
            </div>
          </div>
          <div class="absolute -top-10 h-32 w-1 bg-transparent">
            <div
              class="mx-auto h-1/2 w-full rounded-full bg-gradient-to-t from-emerald-500 to-transparent"
            >
            </div>
          </div>
        </div>
      </div>

      <div class="z-10 space-y-2 text-center">
        <h2 class="text-2xl font-bold">Cari Arah Kiblat</h2>
        <p class="mx-auto max-w-xs text-sm text-slate-400">
          Putar HP Anda mendatar sampai ikon Ka'bah lurus dengan panah hijau.
        </p>
        <div class="mt-4 inline-block rounded-xl border border-slate-700 bg-slate-800 p-3">
          <p class="text-xs text-slate-400">Derajat Kiblat</p>
          <p id="qibla-degree-modal" class="text-xl font-bold text-emerald-400">...°</p>
        </div>
      </div>

      <button
        id="ios-permission-btn"
        class="mt-6 hidden rounded-full bg-emerald-600 px-6 py-3 font-bold shadow-lg transition-colors hover:bg-emerald-700 active:scale-95"
      >
        Izinkan Akses Kompas
      </button>
    </div>
  </div>

  <Toast />
</BaseLayout>

<script is:inline>
  (() => {
    const initSholat = () => {
      if (window._sholatInitialized) return;
      const els = {
        locText: document.getElementById('location-text'),
        list: document.getElementById('prayer-list'),
        imsakCont: document.getElementById('imsak-container'),
        imsakTime: document.getElementById('imsak-time'),
        nextName: document.getElementById('next-prayer-name'),
        count: document.getElementById('countdown'),
        hijri: document.getElementById('hijri-date'),
        gregorian: document.getElementById('gregorian-date'),
        refresh: document.getElementById('refresh-loc-btn'),
        refreshIcon: document.getElementById('refresh-icon'),
        corDisplay: document.getElementById('correction-display'),

        settingsBtn: document.getElementById('settings-btn'),
        settingsModal: document.getElementById('settings-modal'),
        closeSet: document.getElementById('close-settings-btn'),
        saveSet: document.getElementById('save-settings-btn'),
        settingsOverlay: document.getElementById('settings-overlay'),

        useGPS: document.getElementById('use-current-location'),
        manualBox: document.getElementById('manual-location'),
        latIn: document.getElementById('lat-input'),
        lngIn: document.getElementById('lng-input'),
        cityIn: document.getElementById('city-input'),
        method: document.getElementById('calc-method'),
        adhan: document.getElementById('adhan-notification'),
        remind: document.getElementById('reminder-notification'),

        btnMinus: document.getElementById('btn-minus-cor'),
        btnPlus: document.getElementById('btn-plus-cor'),
        inputCor: document.getElementById('input-correction'),

        qiblaBtn: document.getElementById('qibla-compass-btn'),
        qiblaModal: document.getElementById('qibla-modal'),
        closeQibla: document.getElementById('close-qibla-btn'),
        disc: document.getElementById('qibla-compass-disc'),
        arrowCont: document.getElementById('qibla-arrow-container'),
        qiblaText: document.getElementById('qibla-direction-text'),
        qiblaDegModal: document.getElementById('qibla-degree-modal'),
        previewNeedle: document.getElementById('qibla-preview-needle'),
        iosBtn: document.getElementById('ios-permission-btn'),
      };

      if (!els.locText || !els.list || !els.refresh) return;
      window._sholatInitialized = true;

      let state = {
        lat: -6.2088,
        lng: 106.8456,
        city: 'Jakarta',
        method: 20,
        useGPS: true,
        adhan: false,
        remind: false,
        qiblaAngle: 0,
        correction: 2,
      };

      let lastNotifiedAdhan = null;
      let lastNotifiedRemind = null;

      const init = () => {
        loadSettings();
        if (state.useGPS) {
          getGPS();
        } else {
          els.locText.innerText = state.city || 'Manual';
          fetchPrayer(state.lat, state.lng);
        }
      };

      // MODULO AITHMETIC: Mencegah error perhitungan pergantian hari pada jam ekstrim (23:58 + 5 = 00:03)
      const addMinutes = (timeStr, minutesToAdd) => {
        const [h, m] = timeStr.split(':').map(Number);
        let totalMinutes = h * 60 + m + minutesToAdd;
        totalMinutes = ((totalMinutes % 1440) + 1440) % 1440; // Clamping modulo 24 jam

        const resH = Math.floor(totalMinutes / 60)
          .toString()
          .padStart(2, '0');
        const resM = (totalMinutes % 60).toString().padStart(2, '0');
        return `${resH}:${resM}`;
      };

      const getPDate = (timeStr, relativeDate = new Date()) => {
        const [h, m] = timeStr.split(':').map(Number);
        const d = new Date(relativeDate);
        d.setHours(h, m, 0, 0);
        return d;
      };

      const fetchPrayer = async (lat, lng) => {
        try {
          calcQibla(lat, lng);
          const d = new Date();
          const dateStr = `${d.getDate()}-${d.getMonth() + 1}-${d.getFullYear()}`;
          const url = `https://api.aladhan.com/v1/timings/${dateStr}?latitude=${lat}&longitude=${lng}&method=${state.method}`;

          const res = await fetch(url);
          const json = await res.json();

          if (json.code === 200) {
            const rawTimings = json.data.timings;
            const correctedTimings = {};

            Object.keys(rawTimings).forEach((key) => {
              if (['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha', 'Imsak', 'Sunrise'].includes(key)) {
                correctedTimings[key] = addMinutes(rawTimings[key], state.correction);
              } else {
                correctedTimings[key] = rawTimings[key];
              }
            });

            json.data.timings = correctedTimings;
            render(json.data);
            startTimer(correctedTimings);
            els.corDisplay.innerText =
              state.correction > 0 ? `+${state.correction}` : state.correction;

            // Cache untuk dashboard prayer-card & hijri bar — format key WAJIB identik index.astro
            try {
              const now = new Date();
              const dateStr = `${now.getDate()}-${now.getMonth() + 1}-${now.getFullYear()}`;
              localStorage.setItem(
                'sholat-cache-' +
                  dateStr +
                  '-' +
                  Number(lat).toFixed(4) +
                  '-' +
                  Number(lng).toFixed(4) +
                  '-' +
                  state.method +
                  '-' +
                  state.correction,
                JSON.stringify({ date: now.toDateString(), data: json.data })
              );
            } catch {}
          } else {
            els.locText.innerText = 'Error API';
            window.showToast('Gagal mengambil data sholat.');
          }
        } catch (e) {
          console.error(e);
          els.locText.innerText = 'Offline';
          window.showToast('Anda sedang offline atau koneksi terputus.');
        }
      };

      const render = (data) => {
        const hijri = data.date.hijri;
        els.hijri.innerText = `${hijri.day} ${hijri.month.en} ${hijri.year} H`;

        const greg = data.date.gregorian;
        const days = ['Ahad', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
        const dayName = days[new Date().getDay()];
        els.gregorian.innerText = `${dayName}, ${greg.day} ${greg.month.en} ${greg.year}`;

        const timings = data.timings;
        if (timings.Imsak) {
          els.imsakCont.classList.remove('hidden');
          els.imsakTime.innerText = timings.Imsak;
        }

        const names = {
          Fajr: 'Subuh',
          Dhuhr: 'Dzuhur',
          Asr: 'Ashar',
          Maghrib: 'Maghrib',
          Isha: 'Isya',
        };
        const now = new Date();
        let nextKey = null;
        let minDiff = Infinity;

        // LOGIKA KOREKSI SCENARIO POST-MIDNIGHT (00:00 - SEBELUM SUBUH)
        Object.keys(names).forEach((k) => {
          let pTime = getPDate(timings[k]);
          if (pTime < now && k === 'Isha' && now.getHours() < 4) {
            // Jika sekarang dini hari sebelum subuh, Isha hari sebelumnya diabaikan dari status "aktif"
          }
          if (pTime > now) {
            const diff = pTime - now;
            if (diff < minDiff) {
              minDiff = diff;
              nextKey = k;
            }
          }
        });

        let isTomorrow = false;
        if (!nextKey) {
          nextKey = 'Fajr';
          isTomorrow = true;
        }

        els.nextName.innerText = names[nextKey];

        let html = '';
        Object.keys(names).forEach((k) => {
          const isActive = k === nextKey && !isTomorrow;

          html += `
          <div class="flex items-center justify-between p-4 rounded-2xl transition-all border ${
            isActive
              ? 'bg-emerald-500 text-white shadow-lg border-emerald-500 scale-[1.02]'
              : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-slate-100 dark:border-slate-700'
          }">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full ${isActive ? 'bg-white animate-pulse' : 'bg-emerald-500'}"></div>
              <span class="font-bold text-sm">${names[k]}</span>
            </div>
            <span class="font-mono font-bold text-lg">${timings[k]}</span>
          </div>
        `;
        });
        els.list.innerHTML = html;
      };

      const startTimer = (timings) => {
        if (window._sholatInterval) clearInterval(window._sholatInterval);
        const names = {
          Fajr: 'Subuh',
          Dhuhr: 'Dzuhur',
          Asr: 'Ashar',
          Maghrib: 'Maghrib',
          Isha: 'Isya',
        };

        const update = () => {
          // Skip saat tab background — hemat battery, cegah burst timer saat balik fokus
          if (document.hidden) return;
          const now = new Date();
          const ordered = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
          let target = null;
          let targetKey = null;

          for (let k of ordered) {
            const t = getPDate(timings[k]);
            if (t > now) {
              target = t;
              targetKey = k;
              break;
            }
          }

          // PERBAIKAN POST-MIDNIGHT & WRAP: Jika lewat Isya malam ini, targetnya adalah Subuh esok pagi murni (+1 Hari dari data base)
          if (!target) {
            const t = getPDate(timings['Fajr']);
            target = new Date();
            target.setDate(target.getDate() + 1);
            target.setHours(t.getHours(), t.getMinutes(), 0, 0);
            targetKey = 'Fajr';
          }

          const diff = target - now;
          const h = Math.floor(diff / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);

          els.count.innerText = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

          if (diff < 1000 && diff > 0 && state.adhan && lastNotifiedAdhan !== targetKey) {
            notify(`Waktu sholat ${names[targetKey]} telah tiba!`, 'Adzan');
            lastNotifiedAdhan = targetKey;
          }

          if (diff <= 600000 && diff > 599000 && state.remind && lastNotifiedRemind !== targetKey) {
            notify(`10 Menit menuju waktu sholat ${names[targetKey]}`, 'Pengingat');
            lastNotifiedRemind = targetKey;
          }
        };

        update();
        window._sholatInterval = setInterval(update, 1000);
      };

      // Persist koordinat GPS terakhir agar dashboard bisa bangun cache key yang cocok.
      // Merge — tidak menyentuh flag useGPS/pengaturan lain.
      const persistLastLocation = () => {
        try {
          const prev = JSON.parse(localStorage.getItem('sholat-settings') || '{}');
          localStorage.setItem(
            'sholat-settings',
            JSON.stringify({ ...prev, lat: state.lat, lng: state.lng, city: state.city })
          );
        } catch {}
      };

      const getGPS = () => {
        els.locText.innerText = 'Melacak...';
        els.refreshIcon.classList.add('animate-spin');

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            state.lat = pos.coords.latitude;
            state.lng = pos.coords.longitude;

            fetch(
              `https://nominatim.openstreetmap.org/reverse?lat=${state.lat}&lon=${state.lng}&format=json`
            )
              .then((r) => r.json())
              .then((data) => {
                const city =
                  data.address.city || data.address.town || data.address.county || 'GPS Akurat';
                state.city = city;
                els.locText.innerText = city;
                els.latIn.value = state.lat.toFixed(5);
                els.lngIn.value = state.lng.toFixed(5);
                persistLastLocation();
                fetchPrayer(state.lat, state.lng);
                els.refreshIcon.classList.remove('animate-spin');
              })
              .catch(() => {
                state.city = 'Sesuai GPS';
                els.locText.innerText = state.city;
                persistLastLocation();
                fetchPrayer(state.lat, state.lng);
                els.refreshIcon.classList.remove('animate-spin');
              });
          },
          (err) => {
            window.showToast('Gagal ambil GPS. Memakai lokasi terakhir.');
            els.locText.innerText = state.city;
            fetchPrayer(state.lat, state.lng);
            els.refreshIcon.classList.remove('animate-spin');
          },
          { timeout: 10000 }
        );
      };

      const calcQibla = (lat, lng) => {
        const kaabaLat = 21.4225;
        const kaabaLng = 39.8262;

        const φ1 = (lat * Math.PI) / 180;
        const φ2 = (kaabaLat * Math.PI) / 180;
        const Δλ = ((kaabaLng - lng) * Math.PI) / 180;

        const x = Math.sin(Δλ) * Math.cos(φ2);
        const y = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ);

        let q = (Math.atan2(x, y) * 180) / Math.PI;
        state.qiblaAngle = (q + 360) % 360;

        els.qiblaText.innerText = `${state.qiblaAngle.toFixed(1)}°`;
        els.qiblaDegModal.innerText = `${state.qiblaAngle.toFixed(1)}°`;
        els.previewNeedle.style.transform = `rotate(${state.qiblaAngle}deg)`;
      };

      const handleCompass = (e) => {
        let compass = null;
        if (e.webkitCompassHeading !== undefined && e.webkitCompassHeading !== null) {
          compass = e.webkitCompassHeading;
        } else if (e.alpha !== null) {
          compass = 360 - e.alpha;
        }

        if (compass !== null) {
          els.disc.style.transform = `rotate(${-compass}deg)`;
          els.arrowCont.style.transform = `rotate(${-compass + state.qiblaAngle}deg)`;
        }
      };

      // Simpan referensi fungsi ke global window agar bisa dibersihkan secara mutlak oleh Astro Life-cycle
      window._sholatCompass = handleCompass;

      const startCompass = () => {
        if (
          typeof DeviceOrientationEvent !== 'undefined' &&
          typeof DeviceOrientationEvent.requestPermission === 'function'
        ) {
          els.iosBtn.classList.remove('hidden'); // Munculkan tombol untuk memicu User Gesture Activation Apple
          els.iosBtn.onclick = () => {
            DeviceOrientationEvent.requestPermission()
              .then((resp) => {
                if (resp === 'granted') {
                  els.iosBtn.classList.add('hidden');
                  window.addEventListener('deviceorientation', window._sholatCompass, true);
                } else {
                  window.showToast('Izin kompas ditolak.');
                }
              })
              .catch(console.error);
          };
        } else {
          if ('ondeviceorientationabsolute' in window) {
            window.addEventListener('deviceorientationabsolute', window._sholatCompass, true);
          } else {
            window.addEventListener('deviceorientation', window._sholatCompass, true);
          }
        }
      };

      const stopCompass = () => {
        window.removeEventListener('deviceorientation', window._sholatCompass, true);
        window.removeEventListener('deviceorientationabsolute', window._sholatCompass, true);
      };

      const notify = (msg, tag) => {
        if (Notification.permission === 'granted') {
          new Notification('Qolbu App', { body: msg, tag: tag, icon: '/logo.png' });
        }
      };

      const reqNotify = () => {
        if ('Notification' in window && Notification.permission !== 'granted') {
          Notification.requestPermission();
        }
      };

      const loadSettings = () => {
        const s = JSON.parse(localStorage.getItem('sholat-settings') || '{}');
        if (s.lat) {
          state = { ...state, ...s };
          els.useGPS.checked = state.useGPS;
          els.latIn.value = state.lat;
          els.lngIn.value = state.lng;
          els.cityIn.value = state.city;
          els.method.value = state.method;
          els.adhan.checked = state.adhan;
          els.remind.checked = state.remind;
          els.inputCor.innerText = state.correction;

          if (!state.useGPS) els.manualBox.classList.remove('hidden');
        }
      };

      const saveSettings = () => {
        state.useGPS = els.useGPS.checked;
        state.method = els.method.value;
        state.adhan = els.adhan.checked;
        state.remind = els.remind.checked;
        state.correction = parseInt(els.inputCor.innerText);

        if (!state.useGPS) {
          state.lat = parseFloat(els.latIn.value) || -6.2;
          state.lng = parseFloat(els.lngIn.value) || 106.8;
          state.city = els.cityIn.value || 'Manual';
        }

        localStorage.setItem('sholat-settings', JSON.stringify(state));
        window.showToast('Pengaturan disimpan.');
        init();
      };

      els.refresh.addEventListener('click', () => {
        getGPS();
      });

      els.settingsBtn.addEventListener('click', () => els.settingsModal.classList.remove('hidden'));
      els.closeSet.addEventListener('click', () => els.settingsModal.classList.add('hidden'));
      els.settingsOverlay.addEventListener('click', () =>
        els.settingsModal.classList.add('hidden')
      );

      els.useGPS.addEventListener('change', (e) => {
        if (e.target.checked) els.manualBox.classList.add('hidden');
        else els.manualBox.classList.remove('hidden');
      });

      els.saveSet.addEventListener('click', () => {
        saveSettings();
        els.settingsModal.classList.add('hidden');
      });

      els.btnMinus.addEventListener('click', () => {
        let val = parseInt(els.inputCor.innerText);
        els.inputCor.innerText = val - 1;
      });
      els.btnPlus.addEventListener('click', () => {
        let val = parseInt(els.inputCor.innerText);
        els.inputCor.innerText = val + 1;
      });

      els.qiblaBtn.addEventListener('click', () => {
        els.qiblaModal.classList.remove('hidden');
        startCompass();
      });
      els.closeQibla.addEventListener('click', () => {
        els.qiblaModal.classList.add('hidden');
        stopCompass();
      });

      init();
    };

    document.addEventListener('astro:page-load', initSholat);
    document.addEventListener('astro:before-swap', () => {
      window._sholatInitialized = false;
      if (window._sholatInterval) {
        clearInterval(window._sholatInterval);
        window._sholatInterval = null;
      }
      if (window._sholatCompass) {
        window.removeEventListener('deviceorientation', window._sholatCompass, true);
        window.removeEventListener('deviceorientationabsolute', window._sholatCompass, true);
        window._sholatCompass = null;
      }
    });
  })();
</script>

<style>
  .animate-pulse-slow {
    animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
