    <div class="q-badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
      <span id="q-val-fs">--°</span>
    </div>
  </div>

  <button class="btn-ios" id="btn-ios-compass">Aktifkan Sensor Kompas</button>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  // --- ELEMENTS ---
  const els = {
    // Main UI
    locText: document.getElementById('location-text'),
    nextName: document.getElementById('next-prayer-name'),
    count: document.getElementById('countdown'),
    greg: document.getElementById('gregorian-date'),
    hijri: document.getElementById('hijri-date'),
    list: document.getElementById('prayer-list'),
    imsakStrip: document.getElementById('imsak-strip'),
    imsakTime: document.getElementById('imsak-time'),
    btnRefresh: document.getElementById('btn-refresh-loc'),
    corDisplay: document.getElementById('correction-display'),
    refreshIc: document.querySelector('.refresh-ic'),
    toast: document.getElementById('toast'),

    // Qibla Widget
    btnOpenQ: document.getElementById('btn-open-qibla'),
    qNeedleW: document.getElementById('qibla-preview-needle'),
    qValW: document.getElementById('qibla-direction-text'),

    // Settings
    btnOpenSet: document.getElementById('btn-open-settings'),
    btnCloseSet: document.getElementById('btn-close-settings'),
    overlay: document.getElementById('settings-overlay'),
    sheet: document.getElementById('settings-sheet'),
    btnSaveSet: document.getElementById('btn-save-settings'),

    // Setting Inputs
    inMinCor: document.getElementById('btn-min-cor'),
    inPlusCor: document.getElementById('btn-plus-cor'),
    valCor: document.getElementById('val-cor'),
    inpUseGPS: document.getElementById('inp-use-gps'),
    boxManual: document.getElementById('manual-loc-box'),
    inpCity: document.getElementById('inp-city'),
    inpLat: document.getElementById('inp-lat'),
    inpLng: document.getElementById('inp-lng'),
    inpMethod: document.getElementById('inp-method'),

    // Qibla FS
    qFs: document.getElementById('qibla-fs'),
    btnCloseQFs: document.getElementById('btn-close-qibla'),
    qDisc: document.getElementById('q-disc'),
    qArrow: document.getElementById('q-arrow'),
    qValFs: document.getElementById('q-val-fs'),
    btnIos: document.getElementById('btn-ios-compass')
  };

  // --- ICONS ---
  const ICONS = {
    Fajr: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8"/><path d="m4.93 10.93 1.41 1.41"/><path d="M2 18h2"/><path d="M20 18h2"/><path d="m19.07 10.93-1.41 1.41"/><path d="M22 22H2"/><path d="m8 6 4-4 4 4"/><path d="M16 18a4 4 0 0 0-8 0"/></svg>`,
    Dhuhr: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`,
    Asr: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`,
    Maghrib: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8"/><path d="m4.93 10.93 1.41 1.41"/><path d="M2 18h2"/><path d="M20 18h2"/><path d="m19.07 10.93-1.41 1.41"/><path d="M22 22H2"/><path d="m8 6 4-4 4 4"/><path d="M16 18a4 4 0 0 0-8 0"/></svg>`,
    Isha: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`
  };

  const NAMES = { Fajr: 'Subuh', Dhuhr: 'Dzuhur', Asr: 'Ashar', Maghrib: 'Maghrib', Isha: 'Isya' };
  const ARABIC = { Fajr: 'الفجر', Dhuhr: 'الظهر', Asr: 'العصر', Maghrib: 'المغرب', Isha: 'العشاء' };
  const KEYS = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];

  // --- STATE ---
  let state = {
    lat: -6.2088, lng: 106.8456, city: 'Jakarta',
    method: 20, useGPS: true, correction: 2, qibla: 0
  };
  let timer = null;

  // --- UTILS ---
  const showToast = (m) => {
    els.toast.textContent = m; els.toast.style.opacity = 1; els.toast.style.transform = 'translateX(-50%) translateY(-20px)';
    setTimeout(() => { els.toast.style.opacity = 0; els.toast.style.transform = 'translateX(-50%) translateY(10px)'; }, 2500);
  };
  const addMins = (tStr, m) => {
    let [hh, mm] = tStr.split(':').map(Number);
    let d = new Date(); d.setHours(hh, mm + m, 0);
    return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  };
  const toDate = (tStr) => {
    let [hh, mm] = tStr.split(':').map(Number);
    let d = new Date(); d.setHours(hh, mm, 0, 0);
    return d;
  };

  // --- INIT ---
  const init = () => {
    const s = JSON.parse(localStorage.getItem('qolbu-prayer') || '{}');
    if(s.method) state = {...state, ...s};
    
    // Bind Settings UI
    els.valCor.textContent = state.correction;
    els.inpUseGPS.checked = state.useGPS;
    els.inpCity.value = state.city;
    els.inpLat.value = state.lat;
    els.inpLng.value = state.lng;
    els.inpMethod.value = state.method;
    if(!state.useGPS) els.boxManual.classList.add('active');

    state.useGPS ? getGPS() : fetchAPI(state.lat, state.lng);
  };

  // --- DATA ---
  const getGPS = () => {
    els.locText.textContent = "Melacak...";
    els.refreshIc.style.animation = "spin 1s linear infinite";

    if(!navigator.geolocation) {
      showToast("GPS tidak didukung"); fetchAPI(state.lat, state.lng); return;
    }

    navigator.geolocation.getCurrentPosition(
      p => {
        state.lat = p.coords.latitude; state.lng = p.coords.longitude;
        // Reverse Geocode
        fetch(`https://nominatim.openstreetmap.org/reverse?lat=${state.lat}&lon=${state.lng}&format=json`)
          .then(r=>r.json()).then(d => {
            state.city = d.address.city || d.address.town || d.address.county || 'Sesuai GPS';
            els.locText.textContent = state.city;
          }).catch(()=> els.locText.textContent = "Sesuai GPS");
        
        fetchAPI(state.lat, state.lng);
      },
      e => {
        showToast("GPS Gagal, pakai lokasi terakhir");
        els.locText.textContent = state.city;
        fetchAPI(state.lat, state.lng);
      }, {timeout: 8000}
    );
  };

  const fetchAPI = async (lat, lng) => {
    calcQibla(lat, lng);
    try {
      const d = new Date(); const ds = `${d.getDate()}-${d.getMonth()+1}-${d.getFullYear()}`;
      const res = await fetch(`https://api.aladhan.com/v1/timings/${ds}?latitude=${lat}&longitude=${lng}&method=${state.method}`);
      const data = await res.json();
      
      if(data.code !== 200) throw new Error();

      // Apply correction
      const raw = data.data.timings;
      const t = {};
      Object.keys(raw).forEach(k => {
        t[k] = ['Fajr','Dhuhr','Asr','Maghrib','Isha','Imsak'].includes(k) ? addMins(raw[k], state.correction) : raw[k];
      });
      data.data.timings = t;

      renderUI(data.data);
      startTimer(t);
      els.corDisplay.textContent = state.correction > 0 ? `+${state.correction}` : state.correction;
      els.refreshIc.style.animation = "none";
    } catch(e) {
      showToast("Gagal memuat jadwal dari server");
      els.refreshIc.style.animation = "none";
    }
  };

  const renderUI = (data) => {
    const hj = data.date.hijri;
    els.hijri.textContent = `${hj.day} ${hj.month.en} ${hj.year} H`;
    const gr = data.date.gregorian;
    const days = ['Ahad','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    const dName = days[new Date().getDay()];
    const mNames = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des'];
    els.greg.textContent = `${dName}, ${gr.day} ${mNames[new Date().getMonth()]} ${gr.year}`;

    const t = data.timings;
    if(t.Imsak) { els.imsakStrip.style.display = 'flex'; els.imsakTime.textContent = t.Imsak; }

    const now = new Date();
    let nKey = null, minD = Infinity;
    KEYS.forEach(k => {
      const ms = toDate(t[k]) - now;
      if(ms > 0 && ms < minD) { minD = ms; nKey = k; }
    });
    
    let isTmrw = !nKey;
    if(!nKey) nKey = 'Fajr';
    els.nextName.textContent = NAMES[nKey];

    let html = '';
    KEYS.forEach(k => {
      const isPast = toDate(t[k]) < now;
      const isAct = k === nKey && !isTmrw;
      
      html += `
        <div class="p-item ${isAct?'active':''} ${isPast&&!isAct?'past':''}">
          <div class="p-left">
            <div class="p-icon">${ICONS[k]}</div>
            <div>
              <div class="p-name">${NAMES[k]}</div>
              <div class="p-ar">${ARABIC[k]}</div>
            </div>
          </div>
          <div class="p-time">${t[k]}</div>
        </div>
      `;
    });
    els.list.innerHTML = html;
  };

  const startTimer = (t) => {
    if(timer) clearInterval(timer);
    
    const tick = () => {
      const now = new Date();
      let tar = null;
      for(let k of KEYS) {
        let x = toDate(t[k]);
        if(x > now) { tar = x; break; }
      }
      if(!tar) {
        tar = toDate(t.Fajr); tar.setDate(tar.getDate() + 1);
      }
      
      const d = tar - now;
      const hh = Math.floor(d/3600000);
      const mm = Math.floor((d%3600000)/60000);
      const ss = Math.floor((d%60000)/1000);
      els.count.textContent = `${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}:${String(ss).padStart(2,'0')}`;
    };
    tick(); timer = setInterval(tick, 1000);
  };

  // --- QIBLA ---
  const calcQibla = (lat, lng) => {
    const kLat = 21.4225 * Math.PI / 180;
    const φ1 = lat * Math.PI / 180;
    const Δλ = (39.8262 - lng) * Math.PI / 180;
    const y = Math.sin(Δλ) * Math.cos(kLat);
    const x = Math.cos(φ1) * Math.sin(kLat) - Math.sin(φ1) * Math.cos(kLat) * Math.cos(Δλ);
    let q = (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
    
    state.qibla = q;
    const txt = q.toFixed(1)+'°';
    els.qValW.textContent = txt; els.qValFs.textContent = txt;
    els.qNeedleW.style.transform = `rotate(${q}deg)`;
  };

  let cHandler = null;
  const processCompass = (e) => {
    let alpha = e.webkitCompassHeading || Math.abs(e.alpha - 360);
    if(alpha === undefined || isNaN(alpha)) return;
    
    els.qDisc.style.transform = `rotate(${-alpha}deg)`;
    els.qArrow.style.transform = `rotate(${state.qibla - alpha}deg)`;
  };

  const startCompass = () => {
    if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
      els.btnIos.style.display = 'block';
      els.btnIos.onclick = () => {
        DeviceOrientationEvent.requestPermission().then(r => {
          if(r==='granted') { els.btnIos.style.display='none'; window.addEventListener('deviceorientation', processCompass); }
        }).catch(console.error);
      };
    } else {
      window.addEventListener('deviceorientationabsolute', processCompass);
    }
  };

  const stopCompass = () => {
    window.removeEventListener('deviceorientation', processCompass);
    window.removeEventListener('deviceorientationabsolute', processCompass);
  };

  // --- EVENTS ---
  els.btnRefresh.addEventListener('click', getGPS);
  
  els.btnOpenSet.addEventListener('click', () => { els.overlay.classList.add('show'); els.sheet.classList.add('show'); });
  const closeSet = () => { els.overlay.classList.remove('show'); els.sheet.classList.remove('show'); };
  els.btnCloseSet.addEventListener('click', closeSet); els.overlay.addEventListener('click', closeSet);
  
  els.inMinCor.addEventListener('click', () => els.valCor.textContent = parseInt(els.valCor.textContent)-1);
  els.inPlusCor.addEventListener('click', () => els.valCor.textContent = parseInt(els.valCor.textContent)+1);
  
  els.inpUseGPS.addEventListener('change', e => {
    e.target.checked ? els.boxManual.classList.remove('active') : els.boxManual.classList.add('active');
  });

  els.btnSaveSet.addEventListener('click', () => {
    state.useGPS = els.inpUseGPS.checked;
    state.method = els.inpMethod.value;
    state.correction = parseInt(els.valCor.textContent);
    if(!state.useGPS) {
      state.city = els.inpCity.value || 'Manual';
      state.lat = parseFloat(els.inpLat.value);
      state.lng = parseFloat(els.inpLng.value);
    }
    localStorage.setItem('qolbu-prayer', JSON.stringify(state));
    closeSet(); showToast("Pengaturan disimpan"); init();
  });

  els.btnOpenQ.addEventListener('click', () => { els.qFs.classList.add('show'); startCompass(); });
  els.btnCloseQFs.addEventListener('click', () => { els.qFs.classList.remove('show'); stopCompass(); });

  init();
});
</script>

</BaseLayout>