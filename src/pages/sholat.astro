<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  // ─── DOM ───────────────────────────────────────────────────────────────
  const $ = id => document.getElementById(id);
  const els = {
    locText:    $('location-text'),
    list:       $('prayer-list'),
    imsakRow:   $('imsak-row'),
    imsakTime:  $('imsak-time'),
    nextName:   $('next-prayer-name'),
    count:      $('countdown'),
    hijri:      $('hijri-date'),
    greg:       $('gregorian-date'),
    refresh:    $('refresh-loc-btn'),
    refreshIcon:$('refresh-icon'),
    corDisplay: $('correction-display'),

    settingsBtn:     $('settings-btn'),
    settingsModal:   $('settings-modal'),
    settingsOverlay: $('settings-overlay'),
    saveSet:         $('save-settings-btn'),

    useGPS:    $('use-current-location'),
    manualBox: $('manual-location'),
    latIn:     $('lat-input'),
    lngIn:     $('lng-input'),
    cityIn:    $('city-input'),
    method:    $('calc-method'),
    adhan:     $('adhan-notification'),
    remind:    $('reminder-notification'),

    btnMinus:  $('btn-minus-cor'),
    btnPlus:   $('btn-plus-cor'),
    inputCor:  $('input-correction'),

    qiblaBtn:     $('qibla-compass-btn'),
    qiblaModal:   $('qibla-modal'),
    closeQibla:   $('close-qibla-btn'),
    disc:         $('qibla-compass-disc'),
    arrowCont:    $('qibla-arrow-container'),
    qiblaText:    $('qibla-direction-text'),
    qiblaDeg:     $('qibla-degree-modal'),
    previewNeedle:$('qibla-preview-needle'),
    iosBtn:       $('ios-permission-btn'),
    toast:        $('toast'),
  };

  // ─── STATE ─────────────────────────────────────────────────────────────
  const DEFAULT_STATE = {
    lat: -6.2088, lng: 106.8456, city: 'Jakarta',
    method: 20, useGPS: true,
    adhan: false, remind: false,
    qiblaAngle: 0, correction: 2
  };
  let state = { ...DEFAULT_STATE };
  let countdownInterval = null;
  let lastTimings = null;

  // ─── UTILS ─────────────────────────────────────────────────────────────
  const showToast = (msg, duration = 2500) => {
    els.toast.textContent = msg;
    els.toast.classList.add('show');
    setTimeout(() => els.toast.classList.remove('show'), duration);
  };

  const addMinutes = (timeStr, mins) => {
    const [h, m] = timeStr.split(':').map(Number);
    const d = new Date(); d.setHours(h, m + mins, 0);
    return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  };

  const toDate = (timeStr) => {
    const [h, m] = timeStr.split(':').map(Number);
    const d = new Date(); d.setHours(h, m, 0, 0);
    return d;
  };

  const formatCountdown = (ms) => {
    if (ms < 0) ms = 0;
    const h = Math.floor(ms / 3600000);
    const m = Math.floor((ms % 3600000) / 60000);
    const s = Math.floor((ms % 60000) / 1000);
    return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  };

  // ─── INIT ──────────────────────────────────────────────────────────────
  const init = () => {
    loadSettings();
    if (state.useGPS) getGPS();
    else {
      els.locText.textContent = state.city || 'Manual';
      fetchPrayer(state.lat, state.lng);
    }
  };

  // ─── GPS ───────────────────────────────────────────────────────────────
  const getGPS = () => {
    els.locText.textContent = 'Mencari...';
    els.refresh.classList.add('loading');

    if (!navigator.geolocation) {
      showToast('Browser tidak mendukung GPS');
      els.refresh.classList.remove('loading');
      fetchPrayer(state.lat, state.lng);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      pos => {
        state.lat = pos.coords.latitude;
        state.lng = pos.coords.longitude;
        state.city = 'GPS Akurat';
        els.locText.textContent = state.city;
        els.latIn.value = state.lat.toFixed(5);
        els.lngIn.value = state.lng.toFixed(5);
        els.refresh.classList.remove('loading');
        fetchPrayer(state.lat, state.lng);

        // Reverse geocode (no key needed)
        fetch(`https://nominatim.openstreetmap.org/reverse?lat=${state.lat}&lon=${state.lng}&format=json`)
          .then(r => r.json())
          .then(d => {
            const city = d.address.city || d.address.town || d.address.county || '';
            if (city) {
              state.city = city;
              els.locText.textContent = city;
              if (!state.useGPS) els.cityIn.value = city;
            }
          })
          .catch(() => {});
      },
      err => {
        els.refresh.classList.remove('loading');
        showToast('GPS gagal — pakai koordinat terakhir');
        els.locText.textContent = state.city || 'Jakarta';
        fetchPrayer(state.lat, state.lng);
      },
      { timeout: 10000, maximumAge: 60000 }
    );
  };

  // ─── FETCH PRAYER ──────────────────────────────────────────────────────
  const fetchPrayer = async (lat, lng) => {
    try {
      calcQibla(lat, lng);

      const d = new Date();
      const dateStr = `${d.getDate()}-${d.getMonth()+1}-${d.getFullYear()}`;
      const url = `https://api.aladhan.com/v1/timings/${dateStr}?latitude=${lat}&longitude=${lng}&method=${state.method}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();

      if (json.code !== 200) throw new Error('API error');

      const raw = json.data.timings;
      const CORRECTABLE = ['Fajr','Dhuhr','Asr','Maghrib','Isha','Imsak','Sunrise'];
      const timings = {};
      Object.keys(raw).forEach(k => {
        timings[k] = CORRECTABLE.includes(k) ? addMinutes(raw[k], state.correction) : raw[k];
      });
      json.data.timings = timings;

      lastTimings = timings;
      render(json.data);
      startTimer(timings);

      const corVal = state.correction;
      els.corDisplay.textContent = corVal >= 0 ? `+${corVal}` : `${corVal}`;

    } catch (e) {
      console.error('fetchPrayer:', e);
      showToast('Gagal memuat jadwal. Periksa koneksi.');
      els.locText.textContent = 'Error';
    }
  };

  // ─── RENDER ────────────────────────────────────────────────────────────
  const PRAYER_KEYS  = ['Fajr','Dhuhr','Asr','Maghrib','Isha'];
  const PRAYER_NAMES = { Fajr:'Subuh', Dhuhr:'Dzuhur', Asr:'Ashar', Maghrib:'Maghrib', Isha:'Isya' };
  const PRAYER_AR    = { Fajr:'الفجر', Dhuhr:'الظهر', Asr:'العصر', Maghrib:'المغرب', Isha:'العشاء' };
  const DAYS_ID      = ['Ahad','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
  const MONTHS_EN    = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  const render = (data) => {
    // Dates
    const hijri = data.date.hijri;
    els.hijri.textContent = `${hijri.day} ${hijri.month.en} ${hijri.year} H`;

    const now = new Date();
    const dayName = DAYS_ID[now.getDay()];
    els.greg.textContent = `${dayName}, ${now.getDate()} ${MONTHS_EN[now.getMonth()]} ${now.getFullYear()}`;

    // Imsak
    if (data.timings.Imsak) {
      els.imsakRow.classList.remove('hidden');
      els.imsakTime.textContent = data.timings.Imsak;
    }

    // Find next prayer
    let nextKey = null, minDiff = Infinity;
    PRAYER_KEYS.forEach(k => {
      const t = toDate(data.timings[k]);
      const diff = t - now;
      if (diff > 0 && diff < minDiff) { minDiff = diff; nextKey = k; }
    });

    const isTomorrow = !nextKey;
    if (!nextKey) nextKey = 'Fajr';
    els.nextName.textContent = PRAYER_NAMES[nextKey];

    // Render list
    let html = '';
    PRAYER_KEYS.forEach(k => {
      const pTime = toDate(data.timings[k]);
      const isPast = pTime < now;
      const isActive = k === nextKey && !isTomorrow;

      html += `
        <div class="prayer-item${isActive ? ' active' : ''}${isPast && !isActive ? ' past' : ''}">
          <div class="prayer-left">
            <div class="prayer-dot"></div>
            <div>
              <div class="prayer-name">${PRAYER_NAMES[k]}</div>
              <div class="prayer-arabic">${PRAYER_AR[k]}</div>
            </div>
          </div>
          <div class="prayer-time">${data.timings[k]}</div>
        </div>
      `;
    });
    els.list.innerHTML = html;
  };

  // ─── TIMER ─────────────────────────────────────────────────────────────
  const startTimer = (timings) => {
    if (countdownInterval) clearInterval(countdownInterval);

    let lastNotifiedKey = null;

    const tick = () => {
      const now = new Date();
      let target = null, targetKey = null;

      for (const k of PRAYER_KEYS) {
        const t = toDate(timings[k]);
        if (t > now) { target = t; targetKey = k; break; }
      }

      if (!target) {
        // Past Isha → Fajr tomorrow
        target = toDate(timings['Fajr']);
        target.setDate(target.getDate() + 1);
        targetKey = 'Fajr';
      }

      const diff = target - now;
      els.count.textContent = formatCountdown(diff);

      // Update active highlight each minute
      if (now.getSeconds() === 0) render({ 
        date: { hijri: { day:'', month:{ en:'' }, year:'' }, gregorian:{} },
        timings 
      });

      // Notifications
      if (state.adhan && diff < 1000 && diff > 0 && lastNotifiedKey !== targetKey) {
        notify(`Waktu ${PRAYER_NAMES[targetKey]} telah tiba!`, 'adhan-' + targetKey);
        lastNotifiedKey = targetKey;
      }
      if (state.remind && diff < 600000 && diff > 599000) {
        notify(`10 menit lagi waktu ${PRAYER_NAMES[targetKey]}`, 'remind-' + targetKey);
      }
    };

    tick();
    countdownInterval = setInterval(tick, 1000);
  };

  // ─── QIBLA ─────────────────────────────────────────────────────────────
  const calcQibla = (lat, lng) => {
    const kLat = 21.4225 * Math.PI / 180;
    const kLng = 39.8262 * Math.PI / 180;
    const φ1   = lat * Math.PI / 180;
    const Δλ   = (kLng - lng * Math.PI / 180);

    const x = Math.sin(Δλ) * Math.cos(kLat);
    const y = Math.cos(φ1) * Math.sin(kLat) - Math.sin(φ1) * Math.cos(kLat) * Math.cos(Δλ);
    const q = ((Math.atan2(x, y) * 180 / Math.PI) + 360) % 360;

    state.qiblaAngle = q;
    const deg = q.toFixed(1) + '°';
    els.qiblaText.textContent = deg;
    els.qiblaDeg.textContent  = deg;
    els.previewNeedle.style.transform = `rotate(${q}deg)`;
  };

  let compassHandler = null;
  const handleCompass = (e) => {
    const heading = e.webkitCompassHeading ?? (360 - (e.alpha || 0));
    els.disc.style.transform      = `rotate(${-heading}deg)`;
    els.arrowCont.style.transform = `rotate(${state.qiblaAngle - heading}deg)`;
  };

  const startCompass = () => {
    compassHandler = handleCompass;
    if (typeof DeviceOrientationEvent !== 'undefined' &&
        typeof DeviceOrientationEvent.requestPermission === 'function') {
      els.iosBtn.style.display = 'block';
      els.iosBtn.onclick = () => {
        DeviceOrientationEvent.requestPermission()
          .then(r => {
            if (r === 'granted') {
              els.iosBtn.style.display = 'none';
              window.addEventListener('deviceorientation', compassHandler, true);
            } else {
              showToast('Izin kompas ditolak');
            }
          }).catch(console.error);
      };
    } else {
      window.addEventListener('deviceorientationabsolute', compassHandler, true);
      window.addEventListener('deviceorientation', compassHandler, true);
    }
  };

  const stopCompass = () => {
    if (!compassHandler) return;
    window.removeEventListener('deviceorientation', compassHandler, true);
    window.removeEventListener('deviceorientationabsolute', compassHandler, true);
    compassHandler = null;
  };

  // ─── NOTIFICATIONS ─────────────────────────────────────────────────────
  const notify = (body, tag) => {
    if (Notification.permission === 'granted') {
      new Notification('Qolbu App', { body, tag, icon: '/favicon.svg' });
    }
  };

  const reqNotify = async () => {
    if ('Notification' in window && Notification.permission !== 'granted') {
      const p = await Notification.requestPermission();
      if (p === 'granted') showToast('Notifikasi aktif ✓');
    }
  };

  // ─── SETTINGS ──────────────────────────────────────────────────────────
  const loadSettings = () => {
    try {
      const s = JSON.parse(localStorage.getItem('sholat-settings') || '{}');
      if (Object.keys(s).length) {
        state = { ...DEFAULT_STATE, ...s };
        els.useGPS.checked    = state.useGPS;
        els.latIn.value       = state.lat;
        els.lngIn.value       = state.lng;
        els.cityIn.value      = state.city;
        els.method.value      = state.method;
        els.adhan.checked     = state.adhan;
        els.remind.checked    = state.remind;
        els.inputCor.textContent = state.correction;

        if (!state.useGPS) els.manualBox.classList.add('show');
      }
    } catch { /* ignore */ }
  };

  const saveSettings = () => {
    state.useGPS     = els.useGPS.checked;
    state.method     = els.method.value;
    state.adhan      = els.adhan.checked;
    state.remind     = els.remind.checked;
    state.correction = parseInt(els.inputCor.textContent) || 0;

    if (!state.useGPS) {
      state.lat  = parseFloat(els.latIn.value)  || DEFAULT_STATE.lat;
      state.lng  = parseFloat(els.lngIn.value)  || DEFAULT_STATE.lng;
      state.city = els.cityIn.value.trim()       || 'Manual';
    }

    localStorage.setItem('sholat-settings', JSON.stringify(state));
    if (state.adhan || state.remind) reqNotify();
    showToast('Pengaturan disimpan ✓');
    init();
  };

  // ─── MODAL HELPERS ─────────────────────────────────────────────────────
  const openSettings = () => els.settingsModal.classList.add('open');
  const closeSettings = () => els.settingsModal.classList.remove('open');
  const openQibla = () => { els.qiblaModal.classList.add('open'); startCompass(); };
  const closeQibla = () => { els.qiblaModal.classList.remove('open'); stopCompass(); };

  // ─── EVENTS ────────────────────────────────────────────────────────────
  els.refresh.addEventListener('click', getGPS);

  els.settingsBtn.addEventListener('click', openSettings);
  els.settingsOverlay.addEventListener('click', closeSettings);

  els.useGPS.addEventListener('change', e => {
    if (e.target.checked) els.manualBox.classList.remove('show');
    else els.manualBox.classList.add('show');
  });

  els.saveSet.addEventListener('click', () => { saveSettings(); closeSettings(); });

  els.btnMinus.addEventListener('click', () => {
    const v = parseInt(els.inputCor.textContent);
    els.inputCor.textContent = v - 1;
  });
  els.btnPlus.addEventListener('click', () => {
    const v = parseInt(els.inputCor.textContent);
    els.inputCor.textContent = v + 1;
  });

  els.qiblaBtn.addEventListener('click', openQibla);
  els.closeQibla.addEventListener('click', closeQibla);

  // Keyboard close
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeSettings(); closeQibla(); }
  });

  // ─── START ─────────────────────────────────────────────────────────────
  init();

  // ─── AUTO-REFRESH at midnight ──────────────────────────────────────────
  const msUntilMidnight = () => {
    const n = new Date(), m = new Date();
    m.setHours(24,0,5,0);
    return m - n;
  };
  setTimeout(() => {
    fetchPrayer(state.lat, state.lng);
    setInterval(() => fetchPrayer(state.lat, state.lng), 86400000);
  }, msUntilMidnight());

});
</script>

</BaseLayout>