<script is:inline>
  (() => {
    const initMasukIslam = () => {
      if (window._masukIslamInitialized) return;
      const stepDetails = document.querySelectorAll('details.step-item');
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-text');
      const resetBtn = document.getElementById('reset-progress');
      const copyBtn = document.getElementById('copy-syahadat');
      if (!stepDetails.length || !progressBar || !progressText) return;
      window._masukIslamInitialized = true;

      const TOTAL = stepDetails.length;
      const CHECK_SVG =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

      // Safe-parse: data korup tidak boleh mematikan halaman
      const safeParse = (key) => {
        try {
          return JSON.parse(localStorage.getItem(key) || '[]');
        } catch {
          return [];
        }
      };
      let completed = safeParse('masuk-islam-completed');
      if (!Array.isArray(completed)) completed = [];

      const updateProgress = () => {
        stepDetails.forEach((el) => {
          const id = el.getAttribute('data-id');
          const badge = el.querySelector('.step-badge');
          const markBtn = el.querySelector('.mark-complete-btn');
          if (!badge) return;

          if (completed.includes(id)) {
            badge.innerHTML = CHECK_SVG;
            badge.classList.add('bg-emerald-500', 'text-white');
            badge.classList.remove(
              'bg-slate-200',
              'dark:bg-slate-700',
              'text-slate-600',
              'dark:text-slate-300'
            );
            if (markBtn) {
              markBtn.querySelector('.btn-text').textContent = 'Selesai ✓';
              markBtn.classList.add(
                'bg-emerald-100',
                'dark:bg-emerald-900/30',
                'text-emerald-600',
                'dark:text-emerald-400',
                'border-emerald-200',
                'dark:border-emerald-800'
              );
              markBtn.classList.remove(
                'bg-slate-100',
                'dark:bg-slate-800',
                'text-slate-500',
                'dark:text-slate-400',
                'border-slate-200',
                'dark:border-slate-700'
              );
            }
          } else {
            const idx = parseInt(el.getAttribute('data-index')) + 1;
            badge.innerHTML = idx;
            badge.classList.remove('bg-emerald-500', 'text-white');
            badge.classList.add(
              'bg-slate-200',
              'dark:bg-slate-700',
              'text-slate-600',
              'dark:text-slate-300'
            );
            if (markBtn) {
              markBtn.querySelector('.btn-text').textContent = 'Tandai Selesai';
              markBtn.classList.remove(
                'bg-emerald-100',
                'dark:bg-emerald-900/30',
                'text-emerald-600',
                'dark:text-emerald-400',
                'border-emerald-200',
                'dark:border-emerald-800'
              );
              markBtn.classList.add(
                'bg-slate-100',
                'dark:bg-slate-800',
                'text-slate-500',
                'dark:text-slate-400',
                'border-slate-200',
                'dark:border-slate-700'
              );
            }
          }
        });

        const pct = (completed.length / TOTAL) * 100;
        progressBar.style.width = `${pct}%`;
        progressText.innerText = `${completed.length} dari ${TOTAL} langkah selesai`;
        progressBar.setAttribute('aria-valuenow', String(completed.length));
      };

      // Accordion: hanya satu langkah terbuka
      stepDetails.forEach((el) => {
        el.addEventListener('toggle', () => {
          if (el.open) {
            stepDetails.forEach((other) => {
              if (other !== el && other.open) other.open = false;
            });
          }
        });

        const markBtn = el.querySelector('.mark-complete-btn');
        if (markBtn) {
          markBtn.addEventListener('click', () => {
            const id = el.getAttribute('data-id');
            if (completed.includes(id)) {
              completed = completed.filter((c) => c !== id);
            } else {
              completed.push(id);
              if (window.showToast) window.showToast('MasyaAllah! Langkah selesai 🎉');
            }
            localStorage.setItem('masuk-islam-completed', JSON.stringify(completed));
            updateProgress();
          });
        }
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (confirm('Reset progres langkah masuk Islam?')) {
            completed = [];
            localStorage.setItem('masuk-islam-completed', '[]');
            updateProgress();
            if (window.showToast) window.showToast('Progres direset');
          }
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = [
            'Dua Kalimat Syahadat',
            '',
            'أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ',
            '',
            'Asy-hadu allā ilāha illallāh, wa asy-hadu anna Muḥammadan rasūlullāh',
            '"Aku bersaksi bahwa tiada Tuhan selain Allah, dan aku bersaksi bahwa Muhammad adalah utusan Allah."',
            '',
            'Dibagikan via Qolbu App',
          ].join('\n');
          try {
            await navigator.clipboard.writeText(text);
            if (window.showToast) window.showToast('Bacaan syahadat disalin!');
          } catch {
            if (window.showToast) window.showToast('Gagal menyalin teks');
          }
        });
      }

      updateProgress();
    };

    document.addEventListener('astro:page-load', initMasukIslam);
    document.addEventListener('astro:before-swap', () => {
      window._masukIslamInitialized = false;
    });
  })();
</script>
