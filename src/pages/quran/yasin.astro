---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderBack from '../../components/HeaderBack.astro';

import yasinData from '../../data/yasin.json';
const ayatList = yasinData;

const toArabic = (num) => {
  const map = {'0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩'};
  return num.toString().split('').map(c => map[c] || c).join('');
};
---

<BaseLayout pageTitle="Surat Yasin">

  <HeaderBack href="/quran" label="Al-Qur'an" title="Surat Yasin" />

  <div class="pb-24 px-4 w-full max-w-md mx-auto">

    <div class="text-center mb-8 mt-2 bg-gradient-to-br from-emerald-500 to-teal-700 rounded-3xl p-6 text-white shadow-lg shadow-emerald-500/20 relative overflow-hidden">
      <div class="absolute top-0 right-0 opacity-10 transform translate-x-4 -translate-y-4">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
      </div>
      <h1 class="font-amiri text-5xl mb-2 relative z-10">يس</h1>
      <h2 class="text-xl font-bold relative z-10">Surat Yasin</h2>
      <p class="text-sm text-emerald-100 mt-1 relative z-10">{ayatList.length} Ayat</p>
    </div>

    <!-- Controls -->
    <div class="flex gap-2 mb-6">
      <button id="play-all-btn" class="flex-1 flex items-center justify-center gap-2 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-sm transition-all active:scale-95 shadow-md shadow-emerald-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Putar Semua
      </button>
      <button id="stop-all-btn" class="px-4 py-3 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 rounded-xl font-bold text-sm transition-all hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-95 border border-slate-200 dark:border-slate-700 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      </button>
      <button id="settings-btn" class="px-4 py-3 bg-slate-100 dark:bg-slate-800 rounded-xl text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-colors border border-slate-200 dark:border-slate-700">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
    </div>

    <!-- Progress bar -->
    <div class="bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 mb-6 overflow-hidden">
      <div id="yasin-progress" class="bg-emerald-500 h-full transition-all duration-500" style="width: 0%"></div>
    </div>

    <!-- Ayat list -->
    <div class="space-y-6" id="ayat-list">
      {ayatList.map((ayat, index) => (
        <div
          id={`ayat-${ayat.nomor}`}
          class="ayat-card bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-all hover:shadow-md scroll-mt-24"
          data-index={index}
        >
          <div class="flex justify-between items-center mb-4 border-b border-slate-50 dark:border-slate-800/50 pb-3">
            <div class="w-8 h-8 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center text-sm font-bold text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              {ayat.nomor}
            </div>
            <button
              type="button"
              data-audio={ayat.audio}
              class="btn-audio p-2.5 rounded-xl text-emerald-600 bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 transition-colors active:scale-90"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="icon-play pointer-events-none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="icon-pause hidden pointer-events-none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            </button>
          </div>

          <div class="text-right mb-6">
            <p class="text-arab font-amiri text-[2rem] leading-[2.4] text-slate-800 dark:text-slate-100 transition-all duration-300" dir="rtl">
              {ayat.arab}
            </p>
          </div>

          <div class="space-y-2 border-t border-slate-50 dark:border-slate-800/50 pt-4">
            <p class="text-latin text-emerald-700 dark:text-emerald-400 font-medium italic text-[0.95rem] leading-relaxed">
              {ayat.latin}
            </p>
            <p class="text-arti text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              {ayat.arti}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Closing -->
    <div class="bg-gradient-to-br from-emerald-500 to-teal-600 p-6 rounded-2xl shadow-lg text-white text-center mt-8">
      <h3 class="font-bold text-lg mb-2">صدق الله العظيم</h3>
      <p class="text-sm opacity-90 mb-4">Maha Benar Allah dengan segala firman-Nya.</p>
      <a href="/quran" class="inline-block bg-white text-emerald-600 px-6 py-2 rounded-full font-bold text-sm hover:bg-emerald-50 transition-colors">
        Kembali ke Daftar Surat
      </a>
    </div>
  </div>

  <!-- Settings Modal -->
  <div id="settings-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" id="overlay"></div>
    <div class="absolute bottom-0 left-0 w-full bg-white dark:bg-slate-900 rounded-t-3xl p-6 shadow-2xl animate-slide-up" style="left: 50%; transform: translateX(-50%); max-width: 448px;">
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-bold text-lg text-slate-800 dark:text-white">Tampilan Bacaan</h3>
        <button id="close-settings" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-600 dark:text-slate-400 mb-3">Ukuran Font Arab</label>
          <input type="range" id="font-size-range" min="1" max="5" step="1" value="3" class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500">
          <div class="flex justify-between text-xs text-slate-400 mt-2 font-medium">
            <span>Kecil</span><span>Normal</span><span>Besar</span>
          </div>
        </div>
        <hr class="border-slate-100 dark:border-slate-800" />
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-200 font-medium text-sm">Tampilkan Teks Latin</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-latin" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-200 font-medium text-sm">Tampilkan Terjemahan</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-arti" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<script is:inline>
  const initYasin = () => {
    const audioBtns = Array.from(document.querySelectorAll('.btn-audio'));
    let currentAudio = null;
    let currentBtn = null;
    let playAllActive = false;

    const playSingle = (btn, index) => {
      const url = btn.getAttribute('data-audio');
      const iconPlay = btn.querySelector('.icon-play');
      const iconPause = btn.querySelector('.icon-pause');
      const card = btn.closest('.ayat-card');

      if (currentBtn === btn && currentAudio && !currentAudio.paused) {
        currentAudio.pause();
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        return;
      }

      if (currentAudio) {
        currentAudio.pause();
        document.querySelectorAll('.icon-pause').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.icon-play').forEach(el => el.classList.remove('hidden'));
        document.querySelectorAll('.ayat-card').forEach(el => el.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md'));
      }

      currentAudio = new Audio(url);
      currentBtn = btn;
      currentAudio.play();

      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      card.classList.add('ring-2', 'ring-emerald-500', 'shadow-md');

      currentAudio.onended = () => {
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        card.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md');
        const progress = document.getElementById('yasin-progress');
        if (progress) progress.style.width = `${((index + 1) / audioBtns.length) * 100}%`;

        if (playAllActive && index + 1 < audioBtns.length) {
          const nextBtn = audioBtns[index + 1];
          nextBtn.click();
          nextBtn.closest('.ayat-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          if (playAllActive) {
            playAllActive = false;
            document.getElementById('play-all-btn').classList.remove('hidden');
            document.getElementById('stop-all-btn').classList.add('hidden');
          }
          currentAudio = null;
          currentBtn = null;
        }
      };
    };

    // ===== AUDIO PREFETCH =====
    const prefetchAudio = (url) => {
      if (!url) return;
      try { fetch(url, { mode: 'no-cors', cache: 'force-cache' }).catch(() => {}); } catch {}
    };

    const prefetchNextAyats = (fromIndex, count = 3) => {
      for (let i = 1; i <= count; i++) {
        const nextBtn = audioBtns[fromIndex + i];
        if (nextBtn) prefetchAudio(nextBtn.getAttribute('data-audio'));
      }
    };

    audioBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        playAllActive = false;
        prefetchNextAyats(index);
        playSingle(btn, index);
      });
    });

    const playAllBtn = document.getElementById('play-all-btn');
    const stopAllBtn = document.getElementById('stop-all-btn');
    playAllBtn.addEventListener('click', () => {
      playAllActive = true;
      playAllBtn.classList.add('hidden');
      stopAllBtn.classList.remove('hidden');
      audioBtns[0].click();
    });
    stopAllBtn.addEventListener('click', () => {
      playAllActive = false;
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      playAllBtn.classList.remove('hidden');
      stopAllBtn.classList.add('hidden');
      document.querySelectorAll('.icon-pause').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.icon-play').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('.ayat-card').forEach(el => el.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md'));
    });

    // Settings
    const settingsBtn = document.getElementById('settings-btn');
    const settingsModal = document.getElementById('settings-modal');
    const closeSettings = document.getElementById('close-settings');
    const overlay = document.getElementById('overlay');
    const fontSizeRange = document.getElementById('font-size-range');
    const toggleLatin = document.getElementById('toggle-latin');
    const toggleArti = document.getElementById('toggle-arti');

    settingsBtn.addEventListener('click', () => settingsModal?.classList.remove('hidden'));
    closeSettings.addEventListener('click', () => settingsModal?.classList.add('hidden'));
    overlay.addEventListener('click', () => settingsModal?.classList.add('hidden'));

    const applySettings = () => {
      const size = parseInt(fontSizeRange.value);
      const sizes = ['1.4rem', '1.7rem', '2rem', '2.5rem', '3rem'];
      document.querySelectorAll('.text-arab').forEach(el => el.style.fontSize = sizes[size - 1]);
      document.querySelectorAll('.text-latin').forEach(el => el.style.display = toggleLatin.checked ? 'block' : 'none');
      document.querySelectorAll('.text-arti').forEach(el => el.style.display = toggleArti.checked ? 'block' : 'none');
      localStorage.setItem('yasin-settings', JSON.stringify({ size, showLatin: toggleLatin.checked, showArti: toggleArti.checked }));
    };

    fontSizeRange.addEventListener('input', applySettings);
    toggleLatin.addEventListener('change', applySettings);
    toggleArti.addEventListener('change', applySettings);

    const saved = localStorage.getItem('yasin-settings');
    if (saved) {
      const { size, showLatin, showArti } = JSON.parse(saved);
      fontSizeRange.value = size;
      toggleLatin.checked = showLatin;
      toggleArti.checked = showArti;
    }
    applySettings();

    // ------ LANJUT BACA: save last read position ------
    const SAVE_DELAY = 1500;
    let scrollTimer = null;

    const saveLastRead = (ayatNum) => {
      const data = {
        surah: '36',
        ayat: ayatNum,
        surahName: 'Yasin',
        timestamp: Date.now()
      };
      localStorage.setItem('quran-last-read', JSON.stringify(data));
    };

    // Save on audio button click
    audioBtns.forEach((btn) => {
      const ayatNum = btn.closest('.ayat-card')?.id?.replace('ayat-', '');
      if (ayatNum) {
        btn.addEventListener('click', () => saveLastRead(parseInt(ayatNum)));
      }
    });

    // Save on scroll (debounced) — listen on window, detect visible ayat
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const cards = document.querySelectorAll('.ayat-card');
        let visibleAyat = null;
        cards.forEach(card => {
          const rect = card.getBoundingClientRect();
          if (rect.top < window.innerHeight / 2 && rect.bottom > 0) {
            visibleAyat = card.id.replace('ayat-', '');
          }
        });
        if (visibleAyat) saveLastRead(parseInt(visibleAyat));
      }, SAVE_DELAY);
    });

    // Check for saved position on load
    try {
      const lastRead = JSON.parse(localStorage.getItem('quran-last-read') || '{}');
      if (lastRead.surah === '36' && lastRead.ayat) {
        setTimeout(() => {
          const el = document.getElementById(`ayat-${lastRead.ayat}`);
          if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.add('ring-2', 'ring-emerald-500', 'shadow-lg');
            setTimeout(() => el.classList.remove('ring-2', 'ring-emerald-500', 'shadow-lg'), 3000);
          }
        }, 600);
      }
    } catch (e) {}
  };

  document.addEventListener('DOMContentLoaded', initYasin);
  document.addEventListener('astro:after-swap', initYasin);
</script>

<style>
  @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
</style>
