---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderSticky from '../../components/HeaderSticky.astro';
import SettingsModal from '../../components/SettingsModal.astro';

// Type definitions for API responses
interface SuratListItem {
  nomor: number;
  nama: string;
  namaLatin: string;
  jumlahAyat: number;
  tempatTurun: string;
  arti: string;
  ayat: SuratAyat[];
}

interface SuratAyat {
  nomorAyat: number;
  teksArab: string;
  teksLatin: string;
  teksIndonesia: string;
  audio: Record<string, string>;
}

export async function getStaticPaths() {
  const res = await fetch('https://equran.id/api/v2/surat');
  const json = await res.json();
  const suratList = json.data as SuratListItem[];

  return suratList.map((surat) => ({
    params: { nomor: surat.nomor.toString() },
  }));
}

const { nomor } = Astro.params;

const resDetail = await fetch(`https://equran.id/api/v2/surat/${nomor}`);
const jsonDetail = await resDetail.json();
const suratData = jsonDetail.data as SuratListItem;

const toArabic = (num: number): string => {
  const arabicMap: Record<string, string> = {
    '0': '٠',
    '1': '١',
    '2': '٢',
    '3': '٣',
    '4': '٤',
    '5': '٥',
    '6': '٦',
    '7': '٧',
    '8': '٨',
    '9': '٩',
  };
  return num
    .toString()
    .split('')
    .map((c: string) => arabicMap[c] || c)
    .join('');
};
---

<BaseLayout pageTitle={`Surat ${suratData.namaLatin}`}>
  <HeaderSticky title={`Surat ${suratData.namaLatin}`} leftSlot rightSlot>
    <div slot="left" class="flex items-center gap-2">
      <a
        href="/quran"
        class="-ml-2 flex items-center gap-2 rounded-lg p-2 text-slate-600 transition-colors hover:text-emerald-600 active:bg-slate-100 dark:text-slate-400 dark:active:bg-slate-800"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
        <span class="text-sm font-medium">Daftar Surat</span>
      </a>
      <div
        class="ml-2 flex rounded-full border border-slate-200 bg-slate-100 p-1 dark:border-slate-700 dark:bg-slate-800"
        role="tablist"
        aria-label="Mode tampilan"
      >
        <button
          id="btn-terjemah"
          role="tab"
          aria-selected="true"
          aria-controls="view-terjemah"
          class="rounded-full bg-white px-3 py-1 text-xs font-bold text-emerald-600 shadow-sm transition-all dark:bg-slate-700"
          >Per Ayat</button
        >
        <button
          id="btn-mushaf"
          role="tab"
          aria-selected="false"
          aria-controls="view-mushaf"
          class="rounded-full px-3 py-1 text-xs font-bold text-slate-500 transition-all hover:text-emerald-600 dark:text-slate-400"
          >Mushaf</button
        >
      </div>
    </div>
    <button
      slot="right"
      id="settings-btn"
      aria-label="Pengaturan tampilan bacaan"
      class="rounded-full bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-emerald-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-emerald-900/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="3"></circle><path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 0 1-2.83 0 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2-2h.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
        ></path></svg
      >
    </button>
  </HeaderSticky>

  <SettingsModal modalId="settings-modal" title="Tampilan Bacaan">
    <div class="space-y-6">
      <div>
        <label class="mb-3 block text-sm font-medium text-slate-600 dark:text-slate-400"
          >Ukuran Font Arab</label
        >
        <input
          type="range"
          id="font-size-range"
          min="1"
          max="5"
          step="1"
          value="3"
          class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-slate-200 accent-emerald-500 dark:bg-slate-700"
        />
        <div class="mt-2 flex justify-between text-xs font-medium text-slate-400">
          <span>Kecil</span><span>Normal</span><span>Besar</span>
        </div>
      </div>
      <hr class="border-slate-100 dark:border-slate-800" />
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-700 dark:text-slate-200"
          >Tampilkan Teks Latin</span
        >
        <label class="relative inline-flex cursor-pointer items-center">
          <input type="checkbox" id="toggle-latin" class="peer sr-only" checked />
          <div
            class="peer h-6 w-11 rounded-full bg-slate-200 peer-checked:bg-emerald-500 peer-focus:outline-none after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-700"
          >
          </div>
        </label>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-700 dark:text-slate-200"
          >Tampilkan Terjemahan</span
        >
        <label class="relative inline-flex cursor-pointer items-center">
          <input type="checkbox" id="toggle-arti" class="peer sr-only" checked />
          <div
            class="peer h-6 w-11 rounded-full bg-slate-200 peer-checked:bg-emerald-500 peer-focus:outline-none after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-700"
          >
          </div>
        </label>
      </div>
    </div>
  </SettingsModal>

  <div class="mx-auto w-full max-w-md px-4 pb-24">
    <div
      class="relative mt-2 mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-6 text-center text-white shadow-lg shadow-emerald-500/20"
    >
      <div class="absolute top-0 right-0 translate-x-4 -translate-y-4 transform opacity-10">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
          ></path></svg
        >
      </div>
      <h1 class="font-amiri relative z-10 mb-2 text-5xl">{suratData.nama}</h1>
      <h2 class="relative z-10 text-xl font-bold">Surat {suratData.namaLatin}</h2>
      <p class="relative z-10 mt-1 text-sm text-emerald-100">
        {suratData.arti} • {suratData.jumlahAyat} Ayat
      </p>
    </div>

    <div id="view-terjemah" role="tabpanel" aria-labelledby="btn-terjemah" class="space-y-6">
      {
        suratData.ayat.map((ayat) => (
          <div
            id={`ayat-${ayat.nomorAyat}`}
            class="ayat-card scroll-mt-24 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-4 flex items-center justify-between border-b border-slate-50 pb-3 dark:border-slate-800/50">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-sm font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                {ayat.nomorAyat}
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  aria-label={`Bagikan ayat ${ayat.nomorAyat}`}
                  data-share={`${suratData.namaLatin} ${ayat.nomorAyat}: ${ayat.teksArab} — ${ayat.teksIndonesia} (${ayat.teksLatin})`}
                  data-ayat={ayat.nomorAyat}
                  class="share-btn rounded-xl bg-slate-50 p-2.5 text-slate-500 transition-colors hover:bg-emerald-50 hover:text-emerald-600 active:scale-90 dark:bg-slate-800 dark:hover:bg-emerald-900/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <circle cx="18" cy="5" r="3" />
                      <circle cx="6" cy="12" r="3" />
                      <circle cx="18" cy="19" r="3" />
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                    </>
                  </svg>
                </button>
                <button
                  type="button"
                  aria-label={`Putar audio ayat ${ayat.nomorAyat}`}
                  data-audio={ayat.audio['05']}
                  class="btn-audio rounded-xl bg-emerald-50 p-2.5 text-emerald-600 transition-colors hover:bg-emerald-100 active:scale-90 dark:bg-emerald-900/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    stroke="currentColor"
                    stroke-width="1"
                    class="icon-play pointer-events-none"
                  >
                    <polygon points="5 3 19 12 5 21 5 3" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    stroke="currentColor"
                    class="icon-pause pointer-events-none hidden"
                  >
                    <>
                      <rect x="6" y="4" width="4" height="16" />
                      <rect x="14" y="4" width="4" height="16" />
                    </>
                  </svg>
                </button>
              </div>
            </div>

            <div class="mb-6 text-right">
              <p
                class="text-arab font-amiri text-[2rem] leading-[2.4] text-slate-800 transition-all duration-300 dark:text-slate-100"
                dir="rtl"
              >
                {ayat.teksArab}
              </p>
            </div>

            <div class="space-y-2 border-t border-slate-50 pt-4 dark:border-slate-800/50">
              <p class="text-latin text-[0.95rem] leading-relaxed font-medium text-emerald-700 italic dark:text-emerald-400">
                {ayat.teksLatin}
              </p>
              <p class="text-arti text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                {ayat.teksIndonesia}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div
      id="view-mushaf"
      role="tabpanel"
      aria-labelledby="btn-mushaf"
      class="hidden rounded-2xl border border-slate-100 bg-white p-6 leading-[3] shadow-sm dark:border-slate-800 dark:bg-slate-900"
    >
      <p
        class="text-arab-mushaf font-amiri text-justify text-[2.2rem] text-slate-800 transition-all duration-300 dark:text-slate-100"
        dir="rtl"
      >
        {
          suratData.ayat.map((ayat) => (
            <span>
              {ayat.teksArab}
              <span class="mx-1 inline-flex items-center justify-center text-[0.8em] text-emerald-600 select-none">
                ﴿{toArabic(ayat.nomorAyat)}﴾
              </span>
            </span>
          ))
        }
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const initQuranDetail = () => {
      if (window._quranDetailInitialized) return;

      const btnTerjemah = document.getElementById('btn-terjemah');
      const btnMushaf = document.getElementById('btn-mushaf');
      const viewTerjemah = document.getElementById('view-terjemah');
      const viewMushaf = document.getElementById('view-mushaf');

      if (!btnTerjemah || !btnMushaf || !viewTerjemah || !viewMushaf) return;
      window._quranDetailInitialized = true;

      btnTerjemah.addEventListener('click', () => {
        btnTerjemah.className =
          'px-3 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-700 text-emerald-600 shadow-sm transition-all';
        btnTerjemah.setAttribute('aria-selected', 'true');
        btnMushaf.className =
          'px-3 py-1 rounded-full text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all';
        btnMushaf.setAttribute('aria-selected', 'false');
        viewTerjemah.classList.remove('hidden');
        viewMushaf.classList.add('hidden');
      });

      btnMushaf.addEventListener('click', () => {
        btnMushaf.className =
          'px-3 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-700 text-emerald-600 shadow-sm transition-all';
        btnMushaf.setAttribute('aria-selected', 'true');
        btnTerjemah.className =
          'px-3 py-1 rounded-full text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all';
        btnTerjemah.setAttribute('aria-selected', 'false');
        viewMushaf.classList.remove('hidden');
        viewTerjemah.classList.add('hidden');
      });

      const audioBtnsArr = Array.from(document.querySelectorAll('.btn-audio'));
      let currentAudio = null;
      let currentBtn = null;

      audioBtnsArr.forEach((btn, index) => {
        btn.addEventListener('click', function () {
          const url = this.getAttribute('data-audio');
          const iconPlay = this.querySelector('.icon-play');
          const iconPause = this.querySelector('.icon-pause');

          if (currentBtn === this && currentAudio) {
            if (!currentAudio.paused) {
              currentAudio.pause();
              iconPlay.classList.remove('hidden');
              iconPause.classList.add('hidden');
            } else {
              currentAudio.play();
              iconPlay.classList.add('hidden');
              iconPause.classList.remove('hidden');
            }
            return;
          }

          if (currentAudio) {
            currentAudio.pause();
            document.querySelectorAll('.icon-pause').forEach((el) => el.classList.add('hidden'));
            document.querySelectorAll('.icon-play').forEach((el) => el.classList.remove('hidden'));
            document
              .querySelectorAll('.ayat-card')
              .forEach((el) => el.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md'));
          }

          currentAudio = new Audio(url);
          window._quranDetailAudio = currentAudio;
          currentBtn = this;
          currentAudio.play();

          iconPlay.classList.add('hidden');
          iconPause.classList.remove('hidden');

          const card = this.closest('.ayat-card');
          card.classList.add('ring-2', 'ring-emerald-500', 'shadow-md');

          currentAudio.onended = () => {
            iconPlay.classList.remove('hidden');
            iconPause.classList.add('hidden');
            card.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md');

            if (index + 1 < audioBtnsArr.length) {
              const nextBtn = audioBtnsArr[index + 1];
              nextBtn.click();
              const nextCard = nextBtn.closest('.ayat-card');
              nextCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
              currentAudio = null;
              window._quranDetailAudio = null;
              currentBtn = null;
            }
          };
        });
      });

      // Share ayat via Web Share API or clipboard
      document.querySelectorAll('.share-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-share') || '';
          const ayat = btn.getAttribute('data-ayat') || '';
          const url = window.location.href.split('#')[0] + '#ayat-' + ayat;
          const shareText = text + '\n\n' + url;
          try {
            if (navigator.share) {
              await navigator.share({ title: document.title, text: shareText, url });
            } else if (navigator.clipboard) {
              await navigator.clipboard.writeText(shareText);
              window.showToast && window.showToast('Ayat disalin! Siap dibagikan 📋');
            } else {
              window.showToast && window.showToast('Browser tidak mendukung berbagi');
            }
          } catch (e) {
            if (e.name !== 'AbortError' && navigator.clipboard) {
              await navigator.clipboard.writeText(shareText);
              window.showToast && window.showToast('Ayat disalin! 📋');
            }
          }
        });
      });

      const fontSizeRange = document.getElementById('font-size-range');
      const toggleLatin = document.getElementById('toggle-latin');
      const toggleArti = document.getElementById('toggle-arti');

      const applySettings = () => {
        const size = parseInt(fontSizeRange.value);
        const showLatin = toggleLatin.checked;
        const showArti = toggleArti.checked;

        const arabSizes = ['1.4rem', '1.7rem', '2rem', '2.5rem', '3rem'];
        const mushafSizes = ['1.6rem', '1.9rem', '2.2rem', '2.8rem', '3.5rem'];

        document.querySelectorAll('.text-arab').forEach((el) => {
          el.style.fontSize = arabSizes[size - 1];
        });

        document.querySelectorAll('.text-arab-mushaf').forEach((el) => {
          el.style.fontSize = mushafSizes[size - 1];
        });

        document.querySelectorAll('.text-latin').forEach((el) => {
          el.style.display = showLatin ? 'block' : 'none';
        });
        document.querySelectorAll('.text-arti').forEach((el) => {
          el.style.display = showArti ? 'block' : 'none';
        });

        localStorage.setItem('quran-settings', JSON.stringify({ size, showLatin, showArti }));
      };

      fontSizeRange.addEventListener('input', applySettings);
      toggleLatin.addEventListener('change', applySettings);
      toggleArti.addEventListener('change', applySettings);

      const saved = localStorage.getItem('quran-settings');
      if (saved) {
        const { size, showLatin, showArti } = JSON.parse(saved);
        fontSizeRange.value = size;
        toggleLatin.checked = showLatin;
        toggleArti.checked = showArti;
      }
      applySettings();

      // Settings modal handling
      const settingsBtn = document.getElementById('settings-btn');
      const settingsModal = document.getElementById('settings-modal');
      const closeSettings = document.getElementById('close-settings');
      const overlay = document.getElementById('overlay');

      const showModal = () => settingsModal?.classList.remove('hidden');
      const hideModal = () => settingsModal?.classList.add('hidden');

      settingsBtn?.addEventListener('click', showModal);
      closeSettings?.addEventListener('click', hideModal);
      overlay?.addEventListener('click', hideModal);

      if (window.location.hash) {
        setTimeout(() => {
          const el = document.querySelector(window.location.hash);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }, 500);
      }
    };

    document.addEventListener('astro:page-load', initQuranDetail);
    document.addEventListener('astro:before-swap', () => {
      window._quranDetailInitialized = false;
      if (window._quranDetailAudio) {
        window._quranDetailAudio.pause();
        window._quranDetailAudio = null;
      }
    });
  })();
</script>
