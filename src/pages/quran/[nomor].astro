---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderBack from '../../components/HeaderBack.astro';

export async function getStaticPaths() {
  const res = await fetch('https://equran.id/api/v2/surat');
  const json = await res.json();
  const suratList = json.data;

  return suratList.map((surat) => ({
    params: { nomor: surat.nomor.toString() },
  }));
}

const { nomor } = Astro.params;

const resDetail = await fetch(`https://equran.id/api/v2/surat/${nomor}`);
const jsonDetail = await resDetail.json();
const suratData = jsonDetail.data;

const toArabic = (num) => {
  const arabicMap = {'0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩'};
  return num.toString().split('').map(c => arabicMap[c] || c).join('');
};
---

<BaseLayout pageTitle={`Surat ${suratData.namaLatin}`}>

  <div class="sticky top-16 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 -mx-4 px-4 py-3 mb-4 flex items-center justify-between shadow-sm">
    <a href="/quran" class="flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 transition-colors p-2 -ml-2 rounded-lg active:bg-slate-100 dark:active:bg-slate-800">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span class="font-medium text-sm">Daftar Surat</span>
    </a>
    
    <div class="flex items-center gap-2">
      <div class="flex bg-slate-100 dark:bg-slate-800 rounded-full p-1 border border-slate-200 dark:border-slate-700">
        <button id="btn-terjemah" class="px-3 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-700 text-emerald-600 shadow-sm transition-all">Per Ayat</button>
        <button id="btn-mushaf" class="px-3 py-1 rounded-full text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all">Mushaf</button>
      </div>
      <button id="settings-btn" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-600 dark:text-slate-300 transition-colors hover:bg-emerald-100 dark:hover:bg-emerald-900/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
    </div>
  </div>

  <div class="pb-24 px-4 w-full max-w-md mx-auto">
    
    <div class="text-center mb-8 mt-2 bg-gradient-to-br from-emerald-500 to-teal-700 rounded-3xl p-6 text-white shadow-lg shadow-emerald-500/20 relative overflow-hidden">
      <div class="absolute top-0 right-0 opacity-10 transform translate-x-4 -translate-y-4">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
      </div>
      <h1 class="font-amiri text-5xl mb-2 relative z-10">{suratData.nama}</h1>
      <h2 class="text-xl font-bold relative z-10">Surat {suratData.namaLatin}</h2>
      <p class="text-sm text-emerald-100 mt-1 relative z-10">{suratData.arti} • {suratData.jumlahAyat} Ayat</p>
    </div>

    <div id="view-terjemah" class="space-y-6">
      {suratData.ayat.map((ayat) => (
        <div id={`ayat-${ayat.nomorAyat}`} class="ayat-card bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-all hover:shadow-md scroll-mt-24">
          <div class="flex justify-between items-center mb-4 border-b border-slate-50 dark:border-slate-800/50 pb-3">
            <div class="w-8 h-8 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center text-sm font-bold text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              {ayat.nomorAyat}
            </div>
            <button 
              type="button"
              data-audio={ayat.audio['05']} 
              class="btn-audio p-2.5 rounded-xl text-emerald-600 bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 transition-colors active:scale-90"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" class="icon-play pointer-events-none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" class="icon-pause hidden pointer-events-none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            </button>
          </div>

          <div class="text-right mb-6">
            <p class="text-arab font-amiri text-[2rem] leading-[2.4] text-slate-800 dark:text-slate-100 transition-all duration-300" dir="rtl">
              {ayat.teksArab}
            </p>
          </div>

          <div class="space-y-2 border-t border-slate-50 dark:border-slate-800/50 pt-4">
            <p class="text-latin text-emerald-700 dark:text-emerald-400 font-medium italic text-[0.95rem] leading-relaxed">
              {ayat.teksLatin}
            </p>
            <p class="text-arti text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              {ayat.teksIndonesia}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div id="view-mushaf" class="hidden bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm leading-[3]">
      <p class="text-arab-mushaf font-amiri text-[2.2rem] text-justify text-slate-800 dark:text-slate-100 transition-all duration-300" dir="rtl">
        {suratData.ayat.map((ayat) => (
          <span>
            {ayat.teksArab} 
            <span class="inline-flex items-center justify-center text-emerald-600 mx-1 text-[0.8em] select-none">﴿{toArabic(ayat.nomorAyat)}﴾</span>
          </span>
        ))}
      </p>
    </div>

  </div>

  <div id="settings-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" id="overlay"></div>
    <div class="absolute bottom-0 left-0 w-full max-w-md mx-auto bg-white dark:bg-slate-900 rounded-t-3xl p-6 shadow-2xl animate-slide-up" style="left: 50%; transform: translateX(-50%);">
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-bold text-lg text-slate-800 dark:text-white">Tampilan Bacaan</h3>
        <button id="close-settings" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-600 dark:text-slate-400 mb-3">Ukuran Font Arab</label>
          <input type="range" id="font-size-range" min="1" max="5" step="1" value="3" class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500">
          <div class="flex justify-between text-xs text-slate-400 mt-2 font-medium">
            <span>Kecil</span><span>Normal</span><span>Besar</span>
          </div>
        </div>
        <hr class="border-slate-100 dark:border-slate-800" />
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-200 font-medium text-sm">Tampilkan Teks Latin</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-latin" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-200 font-medium text-sm">Tampilkan Terjemahan</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-arti" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<script is:inline>
  const initQuranDetail = () => {
    if (window._quranDetailInitialized) return;
    window._quranDetailInitialized = true;
    
    const btnTerjemah = document.getElementById('btn-terjemah');
    const btnMushaf = document.getElementById('btn-mushaf');
    const viewTerjemah = document.getElementById('view-terjemah');
    const viewMushaf = document.getElementById('view-mushaf');

    btnTerjemah.addEventListener('click', () => {
      btnTerjemah.className = "px-3 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-700 text-emerald-600 shadow-sm transition-all";
      btnMushaf.className = "px-3 py-1 rounded-full text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all";
      viewTerjemah.classList.remove('hidden');
      viewMushaf.classList.add('hidden');
    });

    btnMushaf.addEventListener('click', () => {
      btnMushaf.className = "px-3 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-700 text-emerald-600 shadow-sm transition-all";
      btnTerjemah.className = "px-3 py-1 rounded-full text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all";
      viewMushaf.classList.remove('hidden');
      viewTerjemah.classList.add('hidden');
    });

    const audioBtnsArr = Array.from(document.querySelectorAll('.btn-audio'));
    let currentAudio = null;
    let currentBtn = null;

    audioBtnsArr.forEach((btn, index) => {
      btn.addEventListener('click', function() {
        const url = this.getAttribute('data-audio');
        const iconPlay = this.querySelector('.icon-play');
        const iconPause = this.querySelector('.icon-pause');

        if (currentBtn === this && currentAudio) {
          if (!currentAudio.paused) {
            currentAudio.pause();
            iconPlay.classList.remove('hidden');
            iconPause.classList.add('hidden');
          } else {
            currentAudio.play();
            iconPlay.classList.add('hidden');
            iconPause.classList.remove('hidden');
          }
          return;
        }

        if (currentAudio) {
          currentAudio.pause();
          document.querySelectorAll('.icon-pause').forEach(el => el.classList.add('hidden'));
          document.querySelectorAll('.icon-play').forEach(el => el.classList.remove('hidden'));
          document.querySelectorAll('.ayat-card').forEach(el => el.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md'));
        }

        currentAudio = new Audio(url); window._quranDetailAudio = currentAudio;
        currentBtn = this;
        currentAudio.play();
        
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        
        const card = this.closest('.ayat-card');
        card.classList.add('ring-2', 'ring-emerald-500', 'shadow-md');

        currentAudio.onended = () => {
          iconPlay.classList.remove('hidden');
          iconPause.classList.add('hidden');
          card.classList.remove('ring-2', 'ring-emerald-500', 'shadow-md');
          
          if (index + 1 < audioBtnsArr.length) {
            const nextBtn = audioBtnsArr[index + 1];
            nextBtn.click();
            const nextCard = nextBtn.closest('.ayat-card');
            nextCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
             currentAudio = null; window._quranDetailAudio = null;
             currentBtn = null;
          }
        };
      });
    });

    const settingsBtn = document.getElementById('settings-btn');
    const settingsModal = document.getElementById('settings-modal');
    const closeSettings = document.getElementById('close-settings');
    const overlay = document.getElementById('overlay');
    const fontSizeRange = document.getElementById('font-size-range');
    const toggleLatin = document.getElementById('toggle-latin');
    const toggleArti = document.getElementById('toggle-arti');

    const showModal = () => settingsModal?.classList.remove('hidden');
    const hideModal = () => settingsModal?.classList.add('hidden');

    settingsBtn.addEventListener('click', showModal);
    closeSettings.addEventListener('click', hideModal);
    overlay.addEventListener('click', hideModal);

    const applySettings = () => {
      const size = parseInt(fontSizeRange.value);
      const showLatin = toggleLatin.checked;
      const showArti = toggleArti.checked;
      
      const arabSizes = ['1.4rem', '1.7rem', '2rem', '2.5rem', '3rem'];
      const mushafSizes = ['1.6rem', '1.9rem', '2.2rem', '2.8rem', '3.5rem'];
      
      document.querySelectorAll('.text-arab').forEach(el => {
        el.style.fontSize = arabSizes[size - 1];
      });

      document.querySelectorAll('.text-arab-mushaf').forEach(el => {
        el.style.fontSize = mushafSizes[size - 1];
      });

      document.querySelectorAll('.text-latin').forEach(el => {
        el.style.display = showLatin ? 'block' : 'none';
      });
      document.querySelectorAll('.text-arti').forEach(el => {
        el.style.display = showArti ? 'block' : 'none';
      });

      localStorage.setItem('quran-settings', JSON.stringify({ size, showLatin, showArti }));
    };

    fontSizeRange.addEventListener('input', applySettings);
    toggleLatin.addEventListener('change', applySettings);
    toggleArti.addEventListener('change', applySettings);

    const saved = localStorage.getItem('quran-settings');
    if (saved) {
      const { size, showLatin, showArti } = JSON.parse(saved);
      fontSizeRange.value = size;
      toggleLatin.checked = showLatin;
      toggleArti.checked = showArti;
    }
    applySettings();

    if (window.location.hash) {
      setTimeout(() => {
        const el = document.querySelector(window.location.hash);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 500);
    }
  };

  document.addEventListener('DOMContentLoaded', initQuranDetail);
  document.addEventListener('astro:after-swap', initQuranDetail);
  document.addEventListener('astro:before-swap', () => {
    window._quranDetailInitialized = false;
    if (window._quranDetailAudio) { window._quranDetailAudio.pause(); window._quranDetailAudio = null; }
  });
</script>
