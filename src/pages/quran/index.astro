---
import BaseLayout from '../../layouts/BaseLayout.astro';

const res = await fetch('https://equran.id/api/v2/surat');
const json = await res.json();
const daftarSurat = json.data;
---

<BaseLayout pageTitle="Al-Qur'an">

  <div class="sticky top-16 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 -mx-4 px-4 py-3 mb-6 flex items-center justify-between shadow-sm">
    <a href="/" class="flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 transition-colors p-2 -ml-2 rounded-lg active:bg-slate-100 dark:active:bg-slate-800">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span class="font-medium text-sm">Kembali</span>
    </a>
    <h1 class="font-bold text-slate-800 dark:text-white text-sm">Al-Qur'an</h1>
    <div class="w-8"></div>
  </div>

  <div class="pb-24 px-4 w-full max-w-md mx-auto">
    
    <div class="relative mb-6">
      <input 
        type="text" 
        id="search-surat" 
        placeholder="Cari surat (misal: Yasin, Kahfi)..." 
        class="w-full py-3.5 pl-12 pr-4 text-sm rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-800 dark:text-white placeholder-slate-400 shadow-sm"
      >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-3.5 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </div>

    <div id="surat-list" class="grid gap-3">
      {daftarSurat.map((surat) => (
        <a href={`/quran/${surat.nomor}`} class="surat-card group flex items-center justify-between p-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-sm font-bold text-emerald-600 dark:text-emerald-400 border border-slate-100 dark:border-slate-700 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
              {surat.nomor}
            </div>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-white text-base surat-nama">{surat.namaLatin}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{surat.tempatTurun} • {surat.jumlahAyat} Ayat</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-amiri text-xl text-slate-800 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" dir="rtl">{surat.nama}</p>
          </div>
        </a>
      ))}
    </div>

    <div id="empty-state" class="hidden text-center py-12">
      <p class="text-slate-500 dark:text-slate-400 text-sm">Surat tidak ditemukan.</p>
    </div>

  </div>

</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-surat');
    const suratCards = document.querySelectorAll('.surat-card');
    const emptyState = document.getElementById('empty-state');

    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      let hasVisible = false;

      suratCards.forEach(card => {
        const nama = card.querySelector('.surat-nama').textContent.toLowerCase();
        if (nama.includes(term)) {
          card.style.display = 'flex';
          hasVisible = true;
        } else {
          card.style.display = 'none';
        }
      });

      if (hasVisible) {
        emptyState.classList.add('hidden');
      } else {
        emptyState.classList.remove('hidden');
      }
    });
  });
</script>