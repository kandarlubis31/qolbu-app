---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderBack from '../../components/HeaderBack.astro';

let daftarSurat = [];
try {
  const res = await fetch('https://equran.id/api/v2/surat', { signal: AbortSignal.timeout(8000) });
  if (res.ok) {
    const json = await res.json();
    daftarSurat = json.data || [];
  }
} catch (e) {
  console.error('Gagal fetch daftar surat:', e);
}

if (daftarSurat.length === 0) {
  daftarSurat = []; // graceful fallback — list will be empty
}

const daftarJuz = [
  { juz: 1, start: "Al-Fatihah", ayat: 1, id: 1 },
  { juz: 2, start: "Al-Baqarah", ayat: 142, id: 2 },
  { juz: 3, start: "Al-Baqarah", ayat: 253, id: 2 },
  { juz: 4, start: "Ali 'Imran", ayat: 93, id: 3 },
  { juz: 5, start: "An-Nisa'", ayat: 24, id: 4 },
  { juz: 6, start: "An-Nisa'", ayat: 148, id: 4 },
  { juz: 7, start: "Al-Ma'idah", ayat: 82, id: 5 },
  { juz: 8, start: "Al-An'am", ayat: 111, id: 6 },
  { juz: 9, start: "Al-A'raf", ayat: 88, id: 7 },
  { juz: 10, start: "Al-Anfal", ayat: 41, id: 8 },
  { juz: 11, start: "At-Taubah", ayat: 93, id: 9 },
  { juz: 12, start: "Hud", ayat: 6, id: 11 },
  { juz: 13, start: "Yusuf", ayat: 53, id: 12 },
  { juz: 14, start: "Al-Hijr", ayat: 1, id: 15 },
  { juz: 15, start: "Al-Isra'", ayat: 1, id: 17 },
  { juz: 16, start: "Al-Kahfi", ayat: 75, id: 18 },
  { juz: 17, start: "Al-Anbiya'", ayat: 1, id: 21 },
  { juz: 18, start: "Al-Mu'minun", ayat: 1, id: 23 },
  { juz: 19, start: "Al-Furqan", ayat: 21, id: 25 },
  { juz: 20, start: "An-Naml", ayat: 56, id: 27 },
  { juz: 21, start: "Al-'Ankabut", ayat: 46, id: 29 },
  { juz: 22, start: "Al-Ahzab", ayat: 31, id: 33 },
  { juz: 23, start: "Yasin", ayat: 28, id: 36 },
  { juz: 24, start: "Az-Zumar", ayat: 32, id: 39 },
  { juz: 25, start: "Fussilat", ayat: 47, id: 41 },
  { juz: 26, start: "Al-Ahqaf", ayat: 1, id: 46 },
  { juz: 27, start: "Az-Zariyat", ayat: 31, id: 51 },
  { juz: 28, start: "Al-Mujadilah", ayat: 1, id: 58 },
  { juz: 29, start: "Al-Mulk", ayat: 1, id: 67 },
  { juz: 30, start: "An-Naba'", ayat: 1, id: 78 }
];
---

<BaseLayout pageTitle="Al-Qur'an">

  <HeaderBack href="/" label="Kembali" title="Al-Qur'an" />

  <div class="pb-24 px-4 w-full max-w-md mx-auto">

    <!-- LANJUT BACA BANNER -->
    <div id="lanjut-baca-banner" class="hidden mb-4">
      <a id="lanjut-baca-link" href="#" class="flex items-center justify-between p-4 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-2xl shadow-md shadow-emerald-500/20 hover:shadow-lg hover:-translate-y-0.5 transition-all">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div>
            <p class="text-[10px] text-emerald-100 uppercase tracking-wider font-bold">Lanjut Baca</p>
            <p id="lanjut-baca-text" class="font-bold text-sm">Al-Fatihah • Ayat 1</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-emerald-100">Buka</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/70"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </a>
    </div>
    
    <div class="flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl mb-6">
      <button id="tab-surat" class="flex-1 py-2 text-sm font-bold rounded-lg bg-white dark:bg-slate-700 shadow-sm text-emerald-600 transition-all">Daftar Surat</button>
      <button id="tab-juz" class="flex-1 py-2 text-sm font-bold rounded-lg text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all">Daftar Juz</button>
    </div>

    <!-- OFFLINE CACHE STATUS -->
    <div id="cache-section" class="mb-4 p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-800">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-500"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M9 9h12"/><path d="M9 15h12"/></svg>
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Offline Quran</span>
        </div>
        <span id="cache-count" class="text-xs text-slate-400">0/114</span>
      </div>
      <div class="mt-3 space-y-2">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="cache-audio-check" class="w-4 h-4 rounded accent-emerald-500 cursor-pointer" checked>
          <span class="text-xs text-slate-500 dark:text-slate-400">Sertakan Audio <span class="text-[10px] opacity-60">(≈500MB-2GB, disarankan WiFi)</span></span>
        </label>
        <button id="cache-all-btn" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-sm transition-all active:scale-[0.98] shadow-sm flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Cache Semua Surah
        </button>
        <div id="cache-progress-container" class="hidden mt-2">
          <div class="flex justify-between text-xs text-slate-400 mb-1">
            <span id="cache-progress-text">Mendownload...</span>
            <span id="cache-progress-pct">0%</span>
          </div>
          <div class="h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
            <div id="cache-progress-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- BOOKMARKS -->
    <div id="bookmarks-section" class="hidden mb-4">
      <div class="flex items-center justify-between mb-2 px-1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-rose-500"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          Bookmark Surah
        </h3>
        <span id="bookmark-count" class="text-[10px] text-slate-400"></span>
      </div>
      <div id="bookmarks-list" class="grid gap-2"></div>
    </div>

    <div class="mb-4">
      <a href="/quran/yasin" class="flex items-center justify-between p-4 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-2xl hover:shadow-lg hover:-translate-y-0.5 transition-all shadow-md shadow-emerald-500/20">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-lg font-bold backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div>
            <p class="font-bold text-sm">Surat Yasin</p>
            <p class="text-xs text-emerald-100 opacity-80">Bacaan Yasin & Tahlil Lengkap</p>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/70"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>

    <div id="view-surat">
      <div class="relative mb-6">
        <input 
          type="text" 
          id="search-surat" 
          placeholder="Cari surat..." 
          class="w-full py-3.5 pl-12 pr-4 text-sm rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-800 dark:text-white placeholder-slate-400 shadow-sm"
        >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-3.5 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>

      <div id="surat-list" class="grid gap-3">
        {daftarSurat.map((surat) => (
          <a href={`/quran/${surat.nomor}`} class="surat-card group flex items-center justify-between p-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center gap-4">
              <div class="surat-nomor w-10 h-10 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-sm font-bold text-emerald-600 dark:text-emerald-400 border border-slate-100 dark:border-slate-700 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                {surat.nomor}
              </div>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-white text-base surat-nama">{surat.namaLatin}</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{surat.tempatTurun} • {surat.jumlahAyat} Ayat</p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-amiri text-xl text-slate-800 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" dir="rtl">{surat.nama}</p>
            </div>
          </a>
        ))}
      </div>
      
      <div id="empty-state" class="hidden text-center py-12">
        <p class="text-slate-500 dark:text-slate-400 text-sm">Surat tidak ditemukan.</p>
      </div>
    </div>

    <div id="view-juz" class="hidden grid gap-3">
      {daftarJuz.map((juz) => (
        <a href={`/quran/${juz.id}#ayat-${juz.ayat}`} class="group flex items-center justify-between p-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center text-sm font-bold text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
              {juz.juz}
            </div>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-white text-sm">Juz {juz.juz}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Mulai: {juz.start} ayat {juz.ayat}</p>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 group-hover:text-emerald-500 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<script is:inline>    // ===== INDEXEDDB QURAN CACHE HELPER =====
    const DB_NAME = 'qolbu-quran-cache';
    const DB_VERSION = 1;
    const STORE_NAME = 'surah-cache';

    function openDB() {
      return new Promise((resolve, reject) => {
        if (!window.indexedDB) { reject('IndexedDB not supported'); return; }
        const req = indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_NAME)) {
            db.createObjectStore(STORE_NAME, { keyPath: 'nomor' });
          }
        };
        req.onsuccess = (e) => resolve(e.target.result);
        req.onerror = (e) => reject(e.target.error);
      });
    }

    async function getCachedCount() {
      try {
        const db = await openDB();
        return new Promise((resolve) => {
          const tx = db.transaction(STORE_NAME, 'readonly');
          const req = tx.objectStore(STORE_NAME).count();
          req.onsuccess = () => { db.close(); resolve(req.result); };
          req.onerror = () => { db.close(); resolve(0); };
        });
      } catch { return 0; }
    }

    async function cacheSurah(nomor) {
      try {
        const res = await fetch(`https://equran.id/api/v2/surat/${nomor}`, { signal: AbortSignal.timeout(10000) });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = await res.json();
        const db = await openDB();
        return new Promise((resolve, reject) => {
          const tx = db.transaction(STORE_NAME, 'readwrite');
          tx.objectStore(STORE_NAME).put({ nomor: nomor.toString(), data: json.data, cachedAt: Date.now() });
          tx.oncomplete = () => { db.close(); resolve(true); };
          tx.onerror = () => { db.close(); reject(); };
        });
      } catch { return false; }
    }

    // ===== AUDIO CACHING =====
    // Fetch audio file to warm browser cache + SW cache
    const cacheAudioFile = async (url) => {
      try {
        await fetch(url, { mode: 'no-cors', cache: 'force-cache' });
        return true;
      } catch { return false; }
    };

    // Get all cached surah data, extract audio URLs
    const getAllAudioUrls = async () => {
      const urls = [];
      try {
        const db = await openDB();
        const tx = db.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).getAll();
        urls.push(...await new Promise((resolve) => {
          req.onsuccess = () => {
            const entries = req.result;
            const result = [];
            for (const entry of entries) {
              if (entry.data && entry.data.ayat) {
                for (const ayat of entry.data.ayat) {
                  // Use audio['05'] (default recitation)
                  const url = ayat.audio && ayat.audio['05'];
                  if (url) result.push(url);
                }
              }
            }
            db.close();
            resolve(result);
          };
          req.onerror = () => { db.close(); resolve([]); };
        }));
      } catch {}
      return urls;
    };

    async function cacheAllSurahs() {
      const total = 114;
      const CONCURRENCY = 5;
      const AUDIO_BATCH = 5;
      const container = document.getElementById('cache-progress-container');
      const bar = document.getElementById('cache-progress-bar');
      const pct = document.getElementById('cache-progress-pct');
      const text = document.getElementById('cache-progress-text');
      const btn = document.getElementById('cache-all-btn');
      const audioCheck = document.getElementById('cache-audio-check');

      // Check already cached & skip
      let alreadyCached = 0;
      try {
        const db = await openDB();
        const tx = db.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).count();
        alreadyCached = await new Promise((resolve) => { req.onsuccess = () => { db.close(); resolve(req.result); }; req.onerror = () => { db.close(); resolve(0); }; });
      } catch { alreadyCached = 0; }

      const cacheAudio = audioCheck ? audioCheck.checked : false;

      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="32"/></svg> Mendownload...';
      container.classList.remove('hidden');

      let completed = alreadyCached;
      const updateProgress = (done, label) => {
        const pctVal = Math.round((done / total) * 100);
        bar.style.width = pctVal + '%';
        pct.innerText = pctVal + '%';
        text.innerText = label || `${done}/${total} surah`;
      };
      updateProgress(completed, `${completed}/${total} surah tersimpan`);

      // ===== PHASE 1: Cache surah data =====
      for (let i = 1; i <= total; i += CONCURRENCY) {
        const batch = [];
        for (let j = i; j < i + CONCURRENCY && j <= total; j++) {
          batch.push(
            (async () => {
              const ok = await cacheSurah(j);
              if (ok) completed++;
              updateProgress(completed, `Surah ${completed}/${total}`);
            })()
          );
        }
        await Promise.allSettled(batch);
      }

      const finalCount = await getCachedCount();
      document.getElementById('cache-count').innerText = `${finalCount}/${total}`;

      // ===== PHASE 2: Cache audio files (if checked) =====
      if (cacheAudio && finalCount > 0) {
        updateProgress(0, 'Fase 2/2 • Mengumpulkan audio...');
        const audioUrls = await getAllAudioUrls();
        const audioTotal = audioUrls.length;

        if (audioTotal > 0) {
          let audioDone = 0;

          const updateAudioProgress = () => {
            const pctVal = Math.round((audioDone / audioTotal) * 100);
            bar.style.width = pctVal + '%';
            pct.innerText = pctVal + '%';
            text.innerText = `Fase 2/2 • Audio ${audioDone}/${audioTotal}`;
          };

          updateAudioProgress();

          for (let i = 0; i < audioTotal; i += AUDIO_BATCH) {
            const batch = [];
            for (let j = i; j < i + AUDIO_BATCH && j < audioTotal; j++) {
              batch.push(
                cacheAudioFile(audioUrls[j]).then(() => {
                  audioDone++;
                  updateAudioProgress();
                })
              );
            }
            await Promise.allSettled(batch);
          }
        }
      }

      // Done!
      const isFullyCached = cacheAudio ? 'audio + surah' : 'surah';
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Selesai! ${finalCount} ${isFullyCached}`;
      btn.disabled = true;
      btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700', 'active:scale-[0.98]', 'cursor-pointer');
      btn.classList.add('bg-emerald-500', 'cursor-default', 'opacity-80');

      renderCachedIndicators();
    }

    async function renderCachedIndicators() {
      try {
        const db = await openDB();
        const tx = db.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).getAll();
        req.onsuccess = () => {
          const cached = new Set(req.result.map(r => r.nomor));
          document.querySelectorAll('.surat-card').forEach(card => {
            const nomorEl = card.querySelector('.surat-nomor');
            const nomor = nomorEl?.textContent?.trim();
            if (nomor && cached.has(nomor)) {
              let badge = card.querySelector('.cached-badge');
              if (!badge) {
                badge = document.createElement('span');
                badge.className = 'cached-badge absolute top-2 right-2 w-5 h-5 bg-emerald-500 rounded-full flex items-center justify-center shadow-sm';
                badge.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
                card.style.position = 'relative';
                card.appendChild(badge);
              }
            }
          });
          db.close();
        };
        req.onerror = () => db.close();
      } catch {}
    }

    const initQuranIndex = () => {
    // ------ LANJUT BACA ------
    const banner = document.getElementById('lanjut-baca-banner');
    const bannerText = document.getElementById('lanjut-baca-text');
    const bannerLink = document.getElementById('lanjut-baca-link');

    try {
      const lastRead = JSON.parse(localStorage.getItem('quran-last-read') || '{}');
      if (lastRead.surah && lastRead.surahName && lastRead.ayat) {
        bannerText.innerText = `${lastRead.surahName} • Ayat ${lastRead.ayat}`;
        bannerLink.href = `/quran/${lastRead.surah}#ayat-${lastRead.ayat}`;
        banner.classList.remove('hidden');
      }
    } catch (e) {}

    const searchInput = document.getElementById('search-surat');
    const suratCards = document.querySelectorAll('.surat-card');
    const emptyState = document.getElementById('empty-state');
    
    const tabSurat = document.getElementById('tab-surat');
    const tabJuz = document.getElementById('tab-juz');
    const viewSurat = document.getElementById('view-surat');
    const viewJuz = document.getElementById('view-juz');

    tabSurat.addEventListener('click', () => {
      tabSurat.className = "flex-1 py-2 text-sm font-bold rounded-lg bg-white dark:bg-slate-700 shadow-sm text-emerald-600 transition-all";
      tabJuz.className = "flex-1 py-2 text-sm font-bold rounded-lg text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all";
      viewSurat.classList.remove('hidden');
      viewJuz.classList.add('hidden');
    });

    tabJuz.addEventListener('click', () => {
      tabJuz.className = "flex-1 py-2 text-sm font-bold rounded-lg bg-white dark:bg-slate-700 shadow-sm text-emerald-600 transition-all";
      tabSurat.className = "flex-1 py-2 text-sm font-bold rounded-lg text-slate-500 dark:text-slate-400 hover:text-emerald-600 transition-all";
      viewJuz.classList.remove('hidden');
      viewSurat.classList.add('hidden');
    });

    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      let hasVisible = false;

      suratCards.forEach(card => {
        const nama = card.querySelector('.surat-nama').textContent.toLowerCase();
        if (nama.includes(term)) {
          card.style.display = 'flex';
          hasVisible = true;
        } else {
          card.style.display = 'none';
        }
      });

      if (hasVisible) {
        emptyState.classList.add('hidden');
      } else {
        emptyState.classList.remove('hidden');
      }
    });

    // ------ BOOKMARKS ------
    const bookmarksSection = document.getElementById('bookmarks-section');
    const bookmarksList = document.getElementById('bookmarks-list');
    const bookmarkCount = document.getElementById('bookmark-count');

    const renderBookmarks = () => {
      try {
        const saved = JSON.parse(localStorage.getItem('quran-bookmarks') || '[]');
        if (saved.length === 0) {
          bookmarksSection.classList.add('hidden');
          return;
        }
        bookmarksSection.classList.remove('hidden');
        bookmarkCount.innerText = `${saved.length} tersimpan`;
        bookmarksList.innerHTML = saved.map(b => `
          <a href="/quran/${b.surah}#ayat-${b.ayat}" class="flex items-center justify-between p-3 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-xl hover:border-rose-300 dark:hover:border-rose-700 shadow-sm hover:shadow-md transition-all group">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-900/20 flex items-center justify-center text-xs font-bold text-rose-500 group-hover:bg-rose-500 group-hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-sm text-slate-800 dark:text-white">${b.surahName}</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Ayat ${b.ayat}</p>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-300 group-hover:text-rose-500 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        `).join('');
      } catch (e) {
        bookmarksSection.classList.add('hidden');
      }
    };

    renderBookmarks();

    // ------ CACHE: count + indicators ------
    const updateCacheCount = async () => {
      const count = await getCachedCount();
      document.getElementById('cache-count').innerText = `${count}/114`;
      if (count > 0) renderCachedIndicators();
    };

    // Cache All button
    document.getElementById('cache-all-btn').addEventListener('click', cacheAllSurahs);

    updateCacheCount();
  };

  document.addEventListener('DOMContentLoaded', initQuranIndex);
  document.addEventListener('astro:after-swap', initQuranIndex);
</script>