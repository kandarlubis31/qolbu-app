---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBack from '../components/HeaderBack.astro';
import Toast from '../components/Toast.astro';
import dzikirData from '../data/dzikir.json';
---

<BaseLayout pageTitle="Dzikir Pagi & Petang">
  <HeaderBack href="/" label="Kembali" title="Dzikir Pagi & Petang" />

  <div class="pb-24 px-4 w-full max-w-md mx-auto">

    <!-- Header -->
    <div class="text-center mb-6 p-5 bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl text-white shadow-lg shadow-amber-500/20">
      <p class="text-lg font-bold mb-1">🤲 Dzikir Pagi & Petang</p>
      <p class="text-xs text-amber-100 leading-relaxed">Bacaan dzikir yang diajarkan Rasulullah ﷺ untuk pagi dan petang hari</p>
    </div>

    <!-- Tab Pagi / Petang / Semua -->
    <div class="flex gap-2 mb-5">
      <button id="tab-pagi" class="tab-btn flex-1 py-2.5 rounded-xl text-sm font-bold transition-all bg-amber-600 text-white shadow-md shadow-amber-500/20" data-time="pagi">
        🌅 Pagi
      </button>
      <button id="tab-petang" class="tab-btn flex-1 py-2.5 rounded-xl text-sm font-bold transition-all bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700" data-time="petang">
        🌙 Petang
      </button>
      <button id="tab-semua" class="tab-btn flex-1 py-2.5 rounded-xl text-sm font-bold transition-all bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700" data-time="keduanya">
        📖 Keduanya
      </button>
    </div>

    <!-- Dzikir Container -->
    <div id="dzikir-container" class="space-y-4 min-h-[50vh]">
      <!-- Rendered by JS -->
    </div>

    <div id="empty-state" class="hidden text-center py-12">
      <div class="inline-block p-4 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Tidak ada dzikir untuk waktu ini.</p>
    </div>

    <Toast msgId="toast-msg" />

  </div>
</BaseLayout>

<script is:inline>
import dzikirData from '../data/dzikir.json';

const initDzikir = () => {
  if (window._dzikirInitialized) return;
  window._dzikirInitialized = true;
  const container = document.getElementById('dzikir-container');
  const empty = document.getElementById('empty-state');
  const tabBtns = document.querySelectorAll('.tab-btn');

  let currentTime = 'pagi';

  const renderDzikir = () => {
    const filtered = dzikirData.filter(item => {
      if (currentTime === 'keduanya') return true;
      return item.waktu === 'keduanya' || item.waktu === currentTime;
    });

    if (filtered.length === 0) {
      container.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');

    const html = filtered.map(item => {
      const waktuLabel = item.waktu === 'pagi' ? '🌅 Pagi' : item.waktu === 'petang' ? '🌙 Petang' : '📖 Pagi & Petang';
      const escapedLatin = item.latin.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      const escapedArti = item.arti.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      return `
        <div class="group bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm hover:shadow-md transition-all hover:border-amber-500/50">
          <div class="flex justify-between items-start mb-3">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              <span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wide">${waktuLabel}</span>
              ${item.jumlah > 1 ? `<span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 font-medium">${item.jumlah}x</span>` : ''}
            </div>
            <button class="copy-btn text-slate-400 hover:text-amber-500 transition-colors p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90" onclick="copyDzikir('${escapedLatin}', '${escapedArti}')">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>

          <div class="bg-amber-50 dark:bg-slate-800/50 p-4 rounded-xl mb-3 border border-amber-100 dark:border-slate-800/50">
            <p class="font-amiri text-2xl text-right text-slate-800 dark:text-slate-100 leading-[2.4]" dir="rtl">${item.arab}</p>
          </div>

          <div class="space-y-1">
            <p class="text-sm font-bold text-amber-700 dark:text-amber-400 italic leading-relaxed">"${item.latin}"</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">${item.arti}</p>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 italic mt-2 uppercase tracking-wide font-medium">Sumber: ${item.sumber}</p>
          </div>
        </div>
      `;
    }).join('');

    container.innerHTML = html;
  };

  // Tab switching
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentTime = btn.dataset.time;
      tabBtns.forEach(b => {
        b.classList.remove('bg-amber-600', 'text-white', 'shadow-md');
        b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border');
      });
      btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border');
      btn.classList.add('bg-amber-600', 'text-white', 'shadow-md');
      renderDzikir();
    });
  });

  // Copy handler
  window.copyDzikir = (latin, arti) => {
    const text = `"${latin}"\n\n${arti}\n\n_Sent via Qolbu App_`;
    navigator.clipboard.writeText(text).then(() => {
      window.showToast?.('Teks berhasil disalin!', 2000);
    }).catch(() => {
      window.showToast?.('Gagal menyalin.', 2000);
    });
  };

  renderDzikir();
};

document.addEventListener('DOMContentLoaded', initDzikir);
document.addEventListener('astro:after-swap', initDzikir);
  document.addEventListener('astro:before-swap', () => { window._dzikirInitialized = false; });
</script>

<style>
  .copy-btn {
    flex-shrink: 0;
  }
</style>
