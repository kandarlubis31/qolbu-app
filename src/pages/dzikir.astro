---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderSticky from '../components/HeaderSticky.astro';
import SearchBar from '../components/SearchBar.astro';
import Toast from '../components/Toast.astro';
import EmptyState from '../components/EmptyState.astro';
import ScrollFade from '../components/ScrollFade.astro';

import dzikirData from '../data/dzikir.json';
---

<BaseLayout pageTitle="Dzikir Al-Ma'tsurat">
  <HeaderSticky title="Dzikir Al-Ma'tsurat" />

  <div class="mx-auto w-full max-w-md px-4 pb-24">
    <div
      class="relative mb-6 overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-5 text-white shadow-lg shadow-emerald-500/20"
    >
      <div class="relative z-10">
        <p class="mb-1 text-xs font-medium tracking-widest text-emerald-100 uppercase">
          Al-Ma'tsurat
        </p>
        <h2 class="mb-1 text-xl font-bold">Dzikir Pagi & Petang</h2>
        <p class="text-xs text-emerald-200">
          Kumpulan dzikir yang disusun oleh Imam Hasan Al-Banna berdasarkan hadits-hadits shahih
        </p>
      </div>
    </div>

    <SearchBar
      id="search-input"
      placeholder="Cari dzikir..."
      ariaLabel="Cari dzikir Al-Ma'tsurat"
    />

    <ScrollFade id="category-container" ariaLabel="Filter kategori dzikir">
      <button
        class="cat-btn active flex-shrink-0 snap-start rounded-full bg-emerald-600 px-4 py-1.5 text-xs font-bold whitespace-nowrap text-white shadow-md shadow-emerald-500/20 transition-all"
        data-cat="all"
        aria-pressed="true">Semua</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="pagi"
        aria-pressed="false">☀️ Pagi</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="petang"
        aria-pressed="false">🌙 Petang</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="subuh"
        aria-pressed="false">🕌 Subuh</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="sesudah"
        aria-pressed="false">🤲 Sholat</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="tidur"
        aria-pressed="false">😴 Tidur</button
      >
      <button
        class="cat-btn flex-shrink-0 snap-start rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold whitespace-nowrap text-slate-600 transition-all hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
        data-cat="umum"
        aria-pressed="false">📿 Umum</button
      >
    </ScrollFade>

    <div id="dzikir-container" class="min-h-[50vh] space-y-4"></div>

    <div id="empty-state" class="hidden">
      <EmptyState
        icon="search"
        title="Dzikir tidak ditemukan"
        desc="Coba kata kunci lain atau ganti kategori"
        actionLabel="Reset filter"
        actionId="empty-reset-dzikir"
      />
      <p class="mt-2 text-center text-xs text-slate-400" aria-live="polite" id="empty-count"></p>
    </div>

    <Toast />
  </div>

  <script
    is:inline
    id="dzikir-data"
    type="application/json"
    set:html={JSON.stringify(dzikirData)}
  />
</BaseLayout>

<script is:inline>
  (() => {
    const raw = document.getElementById('dzikir-data')?.textContent || '[]';
    const dzikirData = JSON.parse(raw);
    const renderDzikir = () => {
      if (window._dzikirInitialized) return;
      const container = document.getElementById('dzikir-container');
      const searchInput = document.getElementById('search-input');
      if (!container || !searchInput) return;
      window._dzikirInitialized = true;
      const emptyState = document.getElementById('empty-state');
      const catBtns = document.querySelectorAll('.cat-btn');

      let currentCat = 'all';
      let searchTerm = '';

      const render = () => {
        const filtered = dzikirData.filter((item) => {
          const matchesCat = currentCat === 'all' || item.cat === currentCat;
          const matchesSearch =
            item.title.toLowerCase().includes(searchTerm) ||
            item.latin.toLowerCase().includes(searchTerm) ||
            item.arti.toLowerCase().includes(searchTerm);
          return matchesCat && matchesSearch;
        });

        if (filtered.length === 0) {
          container.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }
        emptyState.classList.add('hidden');

        const catEmoji = {
          pagi: '☀️',
          petang: '🌙',
          subuh: '🕌',
          sesudah: '🤲',
          tidur: '😴',
          umum: '📿',
        };

        container.innerHTML = filtered
          .map(
            (item, i) => `
        <div class="group bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-[colors,box-shadow] md:hover:shadow-md md:hover:border-emerald-500/50 card-anim" style="animation-delay: ${Math.min(i * 25, 200)}ms">
          <div class="flex justify-between items-start mb-3">
            <h3 class="font-bold text-slate-800 dark:text-white text-sm flex items-center gap-2">
              <span class="text-xs">${catEmoji[item.cat] || '📿'}</span>
              ${item.title}
            </h3>
            <button class="copy-btn text-slate-400 hover:text-emerald-500 transition-colors p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90" data-title="${item.title}" data-arab="${item.arab}" data-latin="${item.latin}" data-arti="${item.arti}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-xl mb-3 border border-slate-100 dark:border-slate-800/50">
            <p class="font-amiri text-2xl text-right text-slate-800 dark:text-slate-100 leading-[2.4]" dir="rtl">${item.arab}</p>
          </div>
          <div class="space-y-1">
            <p class="text-sm font-bold text-emerald-700 dark:text-emerald-400 italic leading-relaxed">"${item.latin}"</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">${item.arti}</p>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-2 uppercase tracking-wide font-medium">${item.source}</p>
          </div>
        </div>
      `
          )
          .join('');
      };

      // Event delegation untuk copy button (ganti inline onclick)
      container.addEventListener('click', (e) => {
        const btn = e.target.closest('.copy-btn');
        if (!btn) return;
        const { title, arab, latin, arti } = btn.dataset;
        const text = `*${title}*\n\n${arab}\n\n${latin}\n\n"${arti}"\n\n_Sent via Qolbu App_`;
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(text)
            .then(() => window.showToast('Dzikir berhasil disalin!'))
            .catch(() => window.showToast('Gagal menyalin dzikir'));
        } else {
          window.showToast('Browser tidak mendukung salin otomatis');
        }
      });

      searchInput.addEventListener('input', (e) => {
        searchTerm = e.target.value.toLowerCase();
        render();
      });

      catBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCat = btn.dataset.cat;
          catBtns.forEach((b) => {
            b.classList.remove('bg-emerald-600', 'text-white', 'shadow-md');
            b.classList.add(
              'bg-white',
              'dark:bg-slate-800',
              'text-slate-600',
              'dark:text-slate-300',
              'border'
            );
          });
          btn.classList.remove(
            'bg-white',
            'dark:bg-slate-800',
            'text-slate-600',
            'dark:text-slate-300',
            'border'
          );
          btn.classList.add('bg-emerald-600', 'text-white', 'shadow-md');
          render();
        });
      });

      render();
    };

    document.addEventListener('astro:page-load', renderDzikir);
    document.addEventListener('astro:before-swap', () => {
      window._dzikirInitialized = false;
    });
  })();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .card-anim {
    animation: cardIn 0.4s ease-out both;
  }
</style>
