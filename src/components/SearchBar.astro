---
// src/components/SearchBar.astro
// Reusable search bar component
interface Props {
  id?: string;
  placeholder?: string;
  ariaLabel?: string;
}

const { id = 'search-input', placeholder = 'Cari...', ariaLabel } = Astro.props;
const label = ariaLabel || placeholder;
---

<div class="relative mb-4">
  <label for={id} class="sr-only">{label}</label>
  <input
    type="search"
    id={id}
    placeholder={placeholder}
    aria-label={label}
    autocomplete="off"
    class="w-full rounded-xl border border-slate-200 bg-white py-3 pr-4 pl-10 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-transparent focus:ring-2 focus:ring-emerald-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white"
  />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="pointer-events-none absolute top-3.5 left-3 text-slate-400"
    aria-hidden="true"
    ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg
  >
</div>
