---
// src/components/Toast.astro
// Reusable toast notification — import and use <Toast /> in any page
// Then call showToast("message") from your inline scripts
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class="fixed bottom-6 left-1/2 z-50 flex max-w-[90vw] -translate-x-1/2 translate-y-10 transform cursor-pointer items-center gap-2 rounded-xl bg-slate-800 px-4 py-2.5 text-xs font-bold text-white opacity-0 shadow-2xl transition-all duration-300 md:bg-slate-800/95 md:backdrop-blur-md"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="shrink-0 text-emerald-400"><polyline points="20 6 9 17 4 12"></polyline></svg
  >
  <span id="toast-msg" class="truncate">Teks berhasil disalin!</span>
</div>

<script is:inline>
  (() => {
    const toastEl = document.getElementById('toast');
    const toastMsgEl = document.getElementById('toast-msg');
    let toastTimer = null;
    window.showToast = function (msg, duration = 2500) {
      if (!toastEl || !toastMsgEl) return;
      toastMsgEl.innerText = msg;
      toastEl.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
      toastEl.classList.add('pointer-events-auto');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(function () {
        toastEl.classList.add('opacity-0', 'translate-y-10');
        toastEl.classList.remove('pointer-events-auto');
        toastEl.classList.add('pointer-events-none');
      }, duration);
    };
    if (toastEl)
      toastEl.addEventListener('click', () => {
        if (toastTimer) clearTimeout(toastTimer);
        toastEl.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
        toastEl.classList.remove('pointer-events-auto');
      });
  })();
</script>
