---
interface Props {
  href?: string;
  label?: string;
  title?: string;
  rightSlot?: boolean;
}

const { href = "/", label = "Kembali", title, rightSlot = false } = Astro.props;
---

<div class="sticky top-16 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 -mx-4 px-4 py-3 flex items-center justify-between shadow-sm">
  <a
    href={href}
    class="flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 transition-colors p-2 -ml-2 rounded-lg active:bg-slate-100 dark:active:bg-slate-800"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    <span class="font-medium text-sm">{label}</span>
  </a>

  {title && <h1 class="font-bold text-slate-800 dark:text-white text-sm">{title}</h1>}
  {!title && <div class="w-8" />}

  {rightSlot && <slot name="right" />}
  {!rightSlot && <div class="w-8" />}
</div>
